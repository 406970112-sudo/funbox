<view class="settings-page">
  <view class="settings-header">
    <text class="fb-brand">FunBox</text>
    <text class="settings-title">让牌友<text class="title-accent">认出你。</text></text>
    <text class="settings-desc">换个头像，起个喜欢的名字。</text>
  </view>
  <view class="avatar-card fb-card">
    <view class="avatar-copy"><text class="section-title">我的头像</text><text class="section-desc">每一局，都有熟悉的你</text></view>
    <button class="avatar-button" bindtap="chooseAvatar" disabled="{{uploading || saving || userLoading}}" aria-label="更换头像">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" binderror="handleAvatarError" />
      <view wx:else class="avatar-image avatar-fallback">{{initial}}</view>
      <text class="avatar-edit">{{uploading ? '上传中' : '更换'}}</text>
    </button>
  </view>
  <text class="avatar-hint">支持 JPG、PNG，最大 3 MB，选择后自动保存</text>
  <view class="name-card fb-card">
    <view class="name-heading"><label class="section-title" for="display-name">昵称</label><text class="name-limit">1～32 个字符</text></view>
    <input id="display-name" class="name-input" value="{{displayName}}" maxlength="-1" placeholder="给自己起个好记的名字" placeholder-class="name-placeholder" bindinput="handleNameInput" bindconfirm="saveName" confirm-type="done" disabled="{{saving || userLoading}}" />
    <text class="section-desc">牌友会通过这个名字认识你</text>
  </view>
  <view wx:if="{{errorMessage}}" class="inline-error"><text>{{errorMessage}}</text><text wx:if="{{loadFailed}}" class="retry-link" bindtap="loadProfile">重试</text></view>
  <button class="save-button" bindtap="saveName" loading="{{saving || userLoading}}" disabled="{{saving || uploading || userLoading}}">{{userLoading ? '正在读取资料' : (saving ? '正在保存' : '保存昵称')}}</button>
  <view class="wechat-binding-card fb-card">
    <view><text class="section-title">微信登录</text><text class="section-desc">{{wechatBound ? '已绑定，可用微信一键登录当前账号' : '绑定后可用微信登录，保留原有账号和牌局记录'}}</text></view>
    <button class="wechat-bind-button" bindtap="bindWeChatAccount" loading="{{bindingWeChat}}" disabled="{{wechatBound || bindingWeChat || userLoading || saving || uploading}}">{{wechatBound ? '已绑定微信' : '绑定微信'}}</button>
  </view>
  <button class="logout-button" bindtap="logout" disabled="{{saving || uploading || bindingWeChat || userLoading}}">退出登录</button>
  <view class="settings-footer"><text>开心玩，清楚记。</text></view>
</view>
