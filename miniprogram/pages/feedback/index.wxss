.feedback-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 46rpx 30rpx 90rpx;
  background:
    radial-gradient(circle at 92% 3%, rgba(39, 117, 84, 0.17), transparent 34%),
    linear-gradient(180deg, #f5f1e7 0%, #f7f5ef 58%, #f1efe7 100%);
}

.hero-kicker,
.hero-title,
.hero-copy,
.field-label,
.field-count,
.field-note,
.image-picker-title,
.image-picker-note,
.success-title,
.success-copy {
  display: block;
}

.feedback-hero {
  padding: 12rpx 8rpx 34rpx;
}

.hero-kicker {
  color: #2f755b;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 18rpx;
  color: #14251d;
  font-size: 48rpx;
  font-weight: 900;
}

.hero-copy {
  margin-top: 15rpx;
  color: #6e786f;
  font-size: 24rpx;
  line-height: 1.65;
}

.form-card,
.success-card {
  box-sizing: border-box;
  padding: 30rpx;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  border-radius: 30rpx;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 24rpx 60rpx rgba(40, 55, 45, 0.08);
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field-label {
  color: #34483d;
  font-size: 27rpx;
  font-weight: 900;
}

.field-count,
.field-note {
  color: #8a938c;
  font-size: 21rpx;
}

.description-input {
  box-sizing: border-box;
  width: 100%;
  height: 280rpx;
  margin-top: 15rpx;
  padding: 22rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 20rpx;
  background: #fbfaf5;
  color: #18241d;
  font-size: 26rpx;
  line-height: 1.65;
}

.description-placeholder {
  color: #a3aaa4;
}

.image-section {
  margin-top: 32rpx;
}

.image-picker,
.image-preview-wrap {
  position: relative;
  box-sizing: border-box;
  width: 220rpx;
  height: 220rpx;
  margin-top: 15rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2rpx dashed #cbd5cc;
  background: #f4f3ed;
}

.image-plus {
  color: #2f755b;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.image-picker-title {
  margin-top: 12rpx;
  color: #405047;
  font-size: 24rpx;
  font-weight: 800;
}

.image-picker-note {
  margin-top: 7rpx;
  color: #909991;
  font-size: 18rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(26, 37, 30, 0.78);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
}

.error-banner {
  margin-top: 24rpx;
  padding: 19rpx 22rpx;
  border-radius: 16rpx;
  background: #fff0eb;
  color: #b4472f;
  font-size: 23rpx;
  line-height: 1.55;
}

.submit-button,
.success-button {
  border-radius: 20rpx;
  background: #1d6b4f;
  color: #fffdf7;
  font-size: 29rpx;
  font-weight: 900;
}

.submit-button {
  margin-top: 30rpx;
}

.submit-button[disabled] {
  background: #719384;
  color: #f8f6ef;
}

.success-card {
  margin-top: 120rpx;
  padding: 54rpx 38rpx;
  text-align: center;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #e4efe6;
  color: #1d7a51;
  font-size: 48rpx;
  font-weight: 900;
}

.success-title {
  margin-top: 26rpx;
  color: #17251f;
  font-size: 38rpx;
  font-weight: 900;
}

.success-copy {
  margin-top: 14rpx;
  color: #748078;
  font-size: 24rpx;
  line-height: 1.65;
}

.success-button {
  margin-top: 32rpx;
}
