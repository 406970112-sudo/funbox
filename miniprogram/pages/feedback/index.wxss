.feedback-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 95% 0%, #eaf2ff, transparent 40%), #f5f7fa;
}

.hero-kicker,
.hero-title,
.hero-copy,
.field-label,
.field-count,
.field-note,
.image-picker-title,
.image-picker-note,
.success-title,
.success-copy {
  display: block;
}

.feedback-hero {
  padding: 6rpx 2rpx 28rpx;
  animation: fb-reveal 0.3s ease-out both;
}

.hero-kicker {
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
}

.hero-title {
  flex: 1;
  min-width: 0;
  color: var(--fb-ink);
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.feedback-art {
  width: 130rpx;
  height: 130rpx;
}

.hero-copy {
  margin-top: 8rpx;
  color: #66758d;
  font-size: 24rpx;
  line-height: 1.8;
}

.form-card,
.success-card {
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(38, 76, 133, 0.035);
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}

.field-label {
  color: #34425b;
  font-size: 27rpx;
  font-weight: 800;
}

.field-count,
.field-note {
  color: #7b879c;
  font-size: 22rpx;
}

.description-input {
  box-sizing: border-box;
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 20rpx;
  background: #f9fbff;
  color: var(--fb-ink);
  font-family: inherit;
  font-size: 27rpx;
  line-height: 1.8;
}

.description-placeholder {
  color: #7b879c;
}

.image-section {
  margin-top: 30rpx;
}

.image-picker,
.image-preview-wrap {
  position: relative;
  box-sizing: border-box;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 18rpx;
  border: 2rpx dashed #b8cbf8;
  background: #f2f7ff;
  text-align: center;
}

.image-plus {
  color: var(--fb-primary);
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1;
}

.image-picker-title {
  margin-top: 12rpx;
  color: var(--fb-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.image-picker-note {
  margin-top: 10rpx;
  color: #66758d;
  font-size: 21rpx;
  line-height: 1.6;
}

.image-preview-wrap {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx solid #e2e9f4;
  background: #f2f7ff;
}

.image-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  min-width: 28px;
  min-height: 28px;
  border-radius: 50%;
  background: rgba(23, 33, 57, 0.78);
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff0ed;
  color: #c74d38;
  font-size: 23rpx;
  line-height: 1.7;
}

.submit-button,
.success-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin: 28rpx 0 0;
  padding: 22rpx 14rpx;
  border-radius: 22rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.submit-button[disabled] {
  background: #c3d1f4;
  color: #fff;
}

.success-card {
  margin-top: 60rpx;
  padding: 32rpx 34rpx 40rpx;
  text-align: center;
}

.success-art {
  width: 210rpx;
  height: 210rpx;
  margin: 0 auto;
}

.success-title {
  margin-top: 12rpx;
  color: var(--fb-ink);
  font-size: 39rpx;
  font-weight: 900;
}

.success-copy {
  margin-top: 16rpx;
  color: #66758d;
  font-size: 24rpx;
  line-height: 1.8;
}
