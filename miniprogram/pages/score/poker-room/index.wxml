<view class="room-page">
  <view wx:if="{{loading}}" class="state-panel">
    <view class="loading-tile">±</view>
    <text class="state-title">正在同步牌局</text>
    <text class="state-desc">稍等一下，马上把最新分数带回来。</text>
  </view>

  <view wx:elif="{{joinNeeded && previewRoom}}" class="join-preview">
    <view class="preview-welcome">
      <view class="preview-invite-icon" aria-hidden="true"><view></view><view></view></view>
      <text class="preview-kicker">好友邀请你加入牌局</text>
      <text class="preview-headline">牌友都在，等你入座</text>
    </view>
    <view class="preview-room-card">
      <view class="preview-room-info">
        <view class="preview-art art art-poker"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
        <view class="preview-room-copy"><text class="preview-title">{{previewRoom.name}}</text><text class="preview-room-meta">炸金花记分 · {{previewRoom.maxPlayers > 0 ? previewRoom.maxPlayers + ' 人牌局' : '人数不限'}}</text><text class="preview-status">{{previewRoom.status === 'active' ? '牌局进行中' : '等待加入'}}</text></view>
      </view>
      <view class="preview-verified"><text class="verified-check" aria-hidden="true">✓</text><text>邀请已验证，无需房间码和密码</text></view>
    </view>
    <view class="preview-confirm">
      <text class="preview-name-label">怎么称呼你？</text>
      <input class="field-input" data-field="joinNickname" maxlength="48" placeholder="牌局内显示的名字" value="{{joinNickname}}" bindinput="handleJoinField" disabled="{{joining}}" />
      <text class="preview-name-help">仅在本局内显示，可修改</text>
      <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>
      <button class="primary-button" loading="{{joining}}" disabled="{{joining}}" bindtap="joinFromInvite">确认加入</button>
      <text class="preview-confirm-help">下场开始时参与，之前的账不分摊</text>
    </view>
    <text class="preview-footer">扫码与邀请链接，均可快捷入桌</text>
    <button class="preview-home" bindtap="goHome" disabled="{{joining}}">返回首页</button>
  </view>

  <view wx:elif="{{errorMessage && !room}}" class="state-panel error-state">
    <view class="error-mark">!</view>
    <text class="state-title">无法打开牌局</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button wx:if="{{canRetryLoad}}" class="primary-button compact" bindtap="retryOpenRoom">重新加载</button>
    <button class="{{canRetryLoad ? 'secondary-button' : 'primary-button'}} compact" bindtap="goHome">返回首页</button>
  </view>

  <block wx:elif="{{room && poker}}">
    <view class="poker-head"><view><text class="poker-title">{{room.name}}</text><text class="muted">房间码 {{room.code}} · {{poker.seats.length}} 人{{poker.betweenHands ? '入座' : '本场'}}</text></view><button class="tiny" data-sheet="feedback" bindtap="openSheet">提示设置</button></view>
    <view wx:if="{{offline || networkSyncing}}" class="warning" role="alert">{{offline ? '网络中断，操作已暂停。恢复后自动同步。' : '网络已恢复，正在同步最新牌局…'}}</view>
    <view wx:elif="{{realtimeStatus !== 'online'}}" class="muted sync-note" bindtap="retryRealtime">实时连接恢复中 · 分数定时刷新</view>
    <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>
    <view wx:if="{{feedback}}" class="feedback-banner">{{feedback}}</view>
    <view wx:if="{{showAccountBinding && !accountBound}}" class="card account-row"><text>登录绑定，散场后保留战绩</text><button class="tiny" bindtap="openAccountLogin">登录并绑定</button></view>
    <view wx:if="{{poker.ended}}" class="card"><text class="poker-title">这桌，账已理清</text><text class="muted">全部曾参与玩家已计入 · 每分 {{poker.rateMoney}}</text></view>
    <block wx:elif="{{poker.betweenHands}}">
      <view wx:if="{{isHost}}" class="card invite-card"><view class="invite-row"><view><text class="card-title">扫码或转发邀请牌友加入</text><text class="muted">下场参与，之前的账不分摊</text><text wx:if="{{hostRoomPassword}}" class="muted">密码 {{hostRoomPassword}}</text></view><view bindtap="toggleQrExpanded"><image wx:if="{{qrImageSrc}}" src="{{qrImageSrc}}" mode="aspectFit" style="width:112px;height:112px"/><canvas wx:elif="{{inviteToken && qrCodeFailed && !qrExpanded}}" canvas-id="roomQr" style="width:112px;height:112px"/><text class="muted">点击放大</text></view></view><button class="primary-button" open-type="share" disabled="{{!inviteToken}}">转发邀请给好友</button></view>
      <view class="card"><text class="card-title">{{poker.latestFinishedHand ? '本场已记，继续开场' : '牌友都在，准备开场'}}</text><text class="muted">每分金额固定 · 名单变动后请核对下场座位</text></view>
    </block>
    <block wx:else>
      <view class="turn-banner {{poker.canAct ? 'my-turn' : ''}}" role="status"><text class="card-title">{{poker.phase === 'comparing' ? '已跟注，等待现场比牌' : poker.phase === 'showdown' ? '封顶 3 圈已满，现场开牌' : poker.phase === 'bonus' ? '亮牌后，记喜钱' : poker.canAct ? '轮到你了，' + poker.actorName : '轮到' + poker.actorName + '了'}}</text><text class="muted">第 {{poker.hand.number}} 场 · 第 {{poker.hand.circleNumber}} 圈 · {{poker.liveCount}} 人在局</text><text wx:if="{{poker.phase === 'betting' && poker.nextActorName}}" class="muted">{{poker.actorPosition}} 号位行动 · 下一位：{{poker.nextActorName}}（{{poker.nextActorPosition}} 号）</text></view>
      <view class="card pot-card {{potPulse ? 'pot-pulse pot-' + potFeedback.band : ''}}"><view class="pot-caption"><text>公共积分池</text><text>1 分 = {{poker.rateMoney}}</text></view><view class="pot-values"><text class="pot-money">{{poker.potMoney}}</text><text class="pot-points">{{poker.hand.potPoints}}<text class="unit"> 分</text></text></view><text wx:if="{{potPulse && potFeedback}}" class="pot-delta">+{{potFeedback.deltaPoints}} 分 / +{{potFeedback.deltaMoney}}</text></view>
      <view class="base-bet"><text>基准 {{poker.hand.currentBetPoints}} 分</text><text>本人应跟 {{poker.followPoints}} 分</text></view>
      <view wx:if="{{poker.hand.currentBetPoints >= poker.settings.maxBetPoints}}" class="warning">已封顶 · 封顶后剩余 {{poker.hand.capCirclesRemaining}} 圈 · 不再加注</view>
    </block>
    <view wx:if="{{!poker.ended}}" class="seat-grid columns-{{poker.seatColumns}}"><view wx:for="{{poker.seats}}" wx:key="id" class="seat {{item.isActor ? 'actor-seat' : ''}} {{item.status === 'folded' || item.status === 'eliminated' ? 'out-seat' : ''}}"><view class="seat-top"><text class="seat-number">{{item.position}}</text><text class="seat-name">{{item.name}}</text><text wx:if="{{item.isSelf}}" class="self-mark">我</text></view><text class="seat-state">{{item.isActor ? '行动中 · ' : ''}}{{item.stateText}}</text><text class="seat-points">{{item.contributionPoints || 0}} 分</text></view></view>
    <button wx:if="{{poker.comparePending}}" class="secondary-button" data-sheet="compare" bindtap="openSheet">继续已付费比牌（不再扣分）</button>
    <view class="toolbar"><button class="tiny" data-sheet="ledger" bindtap="openSheet">整桌账本 ›</button><button class="tiny" data-sheet="members" bindtap="openSheet">管理玩家 ›</button><button class="tiny" data-sheet="settings" bindtap="openSheet">规则摘要 ›</button></view>
    <view wx:if="{{poker.phase === 'showdown'}}" class="card"><text class="card-title">现场核对，选择在局赢家</text><text class="muted">并列时先按桌上约定核对唯一赢家</text><view class="choices"><button wx:for="{{poker.showdownPlayers}}" wx:key="id" class="choice {{winnerId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectWinner" disabled="{{!isHost || busy || offline}}">{{item.name}}</button></view><button wx:if="{{isHost}}" class="primary-button" disabled="{{!winnerId || busy || offline}}" bindtap="confirmShowdown">确认赢家，核对喜钱</button><text wx:else class="muted">等待房主记录现场结果</text></view>
    <view wx:if="{{poker.phase === 'bonus'}}" class="card"><text class="card-title">喜钱登记 · 本场 {{poker.bonusPlayers.length}} 人</text><text class="warning">与本场输赢无关 · 冻结名单内其他所有人支付，包含已弃牌玩家</text><text class="muted">豹子 {{poker.settings.baoziBonusPoints}} 分/人 · 顺金 {{poker.settings.shunjinBonusPoints}} 分/人</text><view wx:for="{{bonusRows}}" wx:key="id" class="bonus-row"><text>{{item.name}}</text><view class="choices"><button class="choice {{!item.selectedKind ? 'selected' : ''}}" data-id="{{item.id}}" data-kind="" bindtap="chooseBonus" disabled="{{!isHost || busy || offline}}">无</button><button class="choice {{item.selectedKind === 'baozi' ? 'selected' : ''}}" data-id="{{item.id}}" data-kind="baozi" bindtap="chooseBonus" disabled="{{!isHost || busy || offline}}">豹子</button><button class="choice {{item.selectedKind === 'shunjin' ? 'selected' : ''}}" data-id="{{item.id}}" data-kind="shunjin" bindtap="chooseBonus" disabled="{{!isHost || busy || offline}}">顺金</button></view></view><block wx:if="{{isHost}}"><checkbox-group bindchange="toggleBonusCheck"><label><checkbox value="checked" checked="{{bonusChecked}}"/>已现场核对亮牌与本场所有喜钱</label></checkbox-group><button class="primary-button" bindtap="confirmBonus" disabled="{{busy || offline || !bonusChecked}}">确认喜钱，记入本场账单</button><button class="secondary-button" data-none="true" bindtap="confirmBonus" disabled="{{busy || offline}}">本场无喜钱</button></block><text wx:else class="muted">等待房主核对并确认</text></view>
    <view wx:if="{{poker.betweenHands && poker.latestFinishedHand}}" class="card"><text class="card-title">本场账单（含喜钱）</text><view wx:for="{{poker.resultPlayers}}" wx:key="id" class="ledger-row"><text>{{item.name}}</text><text>{{item.deltaText}} 分</text><text>{{item.money}}</text></view></view>
    <view wx:if="{{poker.ended}}" class="card"><view wx:for="{{poker.members}}" wx:key="id" class="ledger-row"><text>{{item.displayName}} {{item.seatStatus === 'left' ? '· 已离场' : ''}}</text><text>{{item.scoreText}} 分</text><text>{{item.money}}</text></view><text class="card-title">转账建议</text><view wx:for="{{settlementTransfers}}" wx:key="key" class="ledger-row"><text>{{item.fromName}} → {{item.toName}}</text><text>{{item.amountText}}</text></view><button class="secondary-button" bindtap="goHome">返回首页</button></view>
    <view class="action-dock" wx:if="{{!poker.ended}}">
      <block wx:if="{{poker.betweenHands}}"><button class="primary-button" wx:if="{{isHost}}" disabled="{{!poker.canStart}}" loading="{{busy}}" bindtap="startHand">{{poker.canStart ? '开始第 ' + poker.nextHandNumber + ' 场' : '至少 2 人入座才能开始'}}</button><text wx:else class="waiting-copy">等待房主开场 · 下场名单可在管理玩家中查看</text></block>
      <block wx:elif="{{poker.canAct}}"><button class="primary-button" bindtap="follow">跟注 {{poker.followPoints}} 分（{{poker.followMoney}}）</button><view class="choices"><button class="secondary-button" disabled="{{!poker.canRaise}}" bindtap="openRaise">加注</button><button class="secondary-button" disabled="{{!poker.canLook}}" bindtap="look">{{poker.canLook ? '我已看牌' : '已看 · 2倍'}}</button><button class="secondary-button" bindtap="fold">弃牌</button></view><button wx:if="{{poker.canCompare}}" class="secondary-button" bindtap="openCompare">比牌（剩 {{poker.liveCount}} 人）</button></block>
      <text wx:elif="{{busy}}" class="waiting-copy">同步中，请勿重复操作…</text><text wx:elif="{{poker.phase === 'betting'}}" class="waiting-copy">{{offline ? '网络中断，操作已暂停' : '等待' + poker.actorName + '行动 · 自动同步，无需反复刷新'}}</text>
    </view>
  </block>
  <view wx:if="{{qrExpanded && inviteToken}}" class="qr-preview-mask" bindtap="closeQrExpanded"><view class="qr-preview-card" catchtap="noop"><text class="card-title">邀请二维码</text><image wx:if="{{qrImageSrc}}" src="{{qrImageSrc}}" mode="aspectFit" style="width:{{qrLargeSize}}px;height:{{qrLargeSize}}px"/><canvas wx:else canvas-id="roomQrLarge" style="width:{{qrLargeSize}}px;height:{{qrLargeSize}}px"/><text class="muted">再次点击收起</text></view></view>
  <view wx:if="{{sheet}}" class="poker-mask" bindtap="closeSheet"><scroll-view scroll-y class="poker-sheet" catchtap="noop"><view class="sheet-heading"><text class="card-title">{{sheet === 'comparePay' ? '先跟注，再比牌' : sheet === 'compare' ? '选择对手，现场核对结果' : sheet === 'raise' ? '加注' : sheet === 'members' ? '玩家管理' : sheet === 'ledger' ? '整桌账本' : sheet === 'feedback' ? '提示与反馈' : '房间规则'}}</text><button class="tiny" bindtap="closeSheet" disabled="{{busy}}">关闭</button></view>
    <view wx:if="{{poker.canAct && (sheet === 'ledger' || sheet === 'members' || sheet === 'settings')}}" class="sheet-turn-notice" role="status"><text>轮到你了，{{poker.actorName}}</text><button class="tiny" bindtap="closeSheet">返回本场</button></view>
    <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
    <block wx:if="{{sheet === 'comparePay'}}"><text class="sheet-info">本次先跟注 {{poker.followPoints}} 分（{{poker.followMoney}}），计入公共积分池，不另收比牌费。</text><button class="primary-button" bindtap="payCompare" disabled="{{!poker.canCompare}}">跟注 {{poker.followPoints}} 分，选择对手</button><button class="secondary-button" bindtap="closeSheet">暂不比牌</button></block>
    <block wx:elif="{{sheet === 'compare'}}"><text class="sheet-info">✓ 已跟注 {{poker.hand.pendingComparison.points}} 分，已计入池。不再收费。</text><view class="choices"><button wx:for="{{poker.compareTargets}}" wx:key="id" class="choice {{targetId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTarget" disabled="{{!poker.comparePending}}">{{item.name}}</button></view><text class="card-title">现场比牌结果（以本人为准）</text><view class="choices"><button class="choice {{outcome === 'win' ? 'selected' : ''}}" data-value="win" bindtap="selectOutcome">我大</button><button class="choice {{outcome === 'lose' ? 'selected' : ''}}" data-value="lose" bindtap="selectOutcome">对方大</button><button class="choice {{outcome === 'tie' ? 'selected' : ''}}" data-value="tie" bindtap="selectOutcome">同大小</button></view><text wx:if="{{outcome === 'tie'}}" class="warning">同大小，主动比牌者输，本人出局。</text><button class="primary-button" disabled="{{!targetId || !outcome || !poker.comparePending}}" bindtap="confirmCompare">确认结果，轮到下一位</button></block>
    <block wx:elif="{{sheet === 'raise'}}"><text class="sheet-info">输入新的基准 {{poker.hand.currentBetPoints + 1}}～{{poker.settings.maxBetPoints}} 分；闷牌付 1 倍，看牌付 2 倍。</text><input type="number" class="field-input" data-field="raiseBase" value="{{raiseBase}}" bindinput="field"/><text class="sheet-info">本次实际投入 {{raiseCostPoints}} 分（{{raiseCostMoney}}）</text><button class="primary-button" bindtap="confirmRaise" disabled="{{!poker.canRaise}}">确认加注</button></block>
    <block wx:elif="{{sheet === 'members'}}"><button wx:if="{{isHost && poker.hand && !poker.betweenHands && !poker.ended}}" class="danger-button" disabled="{{busy || offline || networkSyncing}}" bindtap="cancelHand">撤销本场（累计历史保留）</button><text class="sheet-info">仅在场间调整座位；历史、身份与累计分数始终保留。</text><view wx:for="{{poker.members}}" wx:key="id" class="member-row"><view><text>{{item.displayName}} {{item.role === 'host' ? '· 房主' : ''}}</text><text class="muted">{{item.seatLabel}} · {{item.scoreText}} 分 · {{item.money}}</text></view><button wx:if="{{poker.canManage && item.seatStatus === 'pending'}}" class="tiny" data-id="{{item.id}}" data-action="admit" bindtap="memberAction">同意入座</button><button wx:if="{{poker.canManage && item.seatStatus !== 'left' && item.seatStatus !== 'pending' && item.id !== self.id}}" class="tiny" data-id="{{item.id}}" data-action="offer_host" bindtap="memberAction">转让房主</button></view><button wx:if="{{poker.canAcceptHost}}" class="primary-button" data-id="{{self.id}}" data-action="accept_host" bindtap="memberAction">接受房主转让</button><text wx:if="{{room.pendingHostParticipantId}}" class="muted">等待接任者接受，原房主权限仍保留。</text><button wx:if="{{poker.canLeave}}" class="secondary-button" data-id="{{self.id}}" data-action="leave" bindtap="memberAction">离场（历史保留）</button><button wx:if="{{poker.canRejoin}}" class="primary-button" data-id="{{self.id}}" data-action="rejoin" bindtap="memberAction">申请重新入座</button></block>
    <block wx:elif="{{sheet === 'ledger'}}"><text class="card-title">整桌累计 · 含喜钱与已离场玩家</text><view wx:for="{{poker.members}}" wx:key="id" class="ledger-row"><text>{{item.displayName}}</text><text>{{item.scoreText}} 分</text><text>{{item.money}}</text></view><view wx:for="{{poker.ledger}}" wx:key="id" class="history-card"><text class="card-title">第 {{item.number}} 场 · {{item.status === 'cancelled' ? '已撤销 · 不入账' : item.phase === 'finished' ? '已入账' : item.phase}}</text><view wx:for="{{item.rows}}" wx:for-item="row" wx:key="id" class="ledger-row"><text>{{row.name}}</text><text wx:if="{{item.status === 'cancelled'}}">本场作废，分数不入账</text><block wx:else><text>本场 {{row.gameText}} · 喜钱 {{row.bonusText}}</text><text>{{row.deltaText}} 分</text></block></view></view><button wx:if="{{poker.canManage}}" class="danger-button" bindtap="settle" disabled="{{busy || offline}}">散场结算（每分 {{poker.rateMoney}}）</button></block>
    <block wx:elif="{{sheet === 'feedback'}}"><view class="preference-row"><text>轮到我时震动</text><switch checked="{{vibrate}}" data-field="vibrate" bindchange="togglePreference"/></view><view class="preference-row"><text>减少动态</text><switch checked="{{reducedMotion}}" data-field="reducedMotion" bindchange="togglePreference"/></view><view class="preference-row"><text>金额变化动效</text><switch checked="{{potMotion}}" data-field="potMotion" bindchange="togglePreference"/></view><text class="sheet-info">仅新一轮轮到本人时提醒一次；不自动弃牌。减少动态时直接展示最终金额。</text></block>
    <block wx:elif="{{sheet === 'settings'}}"><text class="sheet-info">每分 {{poker.rateMoney}}（创建后固定） · {{room.maxPlayers > 0 ? room.maxPlayers + ' 人上限' : '人数不限'}}</text><text class="sheet-info">闷牌 1 倍，看牌 2 倍；看牌不收费。封顶前不限圈，封顶后再走 3 整圈。</text><view class="setting-row"><text>底注（分）</text><input type="number" value="{{settingsDraft.antePoints}}" data-field="settingsDraft.antePoints" bindinput="field" disabled="{{!poker.canManage}}"/></view><view class="setting-row"><text>基准封顶（分）</text><input type="number" value="{{settingsDraft.maxBetPoints}}" data-field="settingsDraft.maxBetPoints" bindinput="field" disabled="{{!poker.canManage}}"/></view><view class="setting-row"><text>比牌剩余人数</text><input type="number" value="{{settingsDraft.compareThreshold}}" data-field="settingsDraft.compareThreshold" bindinput="field" disabled="{{!poker.canManage}}"/></view><view class="setting-row"><text>豹子（分/人）</text><input type="number" value="{{settingsDraft.baoziBonusPoints}}" data-field="settingsDraft.baoziBonusPoints" bindinput="field" disabled="{{!poker.canManage}}"/></view><view class="setting-row"><text>顺金（分/人）</text><input type="number" value="{{settingsDraft.shunjinBonusPoints}}" data-field="settingsDraft.shunjinBonusPoints" bindinput="field" disabled="{{!poker.canManage}}"/></view><text class="muted">场间修改只影响下一场；当前场以冻结设置为准。</text><button wx:if="{{poker.canManage}}" class="primary-button" bindtap="saveSettings">保存下场规则</button></block>
  </scroll-view></view>
</view>
