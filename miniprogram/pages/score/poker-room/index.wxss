align-items:center;gap:5rpx;font-size:25rpx;min-width:0}.seat-number,.self-mark{background:#eaf1ff;color:#2d5bff;border-radius:8rpx;padding:2rpx 6rpx;font-size:22rpx}.seat-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:650}.seat-state{display:block;font-size:21rpx;color:#8190a9;margin-top:12rpx;min-height:30rpx}.actor-seat .seat-state{color:#2d5bff;font-weight:650}.seat-points{display:block;font-size:27rpx;font-weight:650;margin-top:8rpx}.toolbar{margin:20rpx 0;gap:8rpx}.toolbar .tiny{flex:1;text-align:center;padding:12rpx 6rpx}.action-dock{position:fixed;bottom:0;left:0;right:0;background:rgba(245,247,250,.98);padding:18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e6eaf4;z-index:10}.action-dock .primary-button,.action-dock .secondary-button{margin-top:10rpx}.choices{display:flex;gap:12rpx;flex-wrap:wrap;margin:16rpx 0}.choices .secondary-button,.choices .choice{flex:1;min-width:100rpx;margin:0}.choice{background:#fff;border:2rpx solid #e3e9f6;color:#213858;border-radius:16rpx;line-height:1.5;padding:18rpx 10rpx;font-size:25rpx}.choice.selected{border-color:#2d5bff;color:#2d5bff;background:#edf3ff}.waiting-copy{display:block;text-align:center;padding:24rpx;font-size:25rpx;color:#7586a5}.poker-mask{position:fixed;inset:0;background:rgba(10,22,47,.48);z-index:40;display:flex;align-items:flex-end}.poker-sheet{width:100%;max-height:84vh;background:#fff;border-radius:30rpx 30rpx 0 0;padding:30rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx}.sheet-info{display:block;color:#7384a3;font-size:26rpx;line-height:1.7;margin:20rpx 0}.ledger-row{font-size:25rpx;padding:20rpx 0;border-bottom:1rpx solid #edf1f7;gap:8rpx}.ledger-row text:first-child{min-width:70rpx;max-width:200rpx;overflow-wrap:anywhere}.member-row{padding:20rpx 0;border-bottom:1rpx solid #edf1f7;font-size:27rpx}.history-card{m