@import "../room/index.wxss";
.room-page{padding:28rpx 28rpx 360rpx;color:#10203d}.poker-head,.pot-caption,.pot-values,.toolbar,.invite-row,.ledger-row,.member-row,.preference-row,.setting-row,.account-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.poker-head{margin-bottom:24rpx}.poker-title{display:block;font-size:36rpx;font-weight:750}.muted{display:block;color:#7b89a3;font-size:24rpx;line-height:1.6}.card{background:#fff;border:1rpx solid #e9edf5;border-radius:24rpx;padding:24rpx;margin:20rpx 0}.card-title{display:block;font-size:29rpx;font-weight:700;line-height:1.5}.tiny{font-size:24rpx;color:#2d5bff;background:#eef3ff;line-height:1.6;padding:12rpx 16rpx;margin:0;border-radius:14rpx;flex-shrink:0}.tiny::after,.choice::after{border:0}.turn-banner{padding:24rpx;border-radius:20rpx;background:#eaf0ff;margin-top:20rpx}.my-turn{border:2rpx solid #2d5bff;color:#2d5bff;background:#e5edff}.pot-caption{font-size:24rpx;color:#6d7d9c}.pot-values{flex-wrap:wrap;justify-content:space-between;margin-top:14rpx;gap:8rpx}.pot-money{font-size:clamp(52rpx,10vw,84rpx);font-weight:800;letter-spacing:-2rpx;color:#2454ff;overflow-wrap:anywhere}.pot-points{font-size:clamp(42rpx,8vw,64rpx);font-weight:750;overflow-wrap:anywhere}.unit{font-size:28rpx}.base-bet{display:flex;justify-content:space-between;font-size:26rpx;background:#edf4ff;padding:18rpx;border-radius:16rpx}.warning{display:block;background:#fff1eb;color:#d55b34;border-radius:16rpx;padding:20rpx;font-size:24rpx;line-height:1.6;margin:16rpx 0}.seat-grid{display:grid;gap:14rpx;margin-top:20rpx}.columns-2{grid-template-columns:repeat(2,minmax(0,1fr))}.columns-3{grid-template-columns:repeat(3,minmax(0,1fr))}.columns-4{grid-template-columns:repeat(4,minmax(0,1fr))}.seat{background:white;border:2rpx solid #e5ebf7;border-radius:18rpx;padding:18rpx 10rpx;min-width:0;text-align:center}.actor-seat{border-color:#2d5bff;box-shadow:0 0 0 3rpx #dfe8ff;background:#f4f7ff}.out-seat{opacity:.55}.seat-top{display:flex;justify-content:center;align-items:center;gap:5rpx;font-size:25rpx;min-width:0}.seat-number,.self-mark{background:#eaf1ff;color:#2d5bff;border-radius:8rpx;padding:2rpx 6rpx;font-size:22rpx}.seat-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:650}.seat-state{display:block;font-size:21rpx;color:#8190a9;margin-top:12rpx;min-height:30rpx}.actor-seat .seat-state{color:#2d5bff;font-weight:650}.seat-points{display:block;font-size:27rpx;font-weight:650;margin-top:8rpx}.toolbar{margin:20rpx 0;gap:8rpx}.toolbar .tiny{flex:1;text-align:center;padding:12rpx 6rpx}.action-dock{position:fixed;bottom:0;left:0;right:0;background:rgba(245,247,250,.98);padding:18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e6eaf4;z-index:10}.action-dock .primary-button,.action-dock .secondary-button{margin-top:10rpx}.choices{display:flex;gap:12rpx;flex-wrap:wrap;margin:16rpx 0}.choices .secondary-button,.choices .choice{flex:1;min-width:100rpx;margin:0}.choice{background:#fff;border:2rpx solid #e3e9f6;color:#213858;border-radius:16rpx;line-height:1.5;padding:18rpx 10rpx;font-size:25rpx}.choice.selected{border-color:#2d5bff;color:#2d5bff;background:#edf3ff}.waiting-copy{display:block;text-align:center;padding:24rpx;font-size:25rpx;color:#7586a5}.poker-mask{position:fixed;inset:0;background:rgba(10,22,47,.48);z-index:40;display:flex;align-items:flex-end}.poker-sheet{width:100%;max-height:84vh;background:#fff;border-radius:30rpx 30rpx 0 0;padding:30rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx}.sheet-info{display:block;color:#7384a3;font-size:26rpx;line-height:1.7;margin:20rpx 0}.ledger-row{font-size:25rpx;padding:20rpx 0;border-bottom:1rpx solid #edf1f7;gap:8rpx}.ledger-row text:first-child{min-width:70rpx;max-width:200rpx;overflow-wrap:anywhere}.member-row{padding:20rpx 0;border-bottom:1rpx solid #edf1f7;font-size:27rpx}.history-card{margin-top:28rpx;padding:20rpx;background:#f7f9fe;border-radius:18rpx}.preference-row,.setting-row{padding:22rpx 0;border-bottom:1rpx solid #edf1f7;font-size:28rpx}.setting-row input{width:160rpx;background:#f4f7fb;padding:16rpx;border-radius:12rpx;text-align:right;font-size:28rpx}.bonus-row{padding:18rpx 0;border-bottom:1rpx solid #edf1f7;font-size:28rpx}.bonus-row .choices{margin:10rpx 0}.invite-row{margin-bottom:18rpx}.invite-row canvas,.invite-row image{flex-shrink:0}.invite-row>view:first-child{min-width:0}.sync-note{margin:12rpx 0}.account-row{font-size:24rpx}.poker-sheet .primary-button,.poker-sheet .secondary-button,.poker-sheet .danger-button{margin-top:18rpx}

.pot-card { position: relative; padding-bottom: 42rpx; }
.pot-delta { position: absolute; bottom: 8rpx; right: 24rpx; font-size: 22rpx; color: #248a72; }
.pot-small .pot-values { animation: potSmall .6s ease-out 1; }
.pot-medium .pot-values { animation: potMedium .6s ease-out 1; }
.pot-large .pot-values { animation: potLarge .6s ease-out 1; }
@keyframes potSmall { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.01); } }
@keyframes potMedium { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.02); } }
@keyframes potLarge { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.035); } }

.turn-banner { position: sticky; top: 0; z-index: 6; box-shadow: 0 6rpx 18rpx rgba(36,84,255,.05); }
.sheet-turn-notice { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx; background: #eaf1ff; color: #2d5bff; border: 2rpx solid #2d5bff; border-radius: 16rpx; font-size: 27rpx; }
