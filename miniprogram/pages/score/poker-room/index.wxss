.pot-card { position: relative; padding-bottom: 42rpx; }
.pot-delta { position: absolute; bottom: 8rpx; right: 24rpx; font-size: 22rpx; color: #248a72; }
.pot-small .pot-values { animation: potSmall .6s ease-out 1; }
.pot-medium .pot-values { animation: potMedium .6s ease-out 1; }
.pot-large .pot-values { animation: potLarge .6s ease-out 1; }
@keyframes potSmall { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.01); } }
@keyframes potMedium { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.02); } }
@keyframes potLarge { 0%, 100% { transform: scale(1); } 40% { transform: scale(1.035); } }

.turn-banner { position: sticky; top: 0; z-index: 6; box-shadow: 0 6rpx 18rpx rgba(36,84,255,.05); }
.sheet-turn-notice { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx; background: #eaf1ff; color: #2d5bff; border: 2rpx solid #2d5bff; border-radius: 16rpx; font-size: 27rpx; }

/* 身份、状态和金额各占一层，手机上保持两列可读宽度。 */
.seat { padding: 22rpx; text-align: left; border-radius: 24rpx; }
.seat-top { justify-content: flex-start; gap: 10rpx; }
.seat-number { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; padding: 0; border-radius: 12rpx; font-weight: 750; }
.seat-role { color: #7b89a3; font-size: 21rpx; }
.self-mark { margin-left: auto; font-size: 20rpx; }
.seat-name { display: block; margin-top: 16rpx; font-size: 29rpx; line-height: 1.5; }
.seat-status { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; color: #7b89a3; font-size: 22rpx; }
.seat-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #aab7cc; flex-shrink: 0; }
.actor-seat .seat-status { color: #2d5bff; }
.actor-seat .seat-dot { background: #2d5bff; }
.seat-score { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6rpx; border-top: 1rpx solid #edf1f7; padding-top: 14rpx; margin-top: 18rpx; }
.seat-score-label { font-size: 20rpx; color: #7b89a3; }
.seat-points { margin: 0; font-size: 32rpx; font-weight: 750; overflow-wrap: anywhere; }
.seat-unit { font-size: 20rpx; font-weight: 400; color: #7b89a3; }
.toolbar .tiny { display: flex; align-items: center; justify-content: space-between; gap: 4rpx; padding: 18rpx 16rpx; min-width: 0; font-size: 23rpx; line-height: 1.4; }
.toolbar-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 22rpx; height: 28rpx; }
.toolbar-arrow::before { content: ""; display: block; width: 10rpx; height: 10rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.dismiss-button { color: #365785; background: #e8eef9; }
.qr-close { margin: 24rpx auto 0; width: 240rpx; }

/* 只有确认有喜钱时才展示名单，牌型按人展开。 */
.bonus-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; }
.bonus-gate { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.bonus-gate .primary-button { margin: 0; }
.bonus-gate .tiny { align-self: center; background: transparent; }
.bonus-help { margin: 12rpx 0; font-size: 22rpx; }
.bonus-reset { margin: 0; padding: 8rpx 0; color: #2d5bff; background: transparent; font-size: 22rpx; line-height: 1.5; }
.bonus-row { padding: 0; }
.bonus-player { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; padding: 18rpx 0; margin: 0; text-align: left; background: transparent; font-size: 26rpx; line-height: 1.5; }
.bonus-name { min-width: 0; overflow-wrap: anywhere; }
.bonus-player-value { display: flex; align-items: center; gap: 16rpx; color: #8794aa; flex-shrink: 0; }
.has-bonus .bonus-player-value { color: #2d5bff; font-weight: 650; }
.bonus-chevron { font-size: 30rpx; line-height: 1; }
.bonus-options { display: flex; gap: 12rpx; padding: 0 0 16rpx; }
.bonus-option { width: auto; min-width: 92rpx; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid #e3e9f6; border-radius: 12rpx; background: #f6f8fc; color: #61728c; font-size: 23rpx; line-height: 1.5; }
.bonus-option.selected { background: #edf3ff; color: #2d5bff; border-color: #2d5bff; }
.bonus-check { display: flex; align-items: center; gap: 14rpx; padding: 22rpx 0; margin: 0; background: transparent; text-align: left; color: #536681; font-size: 23rpx; line-height: 1.6; }
.check-circle { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 2rpx solid #c5d0e2; border-radius: 50%; flex-shrink: 0; }
.check-circle.checked { background: #2d5bff; border-color: #2d5bff; color: #fff; font-size: 24rpx; font-weight: 800; }
.bonus-reset::after, .bonus-player::after, .bonus-option::after, .bonus-check::after { border: 0; }

/* 整桌累计优先于逐场明细，金额与分数分层。 */
.ledger-summary { background: #edf3ff; border: 1rpx solid #d8e4ff; border-radius: 24rpx; padding: 24rpx; }
.ledger-summary-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.ledger-summary-title { font-size: 34rpx; font-weight: 800; color: #183e87; }
.ledger-rate { font-size: 22rpx; color: #5273ac; }
.ledger-summary-note { display: block; color: #7184a4; font-size: 22rpx; line-height: 1.6; }
.ledger-total-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #dbe5f7; }
.ledger-total-row:last-child { border-bottom: 0; padding-bottom: 0; }
.ledger-person { min-width: 0; }
.ledger-name { font-size: 28rpx; font-weight: 650; overflow-wrap: anywhere; }
.ledger-total-value { text-align: right; flex-shrink: 0; }
.ledger-money { display: block; font-size: 36rpx; font-weight: 800; color: #2454ff; }
.ledger-money.loss { color: #b95340; }
.ledger-history-title { display: block; margin: 28rpx 0 0; color: #7184a4; font-size: 25rpx; font-weight: 650; }
@media (max-width: 340px) { .seat { padding: 16rpx; } .toolbar .tiny { padding: 16rpx 10rpx; } .ledger-summary { padding: 18rpx; } .ledger-money { font-size: 31rpx; } }

/* 入座状态放在房间首页，房主可直接进入处理入口。 */
.membership-notice { margin: 18rpx 0; padding: 24rpx; border: 1rpx solid #d7e3ff; border-radius: 22rpx; background: #edf3ff; }
.membership-copy { min-width: 0; }
.membership-copy .card-title { font-size: 28rpx; color: #244e98; }
.membership-copy .muted { margin-top: 6rpx; font-size: 22rpx; }
.rejoin-button { margin-top: 18rpx; padding: 18rpx 12rpx; font-size: 27rpx; }
.admission-notice { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-color: #ffdfaf; background: #fff6e8; }
.admission-notice .card-title { color: #89551d; }
.admission-button { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 18rpx; background: #ffead0; color: #89551d; }
.admission-sheet-note { padding: 16rpx 20rpx; margin-bottom: 12rpx; background: #fff6e8; border-radius: 14rpx; color: #89551d; font-size: 24rpx; }

/* 邀请信息与二维码并排，转发按钮收进左侧，减少纵向占用。 */
.poker-invite-card { padding: 22rpx; margin-top: 18rpx; border-radius: 24rpx; }
.poker-invite-card .invite-main { margin-top: 0; gap: 18rpx; }
.poker-invite-card .invite-title { margin-top: 0; font-size: 29rpx; }
.poker-invite-card .invite-desc { margin-top: 4rpx; font-size: 20rpx; line-height: 1.5; }
.poker-invite-card .room-code-box { display: inline-flex; align-items: center; flex-wrap: wrap; max-width: 100%; gap: 8rpx 14rpx; padding: 0; margin-top: 10rpx; background: transparent; }
.poker-invite-card .room-code-value { padding: 6rpx 12rpx; border-radius: 10rpx; background: #edf3ff; font-size: 34rpx; letter-spacing: 1rpx; }
.poker-invite-card .room-code-copy { display: flex; align-items: center; gap: 8rpx; margin-top: 0; color: #607ca8; font-size: 19rpx; }
.copy-code-icon { position: relative; width: 18rpx; height: 18rpx; flex-shrink: 0; }
.copy-code-icon::before, .copy-code-icon::after { content: ""; position: absolute; width: 11rpx; height: 13rpx; border: 2rpx solid currentColor; border-radius: 3rpx; }
.copy-code-icon::before { top: 0; left: 0; opacity: .5; }
.copy-code-icon::after { right: 0; bottom: 0; background: #fff; }
.poker-invite-card .room-password-box { margin-top: 6rpx; gap: 8rpx; }
.poker-invite-card .room-password-value { font-size: 21rpx; }
.poker-invite-card .share-button { margin-top: 12rpx; padding: 12rpx; font-size: 24rpx; border-radius: 14rpx; }
.poker-invite-card .qr-box { width: 96px; min-height: 96px; padding: 4px; }
.poker-invite-card .qr-expand-hint { margin-top: 4rpx; }
