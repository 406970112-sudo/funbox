.mahjong-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 52rpx;
  background: radial-gradient(ellipse at 100% 0%,#eaf3ff,transparent 36%),#f5f7fa;
}

.mahjong-join-page {
  display: flex;
  flex-direction: column;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.mahjong-join-page > .hero,.mahjong-join-page > .mode-tabs {
  flex-shrink: 0;
}

.hero {
  position: relative;
  padding: 6rpx 2rpx 18rpx;
  animation: fb-reveal .3s ease-out both;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-brand {
  color: #2d5bff;
  font-size: 24rpx;
  font-weight: 800;
}

.account-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 220rpx;
  padding: 6rpx 14rpx 6rpx 6rpx;
  border-radius: 99rpx;
  background: #fff;
  color: #66758d;
  font-size: 21rpx;
}

.account-link > text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e7efff;
  color: #2d5bff;
  font-weight: 700;
}

.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 166rpx;
}

.hero-content > view:first-child {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 37rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b879c;
  font-size: 21rpx;
}

.entry-art {
  width: 160rpx;
  height: 160rpx;
  margin-right: -8rpx;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 28rpx;
  padding: 7rpx;
  border-radius: 25rpx;
  background: #e9eef6;
}

.mode-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  color: #7b879c;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.mode-tab.active {
  background: #2d5bff;
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(45,91,255,.15);
}

.form-card {
  padding: 30rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(38,76,133,.035);
}

.form-head {
  display: flex;
}

.form-head {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-head {
  margin-bottom: 10rpx;
}

.form-title {
  font-size: 33rpx;
  font-weight: 800;
}

.form-badge {
  flex-shrink: 0;
  padding: 5rpx 13rpx;
  border-radius: 99rpx;
  background: #f1f5fc;
  color: #8490a4;
  font-size: 19rpx;
}

.room-name-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.inline-control {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  border-bottom: 2rpx solid transparent;
  border-radius: 8rpx 8rpx 0 0;
  transition: background .15s ease, border-color .15s ease;
}

.inline-control-active {
  border-bottom-color: #2d5bff;
  background: #edf4ff;
}

.room-name-control {
  max-width: 100%;
}

.inline-input {
  min-width: 0;
  height: 76rpx;
  min-height: 44px;
  padding: 0 4rpx;
  color: #34425b;
}

.room-name-input {
  width: 220rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.inline-edit {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  min-width: 0;
  margin: 0;
  padding: 0 0 0 8rpx;
  border-radius: 8rpx;
  background: transparent;
  line-height: 1;
}

.inline-edit::after { border: 0; }
.inline-edit[disabled] { background: transparent; }

.edit-pencil {
  position: relative;
  width: 9rpx;
  height: 25rpx;
  border-radius: 2rpx;
  background: #a1acbb;
  transform: rotate(40deg);
}

.edit-pencil::after {
  content: "";
  position: absolute;
  bottom: -7rpx;
  left: 0;
  border: 4.5rpx solid transparent;
  border-top: 6rpx solid #a1acbb;
  border-bottom: 0;
}

.create-settings-hint {
  display: block;
  margin-top: 2rpx;
  color: #8b97a9;
  font-size: 21rpx;
  line-height: 1.5;
}

.field {
  margin-top: 27rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #34425b;
  font-size: 25rpx;
  font-weight: 700;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.field-label-row .field-label {
  margin-bottom: 0;
}

.field-hint {
  flex-shrink: 0;
  color: #97a2b4;
  font-size: 20rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 22rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 17rpx;
  background: #fff;
  color: #172139;
  font-size: 28rpx;
}

.code-input {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
}

.password-label {
  flex-shrink: 0;
  color: #34425b;
  font-size: 25rpx;
  font-weight: 600;
}

.password-control {
  flex: 0 1 auto;
}

.password-input {
  width: 116rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.password-lock {
  position: relative;
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  opacity: .72;
}

.password-lock::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  box-sizing: border-box;
  width: 20rpx;
  height: 18rpx;
  border: 3rpx solid #66758d;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  transform: translateX(-50%);
}

.password-lock::after {
  content: "";
  position: absolute;
  top: 13rpx;
  left: 50%;
  width: 24rpx;
  height: 16rpx;
  border-radius: 5rpx;
  background: #66758d;
  transform: translateX(-50%);
}

.score-note {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #eef2f8;
  color: #8490a4;
  font-size: 22rpx;
  line-height: 1.7;
}

.score-note-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 29rpx;
  height: 29rpx;
  border: 2rpx solid #94a6c4;
  border-radius: 50%;
  color: #7b91b4;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.create-footer {
  display: block;
  margin-top: 28rpx;
  color: #97a2b4;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin: 28rpx 0 0;
  padding: 22rpx 14rpx;
  border-radius: 22rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.primary-button[disabled] {
  background: #c3d1f4;
  color: #fff;
}

.error-banner {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 17rpx;
  background: #fff0ed;
  color: #c95744;
  font-size: 23rpx;
}

.join-stack {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 22rpx;
}

.join-stack > view,.join-stack > button {
  flex-shrink: 0;
}

.scan-card {
  position: relative;
  padding: 30rpx 24rpx 24rpx;
  border-radius: 32rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(38,76,133,.035);
}

.scan-recommend {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  padding: 5rpx 18rpx;
  border-radius: 99rpx;
  background: #e8f0ff;
  color: #2d5bff;
  font-size: 20rpx;
  font-weight: 700;
}

.scan-illustration {
  position: relative;
  width: 310rpx;
  height: 260rpx;
  margin: 8rpx auto 14rpx;
}

.scan-halo {
  position: absolute;
  top: 0;
  left: 25rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(160deg,#e8f1ff,#f8fbff);
}

.scan-phone {
  position: absolute;
  top: 40rpx;
  left: 83rpx;
  box-sizing: border-box;
  width: 144rpx;
  height: 215rpx;
  border: 9rpx solid #677eaa;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 8rpx 12rpx 24rpx rgba(72,113,188,.15),inset 0 0 0 4rpx #edf3ff;
  transform: rotate(-5deg);
}

.phone-speaker {
  width: 40rpx;
  height: 6rpx;
  margin: 10rpx auto;
  border-radius: 99rpx;
  background: #d8e4f7;
}

.phone-scan {
  display: block;
  width: 74rpx;
  height: 74rpx;
  margin: 32rpx auto 0;
}

.phone-home {
  position: absolute;
  bottom: 12rpx;
  left: 43rpx;
  width: 40rpx;
  height: 5rpx;
  border-radius: 99rpx;
  background: #d8e4f7;
}

.scan-ray {
  position: absolute;
  width: 14rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: #92b5ff;
}

.ray-left { top: 90rpx; left: 38rpx; transform: rotate(-48deg); }
.ray-right { top: 76rpx; right: 35rpx; transform: rotate(45deg); background: #b4d5ff; }

.scan-title,.scan-desc,.scan-help,.join-footer,.sheet-title,.sheet-desc {
  display: block;
}

.scan-title {
  font-size: 37rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.scan-desc {
  margin-top: 8rpx;
  color: #7b879c;
  font-size: 25rpx;
}

.scan-button {
  gap: 18rpx;
  margin-top: 28rpx;
  min-height: 104rpx;
}

.button-scan-icon {
  display: block;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}

.scan-help {
  margin-top: 14rpx;
  color: #8b96a8;
  font-size: 22rpx;
}

.manual-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 106rpx;
  margin: 0;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #34425b;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: left;
}

.manual-arrow { margin-left: auto; color: #8490a4; font-size: 36rpx; font-weight: 400; }
.keyboard-icon {
  display: block;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}

.join-bottom-note {
  margin-top: auto;
  padding: 64rpx 10rpx 0;
  text-align: center;
}
.invite-tip {
  display: block;
  color: #7b879c;
  font-size: 22rpx;
  line-height: 1.7;
}
.join-footer { margin-top: 18rpx; color: #97a2b4; font-size: 21rpx; text-align: center; }
.scan-error { margin-top: 0; }

.manual-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  background: rgba(23,33,57,.4);
}
.manual-sheet {
  position: absolute;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding-top: 18rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
}
.sheet-handle {
  width: 88rpx;
  height: 9rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: #e2e8f1;
}
.sheet-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 36rpx; }
.sheet-title { font-size: 37rpx; font-weight: 800; }
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin: -12rpx -12rpx -12rpx 12rpx;
  padding: 0;
  border-radius: 50%;
  background: #f5f7fa;
  color: #66758d;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
}
.sheet-desc { margin: 12rpx 36rpx 0; color: #7b879c; font-size: 24rpx; }
.manual-fields { box-sizing: border-box; height: 710rpx; }
.sheet-content { padding: 0 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-content .primary-button { margin-top: 34rpx; }

@media (max-width:350px) {
  .entry-art {
    width: 130rpx;
    height: 130rpx;
  }

  .hero-title {
    font-size: 35rpx;
  }

  .hero-desc {
    font-size: 20rpx;
  }

}
