.mahjong-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 52rpx;
  background: radial-gradient(ellipse at 100% 0%,#eaf3ff,transparent 36%),#f5f7fa;
}

.hero {
  position: relative;
  padding: 6rpx 2rpx 18rpx;
  animation: fb-reveal .3s ease-out both;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-brand {
  color: #2d5bff;
  font-size: 24rpx;
  font-weight: 800;
}

.account-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 220rpx;
  padding: 6rpx 14rpx 6rpx 6rpx;
  border-radius: 99rpx;
  background: #fff;
  color: #66758d;
  font-size: 21rpx;
}

.account-link > text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e7efff;
  color: #2d5bff;
  font-weight: 700;
}

.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 166rpx;
}

.hero-content > view:first-child {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 37rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b879c;
  font-size: 21rpx;
}

.entry-art {
  width: 160rpx;
  height: 160rpx;
  margin-right: -8rpx;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 28rpx;
  padding: 7rpx;
  border-radius: 25rpx;
  background: #e9eef6;
}

.mode-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  color: #7b879c;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.mode-tab.active {
  background: #2d5bff;
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(45,91,255,.15);
}

.form-card {
  padding: 30rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(38,76,133,.035);
}

.form-head,.field-row {
  display: flex;
}

.form-head {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-head {
  margin-bottom: 10rpx;
}

.form-title {
  font-size: 33rpx;
  font-weight: 800;
}

.form-badge {
  flex-shrink: 0;
  padding: 5rpx 13rpx;
  border-radius: 99rpx;
  background: #f1f5fc;
  color: #8490a4;
  font-size: 19rpx;
}

.field {
  margin-top: 27rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #34425b;
  font-size: 25rpx;
  font-weight: 700;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 22rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 17rpx;
  background: #fff;
  color: #172139;
  font-size: 28rpx;
}

.code-input {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
}

.field-row {
  gap: 20rpx;
}

.field.half {
  flex: 1;
  min-width: 0;
}

.score-note {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #edf4ff;
  color: #65758f;
  font-size: 22rpx;
  line-height: 1.7;
}

.score-note-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 60rpx;
  border: 2rpx solid #dae5fb;
  border-radius: 9rpx;
  background: #fff;
  color: #2d5bff;
  font-size: 32rpx;
  font-weight: 800;
  transform: rotate(-8deg);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin: 28rpx 0 0;
  padding: 22rpx 14rpx;
  border-radius: 22rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.primary-button[disabled] {
  background: #c3d1f4;
  color: #fff;
}

.error-banner {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 17rpx;
  background: #fff0ed;
  color: #c95744;
  font-size: 23rpx;
}

.join-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.scan-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #fff;
}

.scan-copy {
  flex: 1;
  min-width: 0;
}

.scan-arrow {
  flex-shrink: 0;
  color: #2d5bff;
  font-size: 32rpx;
}

.quick-icon {
  display: block;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
}

.quick-title {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
}

.quick-desc {
  display: block;
  margin-top: 8rpx;
  color: #8490a4;
  font-size: 20rpx;
  line-height: 1.5;
}

@media (max-width:350px) {
  .entry-art {
    width: 130rpx;
    height: 130rpx;
  }

  .hero-title {
    font-size: 35rpx;
  }

  .hero-desc {
    font-size: 20rpx;
  }

}
