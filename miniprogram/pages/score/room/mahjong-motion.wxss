/* Short, finite animations: steady screens do no animation work. */
.motion-toggle { margin: 0 8rpx 0 auto; padding: 10rpx; min-height: 44px; display: flex; align-items: center; background: transparent; color: #7b879c; font-size: 19rpx; line-height: 1.3; }
.primary-button,.secondary-button,.danger-button,.settle-button { transition: transform .12s ease, opacity .12s ease; }
.motion-pressed { transform: scale(.975); opacity: .88; }
.seat-arriving { animation: seat-glow .5s ease-out both; }
.seat-arriving .seat-badge { animation: seat-land .5s cubic-bezier(.2,.75,.3,1.3) both; }
.motion-score-board { position: relative; box-sizing: border-box; padding: 12rpx 22rpx; overflow: visible; }
.motion-score-board .motion-score-row { position: absolute; top: 12rpx; left: 22rpx; right: 22rpx; height: 112rpx; box-sizing: border-box; margin: 0; padding: 20rpx 12rpx; transition: transform .3s cubic-bezier(.2,.7,.25,1); }
.motion-score-row .score-name { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.motion-score-row .score-value { position: relative; z-index: 1; font-variant-numeric: tabular-nums; }
.score-row-flash { position: absolute; inset: 4rpx 0; border-radius: 16rpx; pointer-events: none; animation: score-flash .65s ease-out both; }
.flash-gain { background: #c9f4e6; }
.flash-loss { background: #ffe2da; }
.score-delta { position: absolute; z-index: 4; right: 118rpx; top: 2rpx; font-size: 32rpx; font-weight: 900; pointer-events: none; text-shadow: 0 2rpx 6rpx #fff; }
.delta-gain { color: #2d5bff; animation: gain-rise .65s ease-out both; }
.delta-loss { color: #d56450; animation: loss-fall .6s ease-out both; }
.delta-spark { font-size: 24rpx; color: #e0b75a; margin-left: 8rpx; }
.score-travel { position: absolute; left: 72%; z-index: 5; pointer-events: none; animation: score-flight .62s cubic-bezier(.22,.65,.3,1) both; }
.score-bead { width: 14rpx; height: 19rpx; border: 3rpx solid #fff; border-radius: 5rpx; background: #5680ff; box-shadow: -12rpx 6rpx 0 #bfd0ff,-24rpx 12rpx 0 #e0e9ff; }
.motion-notice { position: fixed; z-index: 42; top: 18rpx; left: 50%; transform: translateX(-50%); box-sizing: border-box; width: max-content; max-width: 90vw; padding: 16rpx 26rpx; border: 2rpx solid #e2ebff; border-radius: 24rpx; background: rgba(255,255,255,.97); color: #2d5bff; box-shadow: 0 10rpx 32rpx rgba(45,91,255,.12); font-size: 24rpx; text-align: center; pointer-events: none; animation: notice-in .2s ease-out both; }
.motion-transfer-copy { display: block; max-width: 80vw; margin-top: 4rpx; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #66758d; }
.motion-stage { position: fixed; z-index: 40; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.motion-stage-card { width: 450rpx; padding: 40rpx 24rpx; border: 2rpx solid #e2ebff; border-radius: 36rpx; background: rgba(248,251,255,.97); box-shadow: 0 20rpx 80rpx rgba(45,91,255,.18); text-align: center; animation: stage-in .7s ease both; }
.start-tiles { display: flex; justify-content: center; gap: 0; padding: 0 0 12rpx; }
.start-tile { width: 108rpx; height: 108rpx; animation: tile-merge .48s cubic-bezier(.2,.7,.3,1.2) both; }
.tile-0 { --tile-x: -90rpx; --tile-y: -60rpx; --tile-rotate: -20deg; }
.tile-1 { --tile-x: -30rpx; --tile-y: 70rpx; --tile-rotate: -10deg; }
.tile-2 { --tile-x: 30rpx; --tile-y: -70rpx; --tile-rotate: 10deg; }
.tile-3 { --tile-x: 90rpx; --tile-y: 60rpx; --tile-rotate: 20deg; }
.motion-stage-title { display: block; font-size: 48rpx; font-weight: 900; color: #172139; }
.motion-stage-copy { display: block; margin-top: 8rpx; color: #66758d; font-size: 24rpx; }
.join-stage-card { animation-duration: .6s; }
.receipt-open { transform-origin: top; animation: receipt-unfold .45s ease-out both; }
.receipt-open .result-row { animation: result-reveal .3s ease-out both; }
.transfers-reveal { animation: result-reveal .3s .5s ease-out both; }
.settlement-sheet { animation: sheet-rise .28s cubic-bezier(.2,.7,.25,1) both; }
.sheet-mask { animation: mask-in .2s ease both; }
.join-preview { animation: result-reveal .3s ease-out both; }
.preview-confirm .field-input { transition: border-color .16s, box-shadow .16s; }
.preview-confirm .field-input:focus { border-color: #2d5bff; box-shadow: 0 0 0 5rpx #edf3ff; }
@keyframes seat-land { 0% { opacity: 0; transform: translateY(-24rpx) rotate(-12deg) scale(.8); } 65% { opacity: 1; transform: translateY(4rpx) rotate(3deg) scale(1.06); } 100% { transform: none; } }
@keyframes seat-glow { 40% { border-color: #7195ff; box-shadow: 0 0 0 6rpx #e3ebff; } }
@keyframes score-flash { 0%,25% { opacity: .7; } 100% { opacity: 0; } }
@keyframes gain-rise { 0% { opacity: 0; transform: translateY(14rpx) scale(.7); } 25% { opacity: 1; transform: translateY(-8rpx) scale(1.05); } 70% { opacity: 1; } 100% { opacity: 0; transform: translateY(-40rpx) scale(1); } }
@keyframes loss-fall { 0% { opacity: 0; transform: translateY(-18rpx); } 25%,65% { opacity: 1; } 100% { opacity: 0; transform: translateY(32rpx); } }
@keyframes score-flight { 0% { opacity: 0; transform: translate(0,0) rotate(-15deg); } 20% { opacity: 1; } 50% { transform: translate(-48rpx,calc(var(--travel-y) * .5)) rotate(12deg); } 85% { opacity: 1; } 100% { opacity: 0; transform: translate(0,var(--travel-y)) rotate(0); } }
@keyframes notice-in { from { opacity: 0; margin-top: -12rpx; } to { opacity: 1; margin-top: 0; } }
@keyframes stage-in { 0% { opacity: 0; transform: scale(.9); } 18%,80% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.03); } }
@keyframes tile-merge { from { opacity: 0; transform: translate(var(--tile-x),var(--tile-y)) rotate(var(--tile-rotate)); } to { opacity: 1; transform: none; } }
@keyframes receipt-unfold { from { opacity: 0; transform: scaleY(.85) translateY(-12rpx); } to { opacity: 1; transform: none; } }
@keyframes result-reveal { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
@keyframes sheet-rise { from { transform: translateY(100%); } to { transform: none; } }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
.motion-reduced .motion-score-row,.motion-reduced button { transition: none; }
.motion-reduced .seat-arriving,.motion-reduced .seat-badge,.motion-reduced .settlement-sheet,.motion-reduced .sheet-mask,.motion-reduced .join-preview,.motion-reduced .motion-notice { animation: none; }
.motion-reduced .motion-pressed { transform: none; }
@media (prefers-reduced-motion: reduce) {
  .room-page view,.room-page text,.room-page button { animation: none !important; transition: none !important; }
  .score-delta,.score-travel,.motion-stage { display: none; }
}
@media (max-width:350px) { .motion-toggle { font-size: 18rpx; padding: 6rpx; } .motion-score-board .motion-score-row { left: 16rpx; right: 16rpx; gap: 8rpx; } }

/* Each animated tile uses baked artwork; never typeset a UI font on a fake face. */
.wind-sprite { position: relative; width: 100%; height: 100%; overflow: hidden; }
.wind-atlas { position: absolute; width: 200%; height: 200%; max-width: none; }
.wind-0 .wind-atlas { left: 0; top: 0; }
.wind-1 .wind-atlas { left: -100%; top: 0; }
.wind-2 .wind-atlas { left: 0; top: -100%; }
.wind-3 .wind-atlas { left: -100%; top: -100%; }
.joined-art { width: 170rpx; height: 170rpx; margin: -16rpx auto 6rpx; animation: seat-land .3s ease-out both; }
