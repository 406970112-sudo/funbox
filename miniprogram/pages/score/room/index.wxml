<view class="room-page">
  <view wx:if="{{loading}}" class="state-panel">
    <view class="loading-tile">±</view>
    <text class="state-title">正在同步牌局</text>
    <text class="state-desc">稍等一下，马上把最新分数带回来。</text>
  </view>

  <view wx:elif="{{joinNeeded && previewRoom}}" class="join-preview">
    <view class="preview-hero">
      <text class="preview-kicker">收到麻将邀请</text>
      <text class="preview-title">{{previewRoom.name}}</text>
      <text class="preview-code">{{previewRoom.code}}</text>
      <view class="preview-rule-row">
        <view><text class="preview-label">人数</text><text class="preview-value">{{previewRoom.maxPlayers}} 人</text></view>
      </view>
    </view>
    <view class="form-card">
      <view class="form-head">
        <text class="form-title">加入牌局</text>
        <text class="form-badge">邀请免密加入</text>
      </view>
      <view class="field">
        <text class="field-label">你的昵称</text>
        <input class="field-input" data-field="joinNickname" maxlength="48" placeholder="牌局内显示的名字" value="{{joinNickname}}" bindinput="handleJoinField" />
      </view>
      <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
      <button class="primary-button" loading="{{joining}}" disabled="{{joining}}" bindtap="joinFromInvite">确认加入</button>
      <button class="secondary-button" bindtap="goHome">返回首页</button>
    </view>
  </view>

  <view wx:elif="{{errorMessage && !room}}" class="state-panel error-state">
    <view class="error-mark">!</view>
    <text class="state-title">无法打开牌局</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button wx:if="{{canRetryLoad}}" class="primary-button compact" bindtap="retryOpenRoom">重新加载</button>
    <button class="{{canRetryLoad ? 'secondary-button' : 'primary-button'}} compact" bindtap="goHome">返回首页</button>
  </view>

  <block wx:elif="{{room}}">
    <view class="room-hero">
      <view class="room-top">
        <view>
          <text class="room-kicker">牌桌 · {{room.code}}</text>
          <text class="room-title">{{room.name}}</text>
        </view>
        <view class="realtime-pill realtime-{{realtimeStatus}}" bindtap="retryRealtime">
          <view class="realtime-dot"></view>
          <text>{{realtimeStatus === 'online' ? '实时同步' : realtimeStatus === 'connecting' ? '连接中' : '离线 · 重连'}}</text>
        </view>
      </view>
      <view class="room-footer">
        <view class="room-metrics">
          <view class="metric"><text class="metric-label">当前人数</text><text class="metric-value">{{activePlayers}} / {{room.maxPlayers}}</text></view>
        </view>
        <text class="room-state state-{{room.status}}">{{room.status === 'waiting' ? '等待开始' : room.status === 'active' ? '牌局进行中' : room.status === 'settled' ? '已结算' : '已取消'}}</text>
      </view>
    </view>

    <view wx:if="{{feedback}}" class="success-banner">{{feedback}}</view>
    <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>

    <view wx:if="{{showAccountBinding && room.status !== 'cancelled'}}" class="account-bind-card {{accountBound ? 'account-bind-complete' : ''}}">
      <view class="account-bind-copy">
        <text class="account-bind-title">{{accountBound ? '本局战绩已关联账号' : '登录后记录本局战绩'}}</text>
        <text class="account-bind-desc">{{accountBound ? '散场结算后，本局会出现在你的个人战绩中。' : '游客也能继续记分；登录后会追溯到当前座位，不影响已有分数。'}}</text>
      </view>
      <button wx:if="{{!accountBound && isLoggedIn}}" class="account-bind-button" loading="{{bindingAccount}}" disabled="{{bindingAccount}}" bindtap="bindParticipantAccount">
        {{bindingAccount ? '绑定中…' : '绑定本局战绩'}}
      </button>
      <button wx:elif="{{!accountBound}}" class="account-bind-button" bindtap="openAccountLogin">登录并绑定</button>
    </view>

    <block wx:if="{{room.status === 'waiting'}}">
      <view wx:if="{{isHost}}" class="invite-card">
        <text class="section-kicker">邀请牌友</text>
        <text class="invite-title">扫码或转发加入</text>
        <text class="invite-desc">邀请链接和二维码已包含入房凭证，填写昵称即可加入。</text>
        <view class="invite-main">
        <view class="invite-copy">
          <view class="room-code-box" bindtap="copyRoomCode">
            <text class="room-code-value">{{room.code}}</text>
            <text class="room-code-copy">复制房间码</text>
          </view>
          <view wx:if="{{hostRoomPassword}}" class="room-password-box">
            <text class="room-password-label">房间密码</text>
            <text class="room-password-value">{{hostRoomPassword}}</text>
          </view>
        </view>
        <view class="qr-box" bindtap="toggleQrExpanded" aria-role="button" aria-label="邀请二维码，点击放大">
          <image wx:if="{{inviteToken && qrImageSrc}}" class="qr-image" src="{{qrImageSrc}}" mode="aspectFit" style="width: {{qrSize}}px; height: {{qrSize}}px;" />
          <canvas wx:elif="{{inviteToken && !qrExpanded}}" canvas-id="roomQr" class="qr-canvas" style="width: {{qrSize}}px; height: {{qrSize}}px;"></canvas>
          <text wx:elif="{{inviteToken && qrExpanded}}" class="qr-placeholder">二维码已放大</text>
          <text wx:else class="qr-placeholder">{{qrCodeLoading ? '生成微信邀请码中…' : '生成邀请中…'}}</text>
          <text wx:if="{{inviteToken}}" class="qr-expand-hint">点击放大</text>
        </view>
        </view>
        <button wx:if="{{isHost && inviteToken}}" class="share-button" open-type="share">发送邀请给牌友</button>
      </view>

      <view class="section-head">
        <text class="section-title">围桌牌友</text>
        <text class="section-meta">{{activePlayers}} / {{room.maxPlayers}} 人</text>
      </view>
      <view class="seat-grid">
        <view wx:for="{{participants}}" wx:key="id" class="player-row seat-card">
          <view class="seat-badge seat-{{item.role}}">{{item.seatMark}}</view>
          <view class="player-copy">
            <text class="player-name">{{item.displayName}}<text wx:if="{{item.isSelf}}" class="self-tag">我</text></text>
            <text class="player-sub">{{item.role === 'host' ? '房主 · 已入座' : '牌友 · 已入座'}}</text>
          </view>
          <text class="player-score">{{item.scoreText}}</text>
        </view>
        <view wx:for="{{vacantSeats}}" wx:key="key" class="player-row seat-card vacant-seat">
          <view class="seat-badge">{{item.mark}}</view>
          <view class="player-copy">
            <text class="player-name">等牌友入座</text>
            <text class="player-sub">位置还热着</text>
          </view>
          <text class="player-score">—</text>
        </view>
      </view>

      <button wx:if="{{isHost}}" class="primary-button" loading="{{busy}}" disabled="{{busy || !canStart}}" bindtap="startRoom">
        {{startLabel}}
      </button>
      <view wx:else class="waiting-note">已加入，等待房主开始牌局。</view>
    </block>

    <block wx:elif="{{room.status === 'active'}}">
      <view class="section-head">
        <text class="section-title">牌桌积分榜</text>
        <text class="section-meta">实时比分</text>
      </view>
      <view class="score-board">
        <view wx:for="{{participants}}" wx:key="id" class="score-row {{item.isSelf ? 'self-row' : ''}}">
          <text class="rank {{item.rankClass}}">{{item.rank}}</text>
          <view class="score-seat">{{item.seatMark}}</view>
          <view class="score-name-block">
            <text class="score-name">{{item.displayName}}<text wx:if="{{item.isSelf}}" class="self-tag">我</text></text>
          </view>
          <text class="score-value {{item.totalPoints >= 0 ? 'positive' : 'negative'}}">{{item.scoreText}}</text>
        </view>
      </view>

      <view class="give-card">
        <view class="section-head compact-head">
          <text class="section-title">这局怎么给</text>
          <text class="section-meta">赢家无需填写</text>
        </view>
        <text class="give-hint">填好这局要给的分，一次交账。</text>
        <view wx:for="{{recipients}}" wx:key="id" class="give-row">
          <view class="give-player">
            <text class="give-name">{{item.displayName}}</text>
            <text class="give-current">当前 {{item.scoreText}} 分</text>
          </view>
          <input class="give-input" data-id="{{item.id}}" type="number" maxlength="10" placeholder="0" value="{{item.pointsInput}}" bindinput="handleGiftInput" />
          <text class="give-unit">分</text>
        </view>
        <view class="give-summary">
          <view>
            <text class="give-total-label">本次给出</text>
            <text class="give-total-value">{{giftTotal}} 分</text>
          </view>
        </view>
        <button class="primary-button" loading="{{busy}}" disabled="{{busy || !canSubmitGifts}}" bindtap="submitGifts">确认给分</button>
      </view>

      <view wx:if="{{giftHistory.length}}" class="history-card">
        <view class="section-head compact-head">
          <text class="section-title">牌桌记事</text>
          <text class="section-meta">最近 {{giftHistory.length}} 笔</text>
        </view>
        <view wx:for="{{giftHistory}}" wx:key="id" class="history-row">
          <view class="history-number">{{item.number}}</view>
          <view class="history-copy">
            <text wx:for="{{item.items}}" wx:key="toParticipantId" class="history-line">{{item.text}}</text>
          </view>
        </view>
      </view>

      <button wx:if="{{isHost && giftHistory.length}}" class="settle-button" bindtap="openSettlement">散场结算</button>
    </block>

    <block wx:elif="{{room.status === 'settled'}}">
      <view class="settled-hero">
        <view class="settled-art art art-score" aria-hidden="true"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" /></view>
        <text class="settled-kicker">这桌，散场了</text>
        <text class="settled-title">输赢已理清</text>
        <text class="settled-subtitle">最终输赢与转账如下</text>
      </view>

      <view class="result-list">
        <view wx:for="{{settlementRows}}" wx:key="participantId" class="result-row">
          <view>
            <text class="result-name">{{item.name}}</text>
            <text class="result-score">{{item.scoreText}} 分</text>
          </view>
          <text class="result-amount {{item.amountCents >= 0 ? 'positive' : 'negative'}}">{{item.amountText}}</text>
        </view>
      </view>

      <view class="transfer-card">
        <text class="section-kicker">转账建议</text>
        <view wx:if="{{!settlementTransfers.length}}" class="no-transfer">本局无需转账</view>
        <view wx:for="{{settlementTransfers}}" wx:key="key" class="transfer-row">
          <text class="transfer-from">{{item.fromName}}</text>
          <text class="transfer-arrow">→</text>
          <text class="transfer-to">{{item.toName}}</text>
          <text class="transfer-amount">{{item.amountText}}</text>
        </view>
      </view>
      <button class="secondary-button" bindtap="goHome">返回首页</button>
    </block>

    <block wx:else>
      <view class="state-panel error-state">
        <view class="error-mark">×</view>
        <text class="state-title">牌局已取消</text>
        <text class="state-desc">本房间没有产生需要结算的账目。</text>
        <button class="primary-button compact" bindtap="goHome">返回首页</button>
      </view>
    </block>
  </block>

  <view wx:if="{{qrExpanded && isHost && inviteToken && room && room.status === 'waiting'}}" class="qr-preview-mask" bindtap="closeQrExpanded" catchtouchmove="noop">
    <view class="qr-preview-card" catchtap="noop">
      <text class="qr-preview-title">邀请二维码</text>
      <view class="qr-preview-stage" bindtap="toggleQrExpanded">
        <image wx:if="{{qrImageSrc}}" class="qr-preview-image" src="{{qrImageSrc}}" mode="aspectFit" style="width: {{qrLargeSize}}px; height: {{qrLargeSize}}px;" />
        <canvas wx:elif="{{inviteToken}}" canvas-id="roomQrLarge" class="qr-preview-image" style="width: {{qrLargeSize}}px; height: {{qrLargeSize}}px;"></canvas>
      </view>
      <text class="qr-preview-hint">再次点击二维码收起</text>
    </view>
  </view>

  <view wx:if="{{settlementOpen && isHost && room && room.status === 'active'}}" class="sheet-mask" bindtap="closeSettlement">
    <view class="settlement-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">确认结算</text>
      <text class="sheet-desc">请核对每名玩家的当前分数与预计金额。</text>
      <view class="field settlement-rate-field">
        <text class="field-label">每分金额</text>
        <view class="settlement-rate-input">
          <text class="settlement-rate-prefix">¥</text>
          <input class="settlement-rate-field-input" type="digit" placeholder="1" value="{{settlementRateInput}}" bindinput="handleSettlementRateInput" />
          <text class="settlement-rate-suffix">元/分</text>
        </view>
        <text wx:if="{{settlementRateError}}" class="settlement-rate-error">{{settlementRateError}}</text>
      </view>
      <view class="settlement-table-head"><text>牌友</text><text>当前分数</text><text>预计金额</text></view>
      <view class="settlement-list">
        <view wx:for="{{settlementRows}}" wx:key="participantId" class="settlement-row">
          <text>{{item.name}}</text>
          <text class="{{item.totalPoints >= 0 ? 'positive' : 'negative'}}">{{item.scoreText}} 分</text>
          <text class="{{item.totalPoints >= 0 ? 'positive' : 'negative'}}">{{item.amountText}}</text>
        </view>
      </view>
      <view class="danger-note">结算后不可修改，请再次确认。</view>
      <button class="danger-button" loading="{{busy}}" disabled="{{busy || !settlementRateValid}}" bindtap="confirmSettlement">确认并结算</button>
      <button class="secondary-button" bindtap="closeSettlement">取消</button>
    </view>
  </view>
</view>
