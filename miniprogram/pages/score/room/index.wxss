.room-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 80rpx;
  background:
    radial-gradient(circle at 88% 2%, rgba(241, 207, 103, 0.14), transparent 28%),
    radial-gradient(circle at 6% 18%, rgba(33, 100, 73, 0.13), transparent 30%),
    #f3efe4;
}

.room-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(246, 216, 118, 0.15), transparent 28%),
    linear-gradient(135deg, #123725 0%, #1e5940 62%, #2b7355 100%);
  box-shadow: 0 20rpx 46rpx rgba(25, 68, 49, 0.17);
  color: #fff8e5;
}

.room-tile-rail {
  position: absolute;
  top: 12rpx;
  right: -10rpx;
  display: flex;
  gap: 7rpx;
  opacity: 0.13;
  transform: rotate(7deg);
}

.room-tile-rail text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 70rpx;
  border: 3rpx solid #fff8e5;
  border-radius: 9rpx;
  color: #fff8e5;
  font-size: 25rpx;
  font-weight: 900;
}

.room-tile-rail .red {
  color: #ffb19c;
}

.room-top,
.room-metrics,
.room-state,
.player-row,
.score-row,
.give-row,
.give-summary,
.history-row,
.result-row,
.transfer-row,
.settlement-row {
  display: flex;
}

.room-top,
.player-row,
.give-row,
.give-summary,
.history-row,
.result-row,
.transfer-row,
.settlement-row {
  align-items: center;
  justify-content: space-between;
}

.room-kicker,
.room-title,
.metric-label,
.metric-value,
.room-state,
.section-kicker,
.invite-title,
.invite-desc,
.room-code-value,
.room-code-copy,
.room-password-label,
.room-password-value,
.section-title,
.section-meta,
.player-name,
.player-sub,
.score-name,
.settled-kicker,
.settled-title,
.settled-subtitle,
.result-name,
.result-score,
.sheet-title,
.sheet-desc,
.settlement-rate-error,
.danger-note,
.state-title,
.state-desc,
.preview-kicker,
.preview-title,
.preview-code,
.preview-label,
.preview-value,
.form-title,
.form-badge,
.field-label,
.give-total-label,
.give-total-value {
  display: block;
}

.room-kicker {
  color: #a9cdb8;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.room-title {
  max-width: 500rpx;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.room-top,
.room-metrics,
.room-state {
  position: relative;
  z-index: 1;
}

.realtime-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #dcecdf;
  font-size: 18rpx;
  font-weight: 700;
}

.realtime-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d3a938;
}

.realtime-online .realtime-dot {
  background: #7de0a2;
}

.realtime-offline .realtime-dot {
  background: #ef8b74;
}

.room-metrics {
  gap: 14rpx;
  margin-top: 28rpx;
}

.metric {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

.metric-label {
  color: #b8d6c6;
  font-size: 18rpx;
}

.metric-value {
  margin-top: 6rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.room-state {
  margin-top: 20rpx;
  color: #e6d06f;
  font-size: 21rpx;
  font-weight: 700;
}

.invite-card,
.form-card,
.history-card,
.transfer-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(36, 73, 55, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(41, 51, 43, 0.05);
}

.invite-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.invite-copy {
  flex: 1;
  min-width: 0;
}

.section-kicker {
  color: #2b7657;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.invite-title {
  margin-top: 8rpx;
  color: #203127;
  font-size: 31rpx;
  font-weight: 900;
}

.invite-desc {
  margin-top: 9rpx;
  color: #7d867f;
  font-size: 20rpx;
  line-height: 1.55;
}

.room-code-box {
  margin-top: 18rpx;
  padding: 15rpx 18rpx;
  border-radius: 15rpx;
  background: #f1ead9;
}

.room-code-value {
  color: #6e551e;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.room-code-copy {
  margin-top: 4rpx;
  color: #8a7b57;
  font-size: 17rpx;
}

.room-password-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 13rpx 18rpx;
  border-radius: 15rpx;
  background: #eef3ec;
}

.room-password-label {
  color: #68766d;
  font-size: 18rpx;
}

.room-password-value {
  color: #1d5f45;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.share-button {
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #1d6b4f;
  color: #fffdf7;
  font-size: 23rpx;
  font-weight: 800;
}

.qr-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 244rpx;
  height: 244rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: inset 0 0 0 1rpx #ebe7dc;
}

.qr-image,
.qr-canvas {
  border-radius: 12rpx;
}

.qr-placeholder {
  color: #8c948d;
  font-size: 20rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 6rpx 14rpx;
}

.compact-head {
  margin: 0 0 12rpx;
}

.section-title {
  color: #1f3027;
  font-size: 30rpx;
  font-weight: 900;
}

.section-meta {
  color: #858e86;
  font-size: 19rpx;
}

.seat-grid,
.score-board,
.result-list {
  overflow: hidden;
  border: 1rpx solid rgba(36, 73, 55, 0.1);
  border-radius: 25rpx;
  background: rgba(255, 253, 247, 0.95);
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  overflow: visible;
  border: 0;
  background: transparent;
}

.player-row,
.score-row,
.result-row {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eceee7;
}

.seat-card {
  min-height: 116rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(32, 86, 62, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 12rpx 28rpx rgba(35, 62, 48, 0.06);
}

.seat-card:last-child {
  border-bottom: 1rpx solid rgba(32, 86, 62, 0.14);
}

.vacant-seat {
  border-style: dashed;
  background: rgba(248, 245, 235, 0.62);
  box-shadow: none;
  opacity: 0.72;
}

.vacant-seat .seat-badge {
  background: #eef0e7;
  color: #879187;
}

.vacant-seat .player-score {
  color: #abb2ac;
  font-weight: 700;
}

.player-row:last-child,
.score-row:last-child,
.result-row:last-child {
  border-bottom: 0;
}

.seat-badge,
.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f7f0dc;
  box-shadow: inset 0 -4rpx 0 #ddd1b7;
  color: #205f46;
  font-size: 22rpx;
  font-weight: 900;
}

.seat-host {
  background: #f2df9d;
  box-shadow: inset 0 -4rpx 0 #d3b957;
  color: #6c5013;
}

.player-copy,
.score-name-block {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.seat-card .player-copy {
  margin-left: 12rpx;
}

.player-name,
.score-name {
  color: #26372d;
  font-size: 26rpx;
  font-weight: 800;
}

.player-sub {
  margin-top: 4rpx;
  color: #89918a;
  font-size: 18rpx;
}

.player-score,
.score-value {
  color: #1e5c43;
  font-size: 27rpx;
  font-weight: 900;
}

.self-tag {
  display: inline-block;
  margin-left: 9rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: #e4efe6;
  color: #247252;
  font-size: 16rpx;
  vertical-align: middle;
}

.score-row {
  gap: 16rpx;
}

.score-board {
  border: 8rpx solid #275a43;
  background: #fbf5e7;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72), 0 16rpx 32rpx rgba(30, 68, 50, 0.08);
}

.rank-1 {
  background: #f3df9f;
  color: #765a12;
}

.rank-2 {
  background: #e5e7e2;
  color: #59645d;
}

.rank-3 {
  background: #ead9c4;
  color: #865d36;
}

.self-row {
  background: #f7faf4;
}

.positive {
  color: #1f7452;
}

.negative {
  color: #b54832;
}

.give-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(36, 73, 55, 0.1);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 247, 0.98), rgba(250, 246, 235, 0.98));
  box-shadow: inset 0 6rpx 0 #2a6c50, 0 14rpx 32rpx rgba(35, 62, 48, 0.05);
}

.give-hint {
  display: block;
  margin-bottom: 12rpx;
  color: #78827a;
  font-size: 20rpx;
  line-height: 1.55;
}

.give-row {
  gap: 14rpx;
  min-height: 82rpx;
  border-bottom: 1rpx solid #eceee7;
}

.give-player {
  flex: 1;
  min-width: 0;
}

.give-name {
  display: block;
  color: #2a3a31;
  font-size: 24rpx;
  font-weight: 800;
}

.give-current {
  display: block;
  margin-top: 3rpx;
  color: #8b938c;
  font-size: 17rpx;
}

.give-input {
  box-sizing: border-box;
  width: 128rpx;
  height: 62rpx;
  padding: 0 12rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 13rpx;
  background: #f8f8f2;
  color: #1c2c22;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.give-unit {
  color: #7d877f;
  font-size: 20rpx;
}

.give-summary {
  margin-top: 18rpx;
  padding: 16rpx 0;
}

.give-total-label {
  color: #818a83;
  font-size: 18rpx;
}

.give-total-value {
  margin-top: 3rpx;
  color: #1b6c4e;
  font-size: 28rpx;
  font-weight: 900;
}

.history-card {
  margin-top: 20rpx;
}

.history-row {
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eceee7;
}

.history-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 9rpx;
  background: #f7f0dc;
  box-shadow: inset 0 -3rpx 0 #ddd1b7;
  color: #28684e;
  font-size: 18rpx;
  font-weight: 800;
}

.history-copy {
  flex: 1;
}

.history-line {
  display: block;
  margin-bottom: 5rpx;
  color: #5e6a62;
  font-size: 21rpx;
  line-height: 1.5;
}

.primary-button,
.secondary-button,
.settle-button,
.danger-button {
  margin-top: 24rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.primary-button {
  background: #1d6b4f;
  color: #fffdf7;
}

.primary-button[disabled] {
  background: #819d8f;
  color: #f7f5ee;
}

.secondary-button {
  background: #ecefe7;
  color: #4f5f55;
}

.settle-button {
  background: linear-gradient(135deg, #9f3829, #bd533b);
  color: #fff8e5;
  box-shadow: 0 12rpx 24rpx rgba(159, 56, 41, 0.18);
}

.danger-button {
  background: #b4472f;
  color: #fff8f3;
}

.compact {
  width: 300rpx;
  margin-top: 28rpx;
}

.waiting-note,
.success-banner,
.error-banner {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.waiting-note {
  background: #eaf2ea;
  color: #35634d;
  text-align: center;
}

.success-banner {
  background: #e8f3e9;
  color: #276a4d;
}

.error-banner {
  background: #fff0eb;
  color: #ad4933;
}

.account-bind-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(29, 107, 79, 0.16);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef5ed, #fffaf0);
}

.account-bind-complete {
  background: #edf4ee;
}

.account-bind-copy {
  flex: 1;
}

.account-bind-title,
.account-bind-desc {
  display: block;
}

.account-bind-title {
  color: #214d39;
  font-size: 23rpx;
  font-weight: 900;
}

.account-bind-desc {
  margin-top: 6rpx;
  color: #627168;
  font-size: 19rpx;
  line-height: 1.5;
}

.account-bind-button {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #1d6b4f;
  color: #fffdf7;
  font-size: 20rpx;
  font-weight: 800;
}

.account-bind-button[disabled] {
  background: #819d8f;
  color: #f7f5ee;
}

.state-panel {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 70vh;
  padding: 40rpx;
  text-align: center;
}

.loading-tile,
.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 132rpx;
  border: 4rpx solid #fff;
  border-radius: 18rpx;
  background: #246548;
  box-shadow: 0 16rpx 30rpx rgba(31, 82, 59, 0.2);
  color: #f8efd8;
  font-size: 44rpx;
  font-weight: 900;
}

.error-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #fff0eb;
  color: #b4472f;
}

.state-title {
  margin-top: 24rpx;
  color: #1f3027;
  font-size: 32rpx;
  font-weight: 900;
}

.state-desc {
  max-width: 560rpx;
  margin-top: 10rpx;
  color: #7c867e;
  font-size: 23rpx;
  line-height: 1.65;
}

.join-preview {
  padding-top: 10rpx;
}

.preview-hero {
  padding: 34rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #173f2e, #2c7355);
  color: #fff8e5;
  box-shadow: 0 20rpx 46rpx rgba(25, 68, 49, 0.17);
}

.preview-kicker {
  color: #a9cdb8;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.preview-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.preview-code {
  margin-top: 14rpx;
  color: #f0d36c;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}

.preview-rule-row {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.preview-rule-row > view {
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
}

.preview-label {
  color: #b6d1c2;
  font-size: 18rpx;
}

.preview-value {
  margin-top: 5rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.form-card {
  margin-top: 20rpx;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-title {
  color: #1f3027;
  font-size: 31rpx;
  font-weight: 900;
}

.form-badge {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #e7f0e7;
  color: #2a6f51;
  font-size: 18rpx;
  font-weight: 700;
}

.field {
  margin-top: 20rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #4c5a50;
  font-size: 22rpx;
  font-weight: 700;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 17rpx;
  background: #fbfaf5;
  color: #1b2b22;
  font-size: 27rpx;
}

.settled-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 80% 10%, rgba(240, 211, 108, 0.18), transparent 30%),
    linear-gradient(135deg, #163528, #315c48);
  color: #fff8e5;
  text-align: center;
}

.settled-tiles {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 22rpx;
  transform: rotate(-4deg);
}

.settled-tiles text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 64rpx;
  border: 3rpx solid #fff7e0;
  border-radius: 9rpx;
  background: #f7efdb;
  box-shadow: 0 7rpx 12rpx rgba(7, 24, 16, 0.2);
  color: #1c5e43;
  font-size: 25rpx;
  font-weight: 900;
}

.settled-tiles .red {
  color: #b64231;
}

.settled-kicker {
  color: #bdd5c5;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.settled-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.settled-subtitle {
  margin-top: 10rpx;
  color: #c5d9cd;
  font-size: 21rpx;
}

.result-list {
  margin-top: 20rpx;
}

.result-row {
  gap: 20rpx;
}

.result-name {
  color: #27382e;
  font-size: 25rpx;
  font-weight: 800;
}

.result-score {
  margin-top: 4rpx;
  color: #8a938b;
  font-size: 18rpx;
}

.result-amount {
  font-size: 28rpx;
  font-weight: 900;
}

.transfer-card {
  margin-top: 20rpx;
}

.transfer-row {
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eceee7;
  font-size: 22rpx;
}

.transfer-from,
.transfer-to {
  color: #405149;
  font-weight: 800;
}

.transfer-arrow {
  color: #8d968f;
}

.transfer-amount {
  margin-left: auto;
  color: #1d6b4f;
  font-weight: 900;
}

.no-transfer {
  padding: 28rpx 0;
  color: #7d867f;
  font-size: 23rpx;
  text-align: center;
}

.qr-preview-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx;
  background: rgba(11, 22, 16, 0.72);
}

.qr-preview-card {
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx;
  background: #fffdf7;
  box-shadow: 0 26rpx 70rpx rgba(8, 18, 12, 0.34);
  text-align: center;
}

.qr-preview-title {
  display: block;
  color: #203127;
  font-size: 30rpx;
  font-weight: 900;
}

.qr-preview-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.qr-preview-image {
  display: block;
  border-radius: 20rpx;
  background: #fff;
}

.qr-preview-hint {
  display: block;
  margin-top: 18rpx;
  color: #78827a;
  font-size: 21rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 27, 21, 0.48);
}

.settlement-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #fffdf7;
}

.sheet-handle {
  width: 70rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #d9ddd5;
}

.sheet-title {
  color: #203127;
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-desc {
  margin-top: 8rpx;
  color: #7a847c;
  font-size: 21rpx;
}

.settlement-rate-field {
  margin-top: 18rpx;
}

.settlement-rate-input {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 17rpx;
  background: #fbfaf5;
}

.settlement-rate-prefix,
.settlement-rate-suffix {
  flex-shrink: 0;
  color: #78827b;
  font-size: 22rpx;
  font-weight: 700;
}

.settlement-rate-field-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 10rpx;
  color: #1b2b22;
  font-size: 28rpx;
  font-weight: 800;
}

.settlement-rate-error {
  margin-top: 8rpx;
  color: #b4472f;
  font-size: 19rpx;
}

.settlement-list {
  margin-top: 14rpx;
}

.settlement-row {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eceee7;
  color: #4d5b52;
  font-size: 22rpx;
}

.danger-note {
  margin-top: 18rpx;
  color: #b4472f;
  font-size: 21rpx;
  font-weight: 700;
}
