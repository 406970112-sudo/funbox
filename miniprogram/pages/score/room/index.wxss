.room-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.room-hero {
  padding: 28rpx;
  border-radius: 30rpx;
  background: #fff;
}

.room-top,.room-footer,.room-metrics,.metric,.realtime-pill,.player-row,.score-row,.give-row,.give-summary,.history-row,.result-row,.transfer-row,.settlement-row,.settlement-table-head {
  display: flex;
}

.room-top,.room-footer,.metric,.player-row,.give-row,.give-summary,.history-row,.result-row,.transfer-row {
  align-items: center;
  justify-content: space-between;
}

.room-top {
  gap: 18rpx;
}

.room-top > view:first-child {
  flex: 1;
  min-width: 0;
}

.room-kicker,.room-title,.metric-label,.metric-value,.section-kicker,.invite-title,.invite-desc,.room-code-value,.room-code-copy,.room-password-label,.room-password-value,.section-title,.section-meta,.player-name,.player-sub,.score-name,.settled-kicker,.settled-title,.settled-subtitle,.result-name,.result-score,.sheet-title,.sheet-desc,.settlement-rate-error,.danger-note,.state-title,.state-desc,.preview-kicker,.preview-title,.preview-code,.preview-label,.preview-value,.form-title,.form-badge,.field-label,.give-total-label,.give-total-value {
  display: block;
}

.room-kicker {
  color: #8490a4;
  font-size: 22rpx;
}

.room-title {
  margin-top: 7rpx;
  overflow-wrap: break-word;
  font-size: 35rpx;
  font-weight: 800;
  line-height: 1.4;
}

.realtime-pill {
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 0;
  color: #8490a4;
  font-size: 20rpx;
}

.realtime-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #7d9cff;
}

.realtime-online .realtime-dot {
  background: #43c893;
}

.realtime-offline .realtime-dot {
  background: #ff765e;
}

.room-footer {
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.metric {
  gap: 12rpx;
}

.metric-label {
  color: #8490a4;
  font-size: 21rpx;
}

.metric-value {
  font-size: 27rpx;
  font-weight: 700;
}

.room-state {
  padding: 6rpx 16rpx;
  border-radius: 99rpx;
  background: #edf3ff;
  color: #2d5bff;
  font-size: 20rpx;
  font-weight: 700;
}

.state-active {
  background: #e0f6ee;
  color: #278461;
}

.state-cancelled {
  background: #fff0ed;
  color: #c95744;
}

.invite-card,.form-card,.history-card,.transfer-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #fff;
}

.section-kicker {
  color: #66758d;
  font-size: 23rpx;
  font-weight: 700;
}

.invite-title {
  margin-top: 8rpx;
  font-size: 35rpx;
  font-weight: 800;
}

.invite-desc {
  margin-top: 10rpx;
  color: #8490a4;
  font-size: 22rpx;
  line-height: 1.7;
}

.invite-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
}

.invite-copy {
  flex: 1;
  min-width: 0;
}

.room-code-box {
  padding: 16rpx;
  border-radius: 18rpx;
  background: #edf4ff;
}

.room-code-value {
  color: #2d5bff;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.room-code-copy {
  margin-top: 8rpx;
  color: #2d5bff;
  font-size: 20rpx;
}

.room-password-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 15rpx;
}

.room-password-label {
  color: #8490a4;
  font-size: 21rpx;
}

.room-password-value {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.share-button {
  width: 100%;
  margin: 26rpx 0 0;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
}

.qr-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112px;
  min-height: 112px;
  padding: 5px;
  border: 1rpx solid #edf1f8;
  border-radius: 18rpx;
  background: #fff;
}

.qr-image,.qr-canvas {
  display: block;
  border-radius: 8rpx;
}

.qr-placeholder {
  color: #8490a4;
  font-size: 21rpx;
  text-align: center;
}

.qr-expand-hint {
  margin-top: 8rpx;
  color: #7b879c;
  font-size: 19rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 28rpx 4rpx 16rpx;
}

.compact-head {
  margin: 0 0 12rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 800;
}

.section-meta {
  color: #8490a4;
  font-size: 21rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.general-room .seat-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.general-room .seat-card {
  min-height: 112rpx;
  flex-wrap: nowrap;
}

.general-room .player-score {
  flex: 0 0 auto;
  width: auto;
  min-width: 64rpx;
  margin-top: 0;
  text-align: right;
}

.general-room .seat-badge,.general-room .score-seat {
  border-radius: 50%;
}

.general-room .settlement-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.general-room .settlement-list {
  height: 26vh;
  flex-shrink: 1;
  min-height: 80rpx;
}

.general-room .settlement-sheet > view:not(.settlement-list),
.general-room .settlement-sheet > text,
.general-room .settlement-sheet > button {
  flex-shrink: 0;
}

.seat-card {
  box-sizing: border-box;
  flex-wrap: wrap;
  align-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 188rpx;
  padding: 22rpx 18rpx;
  border: 2rpx solid #e8eefb;
  border-radius: 24rpx;
  background: #fff;
}

.vacant-seat {
  border-style: dashed;
  background: #f9fbff;
  color: #8490a4;
}

.seat-badge,.score-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e9f0ff;
  color: #2d5bff;
  font-size: 25rpx;
  font-weight: 800;
}

.seat-host {
  background: #dce9ff;
}

.player-copy,.score-name-block {
  flex: 1;
  min-width: 0;
}

.player-name,.score-name {
  overflow-wrap: break-word;
  font-size: 26rpx;
  font-weight: 800;
}

.player-sub {
  margin-top: 6rpx;
  color: #8490a4;
  font-size: 19rpx;
}

.player-score {
  width: 100%;
  margin-top: 5rpx;
  font-size: 33rpx;
  font-weight: 800;
  text-align: center;
}

.self-tag {
  display: inline-block;
  padding: 1rpx 7rpx;
  margin-left: 8rpx;
  border-radius: 7rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 17rpx;
  font-weight: 500;
  vertical-align: middle;
}

.score-board {
  padding: 10rpx 18rpx;
  border-radius: 28rpx;
  background: #fff;
}

.score-row {
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 12rpx;
  border-bottom: 1rpx solid #edf1f8;
}

.score-row:last-child {
  border-bottom: 0;
}

.rank {
  flex-shrink: 0;
  width: 22rpx;
  color: #8490a4;
  font-size: 23rpx;
  text-align: center;
}

.score-seat {
  width: 48rpx;
  height: 48rpx;
  font-size: 23rpx;
}

.self-row {
  border-radius: 18rpx;
  background: #edf4ff;
}

.score-value {
  flex-shrink: 0;
  max-width: 48%;
  overflow-wrap: anywhere;
  font-size: 35rpx;
  font-weight: 800;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.positive {
  color: #2d5bff;
}

.negative {
  color: #c74d38;
}

.give-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #fff;
}

.give-hint {
  display: block;
  margin-bottom: 8rpx;
  color: #8490a4;
  font-size: 22rpx;
}

.give-row {
  gap: 16rpx;
  padding: 18rpx 0;
}

.give-player {
  flex: 1;
  min-width: 0;
}

.give-name {
  display: block;
  overflow-wrap: break-word;
  font-size: 27rpx;
  font-weight: 700;
}

.give-current {
  display: block;
  margin-top: 5rpx;
  color: #8490a4;
  font-size: 21rpx;
}

.give-input {
  box-sizing: border-box;
  flex-shrink: 0;
  width: 156rpx;
  height: 76rpx;
  min-height: 40px;
  padding: 0 20rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 15rpx;
  background: #fff;
  color: #172139;
  font-size: 29rpx;
}

.give-unit {
  flex-shrink: 0;
  color: #7b879c;
  font-size: 23rpx;
}

.give-summary {
  justify-content: flex-start;
  margin-top: 9rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f8;
}

.give-summary > view {
  display: flex;
  align-items: baseline;
  gap: 15rpx;
  flex-wrap: wrap;
}

.give-total-label {
  font-size: 24rpx;
}

.give-total-value {
  overflow-wrap: anywhere;
  color: #2d5bff;
  font-size: 37rpx;
  font-weight: 900;
}

.history-row {
  align-items: flex-start;
  justify-content: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
}

.history-row + .history-row {
  border-top: 1rpx solid #edf1f8;
}

.history-number {
  flex-shrink: 0;
  width: 30rpx;
  color: #8490a4;
  font-size: 22rpx;
}

.history-copy {
  flex: 1;
  min-width: 0;
}

.history-line {
  display: block;
  overflow-wrap: break-word;
  font-size: 23rpx;
  line-height: 1.7;
}

.primary-button,.secondary-button,.settle-button,.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
  margin: 24rpx 0 0;
  padding: 20rpx 12rpx;
  border-radius: 21rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.primary-button {
  background: #2d5bff;
  color: #fff;
}

.primary-button[disabled],.danger-button[disabled] {
  background: #d8e1f4;
  color: #fff;
}

.secondary-button {
  border: 2rpx solid #cbd9ff;
  background: #fff;
  color: #34425b;
}

.settle-button {
  border: 2rpx solid #ff765e;
  background: transparent;
  color: #c74d38;
}

.danger-button {
  background: #c74d38;
  color: #fff;
}

.compact {
  width: 100%;
  max-width: 420rpx;
}

.waiting-note,.success-banner,.error-banner {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.7;
}

.waiting-note {
  background: #e9f1ff;
  color: #66758d;
  text-align: center;
}

.success-banner {
  background: #e4f7ef;
  color: #278461;
}

.error-banner {
  background: #fff0ed;
  color: #c95744;
}

.account-bind-card {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #e9f1ff;
}

.account-bind-copy {
  flex: 1;
  min-width: 200rpx;
}

.account-bind-title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
}

.account-bind-desc {
  display: block;
  margin-top: 5rpx;
  color: #7b879c;
  font-size: 20rpx;
  line-height: 1.6;
}

.account-bind-button {
  flex-shrink: 0;
  margin: 0;
  padding: 15rpx 18rpx;
  border: 2rpx solid #2d5bff;
  border-radius: 16rpx;
  background: #fff;
  color: #2d5bff;
  font-size: 23rpx;
  line-height: 1.5;
}

.account-bind-button[disabled] {
  color: #8490a4;
  border-color: #cbd6eb;
}

.state-panel {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 65vh;
  padding: 28rpx;
  text-align: center;
}

.loading-tile,.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: #e7efff;
  color: #2d5bff;
  font-size: 57rpx;
  font-weight: 800;
}

.loading-tile {
  animation: room-pulse 1.2s ease-in-out infinite;
}

@keyframes room-pulse {
  50% {
    opacity: .45;
    transform: translateY(-8rpx);
  }


}

.error-mark {
  background: #fff0ed;
  color: #c74d38;
}

.state-title {
  margin-top: 25rpx;
  font-size: 35rpx;
  font-weight: 800;
}

.state-desc {
  max-width: 580rpx;
  margin-top: 12rpx;
  color: #8490a4;
  font-size: 25rpx;
  line-height: 1.8;
  overflow-wrap: break-word;
}

.join-preview { padding: 28rpx 4rpx 0; }
.preview-welcome { text-align: center; }
.preview-invite-icon {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #e8f0ff;
}
.preview-invite-icon > view {
  position: absolute;
  top: 53rpx;
  left: 26rpx;
  width: 34rpx;
  height: 25rpx;
  border-radius: 16rpx 16rpx 8rpx 8rpx;
  background: #2d5bff;
}
.preview-invite-icon > view::before {
  content: "";
  position: absolute;
  top: -26rpx;
  left: 6rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: inherit;
}
.preview-invite-icon > view:last-child { top: 56rpx; left: 61rpx; width: 25rpx; height: 22rpx; background: #7298ff; }
.preview-invite-icon > view:last-child::before { top: -22rpx; left: 3rpx; width: 18rpx; height: 18rpx; }
.preview-kicker { color: #7b879c; font-size: 25rpx; }
.preview-headline { display: block; margin-top: 16rpx; font-size: 43rpx; font-weight: 800; letter-spacing: -1rpx; }
.preview-room-card { margin-top: 38rpx; padding: 28rpx 24rpx 24rpx; border-radius: 30rpx; background: #fff; }
.preview-room-info { display: flex; align-items: center; gap: 20rpx; }
.preview-art { width: 220rpx; height: 180rpx; }
.preview-room-copy { flex: 1; min-width: 0; }
.preview-title { font-size: 37rpx; font-weight: 800; overflow-wrap: break-word; line-height: 1.4; }
.preview-room-meta { display: block; margin-top: 8rpx; color: #7b879c; font-size: 23rpx; }
.preview-status { display: inline-block; margin-top: 12rpx; padding: 5rpx 18rpx; border-radius: 99rpx; background: #e7f6ef; color: #278461; font-size: 21rpx; }
.preview-verified { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 22rpx; padding: 18rpx 10rpx; border-radius: 14rpx; background: #edf4ff; color: #2d5bff; font-size: 22rpx; }
.verified-check { font-size: 28rpx; font-weight: 800; line-height: 1; }
.preview-confirm { margin-top: 42rpx; }
.preview-name-label { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 800; }
.preview-name-help { display: block; margin-top: 14rpx; color: #8b96a8; font-size: 22rpx; }
.preview-confirm .primary-button { margin-top: 48rpx; }
.preview-confirm-help { display: block; margin-top: 16rpx; color: #8b96a8; font-size: 22rpx; text-align: center; }
.preview-footer { display: block; margin: 66rpx 0 16rpx; color: #97a2b4; font-size: 21rpx; text-align: center; }
.preview-home { margin: 0 auto; padding: 18rpx; background: transparent; color: #8490a4; font-size: 23rpx; line-height: 1.5; }

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 800;
}

.form-badge {
  padding: 5rpx 12rpx;
  border-radius: 99rpx;
  background: #e7f6ef;
  color: #278461;
  font-size: 20rpx;
}

.field {
  margin-top: 26rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 22rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 17rpx;
  background: #fff;
  color: #172139;
  font-size: 28rpx;
}

.settled-hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 10rpx 20rpx 30rpx;
  text-align: center;
}

.settled-art {
  width: 200rpx;
  height: 200rpx;
}

.settled-kicker {
  color: #8490a4;
  font-size: 21rpx;
}

.settled-title {
  margin-top: 7rpx;
  font-size: 43rpx;
  font-weight: 900;
}

.settled-subtitle {
  margin-top: 10rpx;
  color: #7b879c;
  font-size: 24rpx;
}

.result-list {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.result-row {
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1f8;
}

.result-row:last-child {
  border-bottom: 0;
}

.result-row > view {
  flex: 1;
  min-width: 0;
}

.result-name {
  overflow-wrap: break-word;
  font-size: 28rpx;
  font-weight: 800;
}

.result-score {
  margin-top: 5rpx;
  color: #8490a4;
  font-size: 22rpx;
}

.result-amount {
  max-width: 53%;
  overflow-wrap: anywhere;
  font-size: 32rpx;
  font-weight: 800;
  text-align: right;
}

.transfer-card .section-kicker {
  color: #172139;
  font-size: 30rpx;
  font-weight: 800;
}

.transfer-row {
  gap: 14rpx;
  padding: 23rpx 0;
  border-bottom: 1rpx solid #edf1f8;
}

.transfer-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.transfer-from,.transfer-to {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  font-size: 25rpx;
  font-weight: 700;
}

.transfer-arrow {
  flex-shrink: 0;
  color: #a1aec4;
  font-size: 30rpx;
}

.transfer-amount {
  max-width: 37%;
  overflow-wrap: anywhere;
  color: #2d5bff;
  font-size: 27rpx;
  font-weight: 800;
  text-align: right;
}

.no-transfer {
  padding-top: 22rpx;
  color: #8490a4;
  font-size: 24rpx;
}

.qr-preview-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 28rpx;
  background: rgba(23,33,57,.64);
}

.qr-preview-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  overflow-y: auto;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  text-align: center;
}

.qr-preview-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
}

.qr-preview-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.qr-preview-image {
  display: block;
  max-width: calc(100vw - 116rpx);
  max-height: calc(100vw - 116rpx);
  border-radius: 12rpx;
  background: #fff;
}

.qr-preview-hint {
  display: block;
  margin-top: 20rpx;
  color: #8490a4;
  font-size: 23rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(23,33,57,.4);
}

.settlement-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 20rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 30rpx;
  border-radius: 99rpx;
  background: #d8dfeb;
}

.sheet-title {
  font-size: 37rpx;
  font-weight: 900;
}

.sheet-desc {
  margin-top: 9rpx;
  color: #8490a4;
  font-size: 23rpx;
}

.settlement-rate-field {
  margin-top: 27rpx;
}

.settlement-rate-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 46px;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 17rpx;
}

.settlement-rate-prefix {
  color: #8490a4;
  font-size: 28rpx;
}

.settlement-rate-suffix {
  flex-shrink: 0;
  color: #66758d;
  font-size: 25rpx;
}

.settlement-rate-field-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #172139;
  font-size: 31rpx;
  font-weight: 700;
}

.settlement-rate-error {
  margin-top: 10rpx;
  color: #c74d38;
  font-size: 22rpx;
}

.settlement-table-head,.settlement-row {
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 8rpx;
}

.settlement-table-head {
  margin-top: 25rpx;
  border-radius: 14rpx;
  background: #f4f7fc;
  color: #8490a4;
  font-size: 22rpx;
}

.settlement-row {
  border-bottom: 1rpx solid #edf1f8;
  font-size: 25rpx;
  font-weight: 700;
}

.settlement-table-head > text,.settlement-row > text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}

.settlement-table-head > text:first-child,.settlement-row > text:first-child {
  text-align: left;
}

.danger-note {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff0ed;
  color: #c74d38;
  font-size: 22rpx;
  text-align: center;
}

.settlement-sheet .danger-button {
  margin-top: 16rpx;
}

.settlement-sheet .secondary-button {
  margin-top: 14rpx;
}

@media (max-width:350px) {
  .room-code-value {
    font-size: 40rpx;
    letter-spacing: 0;
  }

  .invite-main {
    gap: 16rpx;
  }

  .room-password-box {
    gap: 5rpx;
  }

  .room-password-label {
    font-size: 20rpx;
  }

  .score-row {
    gap: 10rpx;
  }

  .give-input {
    width: 140rpx;
  }

  .realtime-pill {
    font-size: 19rpx;
  }


}
