<view class="home-page">
  <view class="home-hero">
    <view class="topbar">
      <view><text class="fb-brand">FunBox</text><text class="brand-caption">棋牌记分</text></view>
      <view class="account-pill" bindtap="openProfile"><text class="account-dot">{{isLoggedIn ? '已' : '游'}}</text><text class="account-name">{{userName}}</text><text class="account-arrow">›</text></view>
    </view>
    <view class="hero-content">
      <view class="hero-copy"><text class="headline">好友相聚，</text><text class="headline">每局<text class="headline-accent">都算数。</text></text></view>
      <view class="hero-art art"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
    </view>
  </view>
  <view class="section-head"><text class="section-title">选择牌局</text><text class="section-note">不同玩法，一样清楚</text></view>
  <view class="scene-grid">
    <view class="scene-card mahjong-card" bindtap="openMahjong">
      <view class="scene-copy"><text class="scene-title">麻将记分</text><text class="scene-desc">4 人牌局 · 给分与结算</text></view>
      <view class="scene-art art art-mahjong"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
    </view>
    <view class="scene-card poker-card" bindtap="openPoker">
      <view class="scene-copy"><text class="scene-title">炸金花</text><text class="scene-desc">轮流加注，实时看池</text></view>
      <view class="scene-art art art-poker"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
    </view>
    <view class="scene-card general-card" bindtap="openGeneral">
      <view class="scene-copy"><text class="scene-title">通用记分</text><text class="scene-desc">灵活人数 · 给分与结算</text></view>
      <image class="scene-art general-art" src="/assets/illustrations/general-score.png" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>
  <view wx:if="{{showWebsiteEntry}}" class="website-card" bindtap="copyWebsite" role="button" aria-label="更多功能，复制 xwhub.cn 网址">
    <image class="website-logo" src="/assets/icons/funbox-logo.png" mode="aspectFit" aria-hidden="true" />
    <view class="website-copy">
      <text class="website-title">更多功能</text>
      <text class="website-address">访问 xwhub.cn</text>
    </view>
    <button class="website-button" catchtap="copyWebsite" disabled="{{copyingWebsite}}">{{copyingWebsite ? '复制中' : '复制网址'}}</button>
  </view>
</view>
<view wx:if="{{showWebsiteDialog}}" class="website-mask" catchtouchmove="noop">
  <view class="website-dialog" role="dialog" aria-label="网址已复制，请打开浏览器粘贴访问" catchtap="noop">
    <view class="website-success" aria-hidden="true"><view class="website-check" /></view>
    <text class="website-dialog-title">网址已复制</text>
    <text class="website-dialog-hint">请打开浏览器，粘贴网址访问</text>
    <text class="website-dialog-url" selectable>{{websiteUrl}}</text>
    <button class="website-confirm" bindtap="closeWebsiteDialog">我知道了</button>
  </view>
</view>
