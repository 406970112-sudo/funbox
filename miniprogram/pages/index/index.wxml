<import src="/templates/discover-entry.wxml" />
<view class="home-page {{reduceMotion ? 'motion-reduced' : ''}}">
  <view class="home-hero">
    <view class="topbar">
      <view><text class="fb-brand">FunBox</text><text class="brand-caption">棋牌记分</text></view>
      <view class="account-pill" bindtap="openProfile" hover-class="fb-tap-btn" hover-start-time="0" hover-stay-time="100"><text class="account-dot">{{isLoggedIn ? '已' : '游'}}</text><text class="account-name">{{userName}}</text><text class="account-arrow">›</text></view>
    </view>
    <view class="hero-content">
      <view class="hero-copy"><text class="headline">好友相聚，</text><text class="headline">每局<text class="headline-accent">都算数。</text></text></view>
      <view class="hero-art art"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
    </view>
  </view>
  <view wx:if="{{recentRoom}}" class="resume-card fb-card">
    <view class="resume-copy"><text class="resume-title">继续「{{recentRoom.name}}」</text><text class="scene-desc">{{resumeState === 'checking' ? '正在确认牌局状态…' : resumeState === 'retry' ? '状态待确认，请重试' : recentRoom.status === 'active' ? '进行中' : '等待开始'}}</text></view>
    <button class="resume-button" hover-class="fb-tap-btn" loading="{{resumeBusy}}" disabled="{{resumeBusy}}" bindtap="resumeRoom">{{resumeState === 'retry' ? '重试并继续' : '继续牌局'}}</button>
  </view>
  <view wx:if="{{resumeError}}" class="resume-card resume-error" role="alert">{{resumeError}}</view>
  <view class="section-head"><text class="section-title">选择牌局</text><text class="section-note">不同玩法，一样清楚</text></view>
  <view class="scene-grid">
    <view class="scene-entrance">
      <view class="scene-card mahjong-card" bindtap="openMahjong" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
        <view class="scene-copy"><text class="scene-title">麻将记分</text><text class="scene-desc">4 人牌局 · 给分与结算</text></view>
        <view class="scene-art home-card-art art art-mahjong"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
      </view>
    </view>
    <view class="scene-entrance">
      <view class="scene-card poker-card" bindtap="openPoker" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
        <view class="scene-copy"><text class="scene-title">炸金花</text><text class="scene-desc">轮流加注，实时看池</text></view>
        <view class="scene-art home-card-art art art-poker"><image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" /></view>
      </view>
    </view>
    <view class="scene-entrance">
      <view class="scene-card general-card" bindtap="openGeneral" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
        <view class="scene-copy"><text class="scene-title">通用记分</text><text class="scene-desc">灵活人数 · 给分与结算</text></view>
        <image class="scene-art home-card-art general-art" src="/assets/illustrations/general-score.png" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
  </view>
  <view class="section-head discover-heading" bindtap="openDiscover" role="button" aria-label="发现更多，查看全部入口">
    <text class="section-title">发现更多</text>
    <view class="discover-more"><text>查看全部</text><text class="discover-more-arrow" aria-hidden="true">›</text></view>
  </view>
  <swiper class="discover-swiper" display-multiple-items="{{2}}" current="{{discoverSlide}}" bindchange="onDiscoverSlideChange" duration="{{reduceMotion ? 0 : 260}}" aria-label="发现更多入口，左右滑动切换">
    <swiper-item class="discover-slide"><template is="discover-notebook" /></swiper-item>
    <swiper-item class="discover-slide"><template is="discover-memes" /></swiper-item>
    <swiper-item class="discover-slide"><template is="discover-holidays" data="{{card: holidayCard}}" /></swiper-item>
  </swiper>
  <view class="discover-pages" aria-label="切换发现卡片">
    <view class="discover-page-dot {{discoverSlide === 0 ? 'discover-page-active' : ''}}" bindtap="selectDiscoverSlide" data-index="0" role="button" aria-label="第 1 屏，笔记本和表情包" aria-pressed="{{discoverSlide === 0}}"><view class="discover-dot" /></view>
    <view class="discover-page-dot {{discoverSlide === 1 ? 'discover-page-active' : ''}}" bindtap="selectDiscoverSlide" data-index="1" role="button" aria-label="第 2 屏，表情包和节假日倒计时" aria-pressed="{{discoverSlide === 1}}"><view class="discover-dot" /></view>
  </view>
  <view wx:if="{{showWebsiteEntry}}" class="website-card" bindtap="copyWebsite" hover-class="fb-tap-card" hover-start-time="0" hover-stay-time="100" role="button" aria-label="更多功能，复制 xwhub.cn 网址">
    <image class="website-logo" src="/assets/icons/funbox-logo.png" mode="aspectFit" aria-hidden="true" />
    <view class="website-copy">
      <text class="website-title">更多功能</text>
      <text class="website-address">访问 xwhub.cn</text>
    </view>
    <button class="website-button" hover-class="fb-tap-btn" catchtap="copyWebsite" disabled="{{copyingWebsite}}">{{copyingWebsite ? '复制中' : '复制网址'}}</button>
  </view>
</view>
<view wx:if="{{showWebsiteDialog}}" class="website-mask" catchtouchmove="noop">
  <view class="website-dialog" role="dialog" aria-label="网址已复制，请打开浏览器粘贴访问" catchtap="noop">
    <view class="website-success" aria-hidden="true"><view class="website-check" /></view>
    <text class="website-dialog-title">网址已复制</text>
    <text class="website-dialog-hint">请打开浏览器，粘贴网址访问</text>
    <text class="website-dialog-url" selectable>{{websiteUrl}}</text>
    <button class="website-confirm" hover-class="fb-tap-btn" bindtap="closeWebsiteDialog">我知道了</button>
  </view>
</view>
