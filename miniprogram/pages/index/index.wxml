<import src="/templates/discover-entry.wxml" />
<view class="home-page {{reduceMotion ? 'motion-reduced' : ''}}">
  <!-- Compact Refined Brand Header -->
  <view class="home-hero">
    <view class="topbar">
      <view class="brand-group">
        <text class="fb-brand">FunBox</text>
        <text class="brand-tag">相聚记分 · 日常顺手</text>
      </view>
      <view class="account-pill" bindtap="openProfile" hover-class="fb-tap-btn" hover-start-time="0" hover-stay-time="100">
        <text class="account-dot">{{isLoggedIn ? '已' : '游'}}</text>
        <text class="account-name">{{userName}}</text>
        <text class="account-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Active Room Resume Banner -->
  <view wx:if="{{recentRoom && featureEntries.roomResume && featureEntries.roomResume !== 'hidden'}}" class="resume-card" bindtap="resumeRoom" hover-class="fb-tap-card" hover-start-time="0" hover-stay-time="100">
    <view class="resume-copy">
      <view class="resume-status-row">
        <view class="resume-live-dot" aria-hidden="true"></view>
        <text class="resume-status-text">{{resumeState === 'checking' ? '正在确认牌局状态…' : resumeState === 'retry' ? '状态待确认，请重试' : recentRoom.status === 'active' ? '牌局进行中' : '等待开局'}}</text>
      </view>
      <text class="resume-title">{{recentRoom.name}}</text>
    </view>
    <button class="resume-button" hover-class="fb-tap-btn" loading="{{resumeBusy}}" disabled="{{resumeBusy}}" catchtap="resumeRoom">{{resumeState === 'retry' ? '重试继续' : '回到牌桌 ›'}}</button>
  </view>
  <view wx:if="{{resumeError && featureEntries.roomResume && featureEntries.roomResume !== 'hidden'}}" class="resume-error" role="alert">{{resumeError}}</view>

  <!-- 1-Tap Quick Join Action Bar -->
  <view wx:if="{{(featureEntries.roomJoin && featureEntries.roomJoin !== 'hidden')}}" class="quick-join-bar">
    <button class="quick-scan-btn" hover-class="fb-tap-btn" hover-start-time="0" hover-stay-time="100" loading="{{scanning}}" disabled="{{scanning}}" bindtap="scanToJoin">
      <image class="quick-btn-icon" src="/assets/icons/scan-white.png" mode="aspectFit" aria-hidden="true" />
      <text>扫一扫入桌</text>
    </button>
    <button class="quick-code-btn" hover-class="fb-tap-btn" hover-start-time="0" hover-stay-time="100" disabled="{{scanning}}" bindtap="openManualJoin">
      <image class="quick-btn-icon" src="/assets/icons/keyboard.png" mode="aspectFit" aria-hidden="true" />
      <text>输码加入</text>
    </button>
  </view>
  <view wx:if="{{scanError && featureEntries.roomJoin && featureEntries.roomJoin !== 'hidden'}}" class="resume-error" role="alert">{{scanError}}</view>

  <!-- 1+2 Bento Score Matrix -->
  <view wx:if="{{(featureEntries.mahjong && featureEntries.mahjong !== 'hidden') || (featureEntries.poker && featureEntries.poker !== 'hidden') || (featureEntries.general && featureEntries.general !== 'hidden')}}" class="section-head">
    <text class="section-title">开一局</text>
    <text class="section-note">每局都算数，散场好结算</text>
  </view>
  <view wx:if="{{(featureEntries.mahjong && featureEntries.mahjong !== 'hidden') || (featureEntries.poker && featureEntries.poker !== 'hidden') || (featureEntries.general && featureEntries.general !== 'hidden')}}" class="bento-grid">
    <view wx:if="{{(featureEntries.mahjong && featureEntries.mahjong !== 'hidden')}}" class="scene-entrance">
      <view class="scene-card mahjong-card" bindtap="openMahjong" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
        <view class="scene-copy">
          <text class="scene-tag scene-tag-mint">热门 · 4 人牌局</text>
          <text class="scene-title">麻将记分</text>
          <text class="scene-desc">快捷给分 · 换人交接 · 自动算账</text>
        </view>
        <view class="scene-art home-card-art art art-mahjong">
          <image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" />
        </view>
      </view>
    </view>

    <view wx:if="{{(featureEntries.poker && featureEntries.poker !== 'hidden') || (featureEntries.general && featureEntries.general !== 'hidden')}}" class="bento-pair {{featureEntries.poker === 'hidden' || featureEntries.general === 'hidden' ? 'bento-pair-single' : ''}}">
      <view wx:if="{{(featureEntries.poker && featureEntries.poker !== 'hidden')}}" class="scene-entrance">
        <view class="scene-card poker-card" bindtap="openPoker" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
          <view class="bento-top">
            <text class="scene-title bento-title">炸金花</text>
            <text class="scene-desc bento-desc">轮流加注 · 看池</text>
          </view>
          <text class="scene-tag scene-tag-coral">2 人起开</text>
          <view class="bento-art home-card-art art art-poker">
            <image class="art-atlas" src="/assets/illustrations/tabletop-atlas.png" mode="scaleToFill" aria-hidden="true" />
          </view>
        </view>
      </view>

      <view wx:if="{{(featureEntries.general && featureEntries.general !== 'hidden')}}" class="scene-entrance">
        <view class="scene-card general-card" bindtap="openGeneral" hover-class="home-card-pressed" hover-start-time="0" hover-stay-time="120">
          <view class="bento-top">
            <text class="scene-title bento-title">通用记分</text>
            <text class="scene-desc bento-desc">任意玩法 · 给分</text>
          </view>
          <text class="scene-tag scene-tag-blue">人数不限</text>
          <image class="bento-art home-card-art general-art" src="/assets/illustrations/general-score.png" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
    </view>
  </view>

  <!-- Zero-Hidden Discover Hub (Notebook + Memes + Live Holiday Strip) -->
  <view class="section-head discover-heading" bindtap="openDiscover" role="button" aria-label="发现更多，查看全部入口">
    <text class="section-title">发现更多</text>
    <view class="discover-more"><text>全部工具</text><view class="discover-more-arrow" aria-hidden="true"></view></view>
  </view>

  <view wx:if="{{(featureEntries.notebook && featureEntries.notebook !== 'hidden') || (featureEntries.memes && featureEntries.memes !== 'hidden')}}" class="discover-pair {{featureEntries.notebook === 'hidden' || featureEntries.memes === 'hidden' ? 'discover-pair-single' : ''}}">
    <view wx:if="{{(featureEntries.notebook && featureEntries.notebook !== 'hidden')}}" class="discover-slot"><template is="discover-notebook" /></view>
    <view wx:if="{{(featureEntries.memes && featureEntries.memes !== 'hidden')}}" class="discover-slot"><template is="discover-memes" /></view>
  </view>

  <view wx:if="{{(featureEntries.holidays && featureEntries.holidays !== 'hidden')}}" class="holiday-banner holiday-banner-{{holidayCard ? holidayCard.state : 'upcoming'}}" bindtap="openHolidays" hover-class="discover-card-pressed" hover-start-time="0" hover-stay-time="120" role="button" aria-label="节假日倒计时，{{holidayCard ? holidayCard.label : '查看放假与调休'}}">
    <view class="holiday-banner-left">
      <view class="holiday-mini-cal" aria-hidden="true">
        <text class="holiday-mini-month">{{holidayCard && holidayCard.monthBadge ? holidayCard.monthBadge : '假期'}}</text>
        <text class="holiday-mini-day">{{holidayCard && holidayCard.dayBadge ? holidayCard.dayBadge : '休'}}</text>
      </view>
      <view class="holiday-banner-copy">
        <view class="holiday-banner-top">
          <text class="holiday-banner-title">节假日倒计时</text>
          <text wx:if="{{holidayCard && holidayCard.isMakeupDay}}" class="holiday-banner-tag holiday-banner-tag-warn">今天调休上班</text>
          <text wx:elif="{{holidayCard && holidayCard.name && !holidayCard.hasMakeup}}" class="holiday-banner-tag">无需调休</text>
        </view>
        <text class="holiday-banner-desc">{{holidayCard ? (holidayCard.dateLabel ? holidayCard.label + ' · ' + holidayCard.dateLabel : holidayCard.label) : '查看全年放假与调休安排'}}</text>
      </view>
    </view>
    <view class="holiday-banner-right">
      <block wx:if="{{holidayCard && holidayCard.count}}">
        <text wx:if="{{holidayCard.state === 'holiday'}}" class="holiday-banner-unit">第</text>
        <text class="holiday-banner-num">{{holidayCard.count}}</text>
        <text class="holiday-banner-unit">天 ›</text>
      </block>
      <text wx:else class="holiday-banner-unit">查看 ›</text>
    </view>
  </view>

  <view wx:if="{{featureEntries.lottery && featureEntries.lottery !== 'hidden'}}" class="discover-pair discover-pair-single">
    <template is="discover-lottery" />
  </view>

  <view wx:if="{{featureEntries.website && featureEntries.website !== 'hidden'}}" class="website-card" bindtap="copyWebsite" hover-class="fb-tap-card" hover-start-time="0" hover-stay-time="100" role="button" aria-label="更多功能，复制 xwhub.cn 网址">
    <image class="website-logo" src="/assets/icons/funbox-logo.png" mode="aspectFit" aria-hidden="true" />
    <view class="website-copy">
      <text class="website-title">更多功能</text>
      <text class="website-address">访问 xwhub.cn</text>
    </view>
    <button class="website-button" hover-class="fb-tap-btn" catchtap="copyWebsite" disabled="{{copyingWebsite}}">{{copyingWebsite ? '复制中' : '复制网址'}}</button>
  </view>
</view>

<!-- Quick Manual Room Code Join Bottom Sheet -->
<view wx:if="{{manualJoinOpen && featureEntries.roomJoin && featureEntries.roomJoin !== 'hidden'}}" class="manual-mask {{reduceMotion ? 'motion-reduced' : ''}}" bindtap="closeManualJoin" catchtouchmove="noop">
  <view class="manual-sheet" style="bottom: {{manualKeyboardHeight}}px;" catchtap="noop" role="dialog" aria-label="输入房间码加入">
    <view class="sheet-handle" aria-hidden="true"></view>
    <view class="sheet-heading">
      <text class="sheet-title">输码加入牌局</text>
      <button class="sheet-close" disabled="{{joining}}" bindtap="closeManualJoin" aria-label="关闭">×</button>
    </view>
    <text class="sheet-desc">支持麻将、炸金花和通用记分房间</text>
    <scroll-view class="manual-fields" scroll-y enhanced show-scrollbar="{{false}}" style="max-height: calc(100vh - {{manualKeyboardHeight}}px - 230rpx);">
      <view class="sheet-content">
        <view class="field">
          <view class="field-label-row"><text class="field-label">房间码</text><text class="field-hint">6 位数字</text></view>
          <input class="field-input {{focusedJoinField === 'roomCode' ? 'join-field-focused' : ''}} {{joinErrorField === 'roomCode' ? 'join-field-error' : ''}}" bindfocus="focusJoinField" bindblur="blurJoinField" data-field="roomCode" maxlength="6" type="number" placeholder="输入 6 位房间码" value="{{roomCode}}" bindinput="handleJoinField" adjust-position="{{false}}" bindkeyboardheightchange="handleManualKeyboard" disabled="{{joining}}" />
          <text wx:if="{{joinErrorField === 'roomCode'}}" class="join-field-error-text">{{joinErrorMessage}}</text>
        </view>
        <view class="field">
          <text class="field-label">房间密码</text>
          <input class="field-input {{focusedJoinField === 'joinPassword' ? 'join-field-focused' : ''}} {{joinErrorField === 'joinPassword' ? 'join-field-error' : ''}}" bindfocus="focusJoinField" bindblur="blurJoinField" data-field="joinPassword" maxlength="6" type="number" password="{{true}}" placeholder="输入 4～6 位数字密码" value="{{joinPassword}}" bindinput="handleJoinField" adjust-position="{{false}}" bindkeyboardheightchange="handleManualKeyboard" disabled="{{joining}}" />
          <text wx:if="{{joinErrorField === 'joinPassword'}}" class="join-field-error-text">{{joinErrorMessage}}</text>
        </view>
        <view class="field">
          <view class="field-label-row"><text class="field-label">你的昵称</text><text class="field-hint">仅在本局内显示</text></view>
          <input class="field-input {{focusedJoinField === 'nickname' ? 'join-field-focused' : ''}} {{joinErrorField === 'nickname' ? 'join-field-error' : ''}}" bindfocus="focusJoinField" bindblur="blurJoinField" data-field="nickname" maxlength="48" placeholder="牌局内显示的名字" value="{{nickname}}" bindinput="handleJoinField" adjust-position="{{false}}" bindkeyboardheightchange="handleManualKeyboard" disabled="{{joining}}" />
          <text wx:if="{{joinErrorField === 'nickname'}}" class="join-field-error-text">{{joinErrorMessage}}</text>
        </view>
        <view wx:if="{{joinErrorMessage && !joinErrorField}}" class="resume-error" role="alert">{{joinErrorMessage}}</view>
        <button class="sheet-submit-btn" hover-class="fb-tap-btn" loading="{{joining && !joinSucceeded}}" disabled="{{joining}}" bindtap="joinByCode">{{joinSucceeded ? '✓ 加入成功' : joining ? '正在加入…' : '立即加入'}}</button>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{showWebsiteDialog}}" class="website-mask" catchtouchmove="noop">
  <view class="website-dialog" role="dialog" aria-label="网址已复制，请打开浏览器粘贴访问" catchtap="noop">
    <view class="website-success" aria-hidden="true"><view class="website-check" /></view>
    <text class="website-dialog-title">网址已复制</text>
    <text class="website-dialog-hint">请打开浏览器，粘贴网址访问</text>
    <text class="website-dialog-url" selectable>{{websiteUrl}}</text>
    <button class="website-confirm" hover-class="fb-tap-btn" bindtap="closeWebsiteDialog">我知道了</button>
  </view>
</view>
