@import "../../templates/discover-entry.wxss";

.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx 44rpx;
  background: radial-gradient(ellipse at 90% 5%,#eaf2ff 0%,transparent 38%),#f5f7fa;
}

.home-hero {
  animation: fb-reveal .3s ease-out both;
}

.website-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  min-height: 144rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 2rpx solid #dbe5ff;
  border-radius: 28rpx;
  background: #fff;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.website-logo {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
}

.website-copy {
  flex: 1;
  min-width: 0;
}

.website-title, .website-address {
  display: block;
}

.website-title {
  font-size: 30rpx;
  font-weight: 800;
}

.website-address {
  margin-top: 2rpx;
  color: #7b879c;
  font-size: 24rpx;
}

.website-button {
  flex-shrink: 0;
  margin: 0;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #edf3ff;
  color: #2d5bff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.website-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 24, 34, .58);
}

.website-dialog {
  box-sizing: border-box;
  width: 590rpx;
  max-width: 100%;
  padding: 48rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  text-align: center;
}

.website-success {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #20c773;
}

.website-check {
  width: 44rpx;
  height: 24rpx;
  margin-top: -12rpx;
  border-bottom: 9rpx solid #fff;
  border-left: 9rpx solid #fff;
  transform: rotate(-45deg);
}

.website-dialog-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
}

.website-dialog-hint {
  display: block;
  margin-top: 10rpx;
  color: #7b879c;
  font-size: 26rpx;
}

.website-dialog-url {
  display: block;
  margin-top: 26rpx;
  padding: 24rpx 12rpx;
  border-radius: 18rpx;
  background: #f0f3f8;
  font-size: 28rpx;
}

.website-confirm {
  margin-top: 30rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-caption {
  display: block;
  margin-top: 5rpx;
  color: #7b879c;
  font-size: 24rpx;
  font-weight: 700;
}

.account-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 250rpx;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border-radius: 99rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45,91,255,.06);
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.account-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #2d5bff;
  color: #fff;
  font-size: 22rpx;
}

.account-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
}

.account-arrow {
  color: #8490a4;
  font-size: 30rpx;
}

.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 250rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.headline {
  display: block;
  font-size: 53rpx;
  font-weight: 900;
  line-height: 1.43;
  letter-spacing: -2rpx;
}

.headline-accent {
  color: #2d5bff;
}

.hero-art {
  width: 280rpx;
  height: 280rpx;
  margin-right: -10rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 4rpx 18rpx;
}

.section-title {
  font-size: 35rpx;
  font-weight: 900;
}

.section-note {
  color: #7b879c;
  font-size: 22rpx;
}

.scene-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scene-entrance {
  animation: fb-reveal .35s ease-out .04s both;
}

.scene-entrance:nth-child(2) {
  animation-delay: .12s;
}

.scene-entrance:nth-child(3) {
  animation-delay: .2s;
}

.scene-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 210rpx;
  overflow: hidden;
  padding: 26rpx 30rpx;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
}

.mahjong-card {
  background: #e8f7f1;
}

.poker-card {
  background: #fff0ed;
}

.general-card {
  background: #eaf2ff;
}

.general-art {
  pointer-events: none;
}

.scene-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  width: 55%;
}

.scene-title {
  display: block;
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.35;
}

.scene-desc {
  display: block;
  margin-top: 8rpx;
  color: #64738b;
  font-size: 23rpx;
}

.scene-art {
  --home-art-offset: -50%;
  position: absolute;
  top: 50%;
  right: 25rpx;
  width: 250rpx;
  height: 250rpx;
}

@media (max-width:350px) {
  .headline {
    font-size: 49rpx;
  }

  .hero-art {
    width: 248rpx;
    height: 248rpx;
  }

  .scene-art {
    right: 10rpx;
    width: 232rpx;
    height: 232rpx;
  }

  .scene-desc {
    font-size: 22rpx;
  }


}

.discover-heading { align-items: center; justify-content: space-between; min-height: 68rpx; margin-bottom: 10rpx; }
.discover-more { display: flex; align-items: center; gap: 8rpx; color: var(--fb-primary); font-size: 23rpx; font-weight: 700; }
.discover-more-arrow { font-size: 33rpx; line-height: 1; }
.discover-swiper { height: 230rpx; margin: 0 -9rpx; }
.discover-slide { box-sizing: border-box; padding: 0 9rpx; }
.discover-pages { display: flex; justify-content: center; }
.discover-page-dot { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 48rpx; }
.discover-dot { width: 11rpx; height: 11rpx; border-radius: 99rpx; background: #bdcae6; }
.discover-page-active .discover-dot { width: 28rpx; background: var(--fb-primary); }

.scene-card {
  transition: transform 125ms ease-out, filter 125ms ease-out;
}

.home-card-art {
  transform: translateY(var(--home-art-offset, 0%));
  transition: transform 240ms cubic-bezier(.18, .84, .29, 1.2);
}

.poker-card {
  --home-art-tilt: 7deg;
}

.general-card {
  --home-art-tilt: -4deg;
}

.home-card-pressed {
  transform: translateY(3rpx) scale(.972);
  filter: brightness(.97);
}

.home-card-pressed .home-card-art {
  transform: translateY(var(--home-art-offset, 0%)) translateY(6rpx) rotate(var(--home-art-tilt, -7deg)) scale(.96);
  transition-duration: 125ms;
}

.motion-reduced .home-hero,
.motion-reduced .scene-entrance {
  animation: none;
}

.motion-reduced .scene-card,
.motion-reduced .home-card-art {
  transition: none;
}

.motion-reduced .home-card-pressed {
  transform: none;
}

.motion-reduced .home-card-pressed .home-card-art {
  transform: translateY(var(--home-art-offset, 0%));
}

@media (prefers-reduced-motion: reduce) {
  .home-hero,
  .scene-entrance {
    animation: none;
  }

  .scene-card,
  .home-card-art,
  .home-card-pressed .home-card-art {
    transition: none;
  }

  .home-card-pressed {
    transform: none;
  }

  .home-card-pressed .home-card-art {
    transform: translateY(var(--home-art-offset, 0%));
  }
}

.resume-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 18rpx 0 0;
  padding: 26rpx 28rpx;
  border: 2rpx solid #dbe5ff;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(45, 91, 255, .06);
}
.resume-copy { flex: 1; min-width: 0; }
.resume-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}
.resume-button {
  flex-shrink: 0;
  margin: 0;
  padding: 16rpx 26rpx;
  border-radius: 18rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
  transition: transform .12s ease-out, opacity .12s ease-out;
}
.resume-error {
  display: block;
  box-sizing: border-box;
  margin: 16rpx 0 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffd8d0;
  border-radius: 20rpx;
  background: var(--fb-danger-soft);
  box-shadow: none;
  color: var(--fb-danger);
  font-size: 24rpx;
  overflow-wrap: break-word;
}
