@import "../../templates/discover-entry.wxss";

.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 30rpx 44rpx;
  background: radial-gradient(ellipse at 92% 4%, #e8f1ff 0%, transparent 40%), var(--fb-canvas);
}

.home-hero {
  animation: fb-reveal .28s ease-out both;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.brand-tag {
  padding: 5rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .86);
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.account-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  max-width: 240rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 99rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(45, 91, 255, .06);
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.account-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.account-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
}

.account-arrow {
  color: #8490a4;
  font-size: 30rpx;
  line-height: 1;
}

/* Active Room Resume Card */
.resume-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #2d5bff 0%, #4b76ff 100%);
  box-shadow: 0 14rpx 32rpx rgba(45, 91, 255, .24);
  color: #fff;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.resume-copy {
  flex: 1;
  min-width: 0;
}

.resume-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.resume-live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5ff2b8;
}

.resume-status-text {
  color: rgba(255, 255, 255, .86);
  font-size: 22rpx;
  font-weight: 700;
}

.resume-title {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #fff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.resume-button {
  flex-shrink: 0;
  margin: 0;
  padding: 15rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.resume-error {
  box-sizing: border-box;
  display: block;
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #ffd8d0;
  border-radius: 20rpx;
  background: var(--fb-danger-soft);
  color: var(--fb-danger);
  font-size: 23rpx;
  overflow-wrap: break-word;
}

/* 1-Tap Quick Join Action Bar */
.quick-join-bar {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
  animation: fb-reveal .3s ease-out .03s both;
}

.quick-scan-btn,
.quick-code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 94rpx;
  margin: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.quick-scan-btn {
  background: var(--fb-primary);
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(45, 91, 255, .22);
}

.quick-code-btn {
  border: 2rpx solid #e3eaf7;
  background: #fff;
  color: var(--fb-ink);
  box-shadow: 0 8rpx 20rpx rgba(38, 76, 133, .04);
}

.quick-btn-icon {
  display: block;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}

/* Section Heading */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 30rpx 4rpx 16rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 33rpx;
  font-weight: 900;
}

.section-note {
  color: var(--fb-muted);
  font-size: 22rpx;
}

/* 1+2 Bento Score Matrix */
.bento-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bento-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.bento-pair-single {
  grid-template-columns: minmax(0, 1fr);
}

.scene-entrance {
  min-width: 0;
  animation: fb-reveal .34s ease-out .05s both;
}

.bento-pair .scene-entrance:first-child { animation-delay: .1s; }
.bento-pair .scene-entrance:last-child { animation-delay: .15s; }

.scene-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  transition: transform 125ms ease-out, filter 125ms ease-out;
}

/* Featured Wide Mahjong Card */
.mahjong-card {
  align-items: center;
  justify-content: space-between;
  min-height: 218rpx;
  padding: 26rpx 30rpx;
  background: linear-gradient(135deg, #e3f7ef 0%, #ebf9f3 56%, #f5fdf9 100%);
  box-shadow: 0 12rpx 30rpx rgba(16, 136, 98, .06);
}

.scene-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  width: 60%;
}

.scene-tag {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .86);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
}

.scene-tag-mint {
  margin-bottom: 10rpx;
  color: #0d7c5b;
}

.scene-tag-coral {
  align-self: flex-start;
  color: #c44d35;
}

.scene-tag-blue {
  align-self: flex-start;
  color: var(--fb-primary);
}

.scene-title {
  display: block;
  color: var(--fb-ink);
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.28;
}

.scene-desc {
  display: block;
  margin-top: 8rpx;
  color: #4f6b62;
  font-size: 22rpx;
  line-height: 1.4;
}

.scene-art {
  --home-art-offset: -50%;
  position: absolute;
  top: 50%;
  right: 16rpx;
  width: 242rpx;
  height: 242rpx;
}

/* 2-Column Compact Cards (Poker + General) */
.poker-card,
.general-card {
  flex-direction: column;
  justify-content: space-between;
  min-height: 226rpx;
  padding: 26rpx 24rpx 24rpx;
}

.poker-card {
  --home-art-tilt: 7deg;
  background: linear-gradient(145deg, #ffefea 0%, #fff7f5 100%);
  box-shadow: 0 10rpx 26rpx rgba(204, 76, 52, .05);
}

.general-card {
  --home-art-tilt: -4deg;
  background: linear-gradient(145deg, #e7f0ff 0%, #f4f8ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(45, 91, 255, .05);
}

.bento-top {
  position: relative;
  z-index: 1;
}

.bento-title {
  font-size: 32rpx;
}

.bento-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.poker-card .bento-desc { color: #7d5b54; }
.general-card .bento-desc { color: #546887; }

.bento-art {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 146rpx;
  height: 146rpx;
  pointer-events: none;
}

.general-art {
  width: 138rpx;
  height: 138rpx;
  right: 10rpx;
  bottom: 8rpx;
}

/* Zero-Hidden Discover Hub */
.discover-heading {
  align-items: center;
  min-height: 56rpx;
  margin-top: 30rpx;
  margin-bottom: 16rpx;
}

.discover-more {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--fb-primary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
}

.discover-more-arrow {
  width: 11rpx;
  height: 11rpx;
  box-sizing: border-box;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.discover-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.discover-pair-single {
  grid-template-columns: minmax(0, 1fr);
}

.discover-pair + .discover-pair,
.holiday-banner + .discover-pair {
  margin-top: 18rpx;
}

.discover-slot {
  min-width: 0;
}

/* On Home, Notebook & Memes use clean white cards so they don't compete with the colorful Bento cards above */
.discover-pair .discover-card {
  height: 188rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(38, 76, 133, .045);
  grid-template-columns: minmax(0, 1fr) 92rpx;
}

.discover-pair .discover-title {
  font-size: 30rpx;
}

.discover-pair .discover-desc {
  color: var(--fb-muted);
  font-size: 22rpx;
}

.discover-pair .discover-entry-art {
  width: 92rpx;
  height: 92rpx;
}

/* Full-Width Live Holiday Countdown Banner */
.holiday-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 22rpx 26rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #e7f7f0 0%, #effaf5 55%, #f8fdfb 100%);
  box-shadow: 0 10rpx 26rpx rgba(16, 136, 98, .06);
  transition: transform 125ms ease-out, filter 125ms ease-out;
}

.holiday-banner-near,
.holiday-banner-tomorrow {
  background: linear-gradient(135deg, #fff3e8 0%, #fff7f0 100%);
  box-shadow: 0 10rpx 26rpx rgba(196, 86, 26, .06);
}

.holiday-banner-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.holiday-mini-cal {
  flex-shrink: 0;
  width: 78rpx;
  overflow: hidden;
  border: 2rpx solid #cdece0;
  border-radius: 18rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 136, 98, .08);
}

.holiday-banner-near .holiday-mini-cal,
.holiday-banner-tomorrow .holiday-mini-cal {
  border-color: #ffd8be;
}

.holiday-mini-month {
  display: block;
  padding: 3rpx 0;
  background: #12916a;
  color: #fff;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.25;
}

.holiday-banner-near .holiday-mini-month,
.holiday-banner-tomorrow .holiday-mini-month {
  background: #d86024;
}

.holiday-mini-day {
  display: block;
  padding: 5rpx 0 6rpx;
  color: var(--fb-ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.holiday-banner-copy {
  flex: 1;
  min-width: 0;
}

.holiday-banner-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.holiday-banner-title {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.holiday-banner-tag {
  padding: 2rpx 12rpx;
  border-radius: 99rpx;
  background: #fff;
  color: #0d7c5b;
  font-size: 20rpx;
  font-weight: 800;
}

.holiday-banner-tag-warn {
  background: #ffece0;
  color: #b54a18;
}

.holiday-banner-desc {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #4f6d63;
  font-size: 22rpx;
}

.holiday-banner-right {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  gap: 4rpx;
  color: #0b7a59;
}

.holiday-banner-near .holiday-banner-right,
.holiday-banner-tomorrow .holiday-banner-right {
  color: #c24d18;
}

.holiday-banner-num {
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.holiday-banner-unit {
  font-size: 22rpx;
  font-weight: 800;
}

/* Home Card Press Physics */
.home-card-art {
  transform: translateY(var(--home-art-offset, 0%));
  transition: transform 240ms cubic-bezier(.18, .84, .29, 1.2);
}

.home-card-pressed {
  transform: translateY(3rpx) scale(.972);
  filter: brightness(.97);
}

.home-card-pressed .home-card-art {
  transform: translateY(var(--home-art-offset, 0%)) translateY(6rpx) rotate(var(--home-art-tilt, -7deg)) scale(.96);
  transition-duration: 125ms;
}

/* Manual Join Bottom Sheet */
.manual-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  background: rgba(23, 33, 57, .42);
}

.manual-sheet {
  position: absolute;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding-top: 18rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  transition: bottom .2s ease-out;
}

.sheet-handle {
  width: 88rpx;
  height: 9rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: #e2e8f1;
}

.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
}

.sheet-title {
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 800;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: -10rpx -10rpx -10rpx 12rpx;
  padding: 0;
  border-radius: 50%;
  background: #f5f7fa;
  color: var(--fb-muted);
  font-size: 40rpx;
  line-height: 1;
}

.sheet-desc {
  display: block;
  margin: 10rpx 36rpx 0;
  color: var(--fb-muted);
  font-size: 24rpx;
}

.manual-fields {
  box-sizing: border-box;
  height: 680rpx;
}

.sheet-content {
  padding: 0 36rpx calc(36rpx + env(safe-area-inset-bottom));
}

.field {
  margin-top: 26rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #34425b;
  font-size: 25rpx;
  font-weight: 700;
}

.field-label-row .field-label {
  margin-bottom: 0;
}

.field-hint {
  color: var(--fb-subtle);
  font-size: 22rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 22rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 17rpx;
  background: #fff;
  color: var(--fb-ink);
  font-size: 28rpx;
  transition: border-color .16s, box-shadow .16s, background .16s;
}

.join-field-focused {
  border-color: var(--fb-primary);
  box-shadow: 0 0 0 5rpx #edf3ff;
  background: #fcfdff;
}

.join-field-error {
  border-color: #df826e;
  background: #fffaf8;
}

.join-field-error-text {
  display: block;
  margin-top: 10rpx;
  color: var(--fb-danger);
  font-size: 22rpx;
}

.sheet-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  margin: 34rpx 0 0;
  padding: 22rpx 14rpx;
  border-radius: 22rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.sheet-submit-btn[disabled] {
  background: #c3d1f4;
  color: #fff;
}

/* Website Entry & Dialog */
.website-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  min-height: 144rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #dbe5ff;
  border-radius: 28rpx;
  background: #fff;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.website-logo { flex-shrink: 0; width: 84rpx; height: 84rpx; border-radius: 20rpx; }
.website-copy { flex: 1; min-width: 0; }
.website-title, .website-address { display: block; }
.website-title { font-size: 30rpx; font-weight: 800; }
.website-address { margin-top: 2rpx; color: var(--fb-muted); font-size: 24rpx; }
.website-button { flex-shrink: 0; margin: 0; padding: 14rpx 20rpx; border-radius: 18rpx; background: #edf3ff; color: var(--fb-primary); font-size: 24rpx; font-weight: 700; line-height: 1.5; }

.website-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(17, 24, 34, .58); }
.website-dialog { box-sizing: border-box; width: 590rpx; max-width: 100%; padding: 48rpx 36rpx 36rpx; border-radius: 32rpx; background: #fff; text-align: center; }
.website-success { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: 0 auto 24rpx; border-radius: 50%; background: #20c773; }
.website-check { width: 44rpx; height: 24rpx; margin-top: -12rpx; border-bottom: 9rpx solid #fff; border-left: 9rpx solid #fff; transform: rotate(-45deg); }
.website-dialog-title { display: block; font-size: 38rpx; font-weight: 800; }
.website-dialog-hint { display: block; margin-top: 10rpx; color: var(--fb-muted); font-size: 26rpx; }
.website-dialog-url { display: block; margin-top: 26rpx; padding: 24rpx 12rpx; border-radius: 18rpx; background: #f0f3f8; font-size: 28rpx; }
.website-confirm { margin-top: 30rpx; padding: 24rpx 0; border-radius: 20rpx; background: var(--fb-primary); color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1.5; }

/* Small screen & Reduced Motion */
@media (max-width: 350px) {
  .home-page { padding-left: 22rpx; padding-right: 22rpx; }
  .scene-art { right: 4rpx; width: 214rpx; height: 214rpx; }
  .bento-art { width: 126rpx; height: 126rpx; }
  .general-art { width: 120rpx; height: 120rpx; }
  .brand-tag { display: none; }
}

.motion-reduced .home-hero,
.motion-reduced .quick-join-bar,
.motion-reduced .scene-entrance { animation: none; }

.motion-reduced .scene-card,
.motion-reduced .home-card-art,
.motion-reduced .holiday-banner,
.motion-reduced .manual-sheet { transition: none; }

.motion-reduced .home-card-pressed { transform: none; }
.motion-reduced .home-card-pressed .home-card-art { transform: translateY(var(--home-art-offset, 0%)); }

@media (prefers-reduced-motion: reduce) {
  .home-hero,
  .quick-join-bar,
  .scene-entrance { animation: none; }
  .scene-card,
  .home-card-art,
  .home-card-pressed .home-card-art,
  .holiday-banner,
  .manual-sheet { transition: none; }
  .home-card-pressed { transform: none; }
  .home-card-pressed .home-card-art { transform: translateY(var(--home-art-offset, 0%)); }
}
