.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 44rpx 30rpx 70rpx;
  background:
    radial-gradient(circle at 88% 2%, rgba(44, 107, 78, 0.16), transparent 34%),
    linear-gradient(180deg, #f5f1e7 0%, #f7f5ef 58%, #f1efe7 100%);
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 6rpx 42rpx;
}

.eyebrow,
.headline,
.account-pill text,
.section-title,
.section-note,
.scene-kicker,
.scene-title,
.scene-desc,
.small-title,
.small-desc,
.principles-title,
.resume-kicker,
.resume-title {
  display: block;
}

.eyebrow {
  color: #2f755b;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.headline {
  max-width: 480rpx;
  margin-top: 18rpx;
  color: #14251d;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.22;
}

.account-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 190rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(36, 82, 61, 0.15);
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.8);
  color: #44534a;
  font-size: 22rpx;
  font-weight: 700;
}

.account-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e5eadf;
  color: #256349;
  font-size: 19rpx;
}

.offline-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff0eb;
  color: #a34531;
  font-size: 23rpx;
}

.offline-action {
  font-weight: 800;
}

.resume-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 26rpx 28rpx;
  border-radius: 22rpx;
  background: #193c2f;
  color: #f8f2df;
  box-shadow: 0 18rpx 40rpx rgba(25, 60, 47, 0.16);
}

.resume-kicker {
  color: #9ec7b2;
  font-size: 20rpx;
  font-weight: 700;
}

.resume-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.resume-arrow {
  font-size: 52rpx;
  line-height: 1;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 12rpx 6rpx 24rpx;
}

.section-title {
  color: #1a2b22;
  font-size: 34rpx;
  font-weight: 900;
}

.section-note {
  color: #7b847d;
  font-size: 22rpx;
}

.scene-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.scene-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(30, 66, 49, 0.12);
  border-radius: 30rpx;
}

.mahjong-card {
  min-height: 390rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #194c37 0%, #1e6045 52%, #28785a 100%);
  color: #fff8e5;
  box-shadow: 0 24rpx 56rpx rgba(26, 72, 52, 0.19);
}

.scene-glow {
  position: absolute;
  top: -100rpx;
  right: -90rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(244, 209, 104, 0.13);
}

.mahjong-tiles {
  position: absolute;
  top: 30rpx;
  right: 26rpx;
  display: flex;
  gap: 8rpx;
  transform: rotate(-7deg);
}

.tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 102rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 13rpx;
  background: #f7f0dc;
  box-shadow: 0 10rpx 18rpx rgba(11, 44, 30, 0.22);
  color: #1b4735;
  font-size: 38rpx;
  font-weight: 900;
}

.tile:nth-child(2) {
  margin-top: 16rpx;
}

.tile-red {
  color: #b54332;
}

.tile-dot {
  gap: 6rpx;
  flex-wrap: wrap;
  align-content: center;
  justify-content: center;
  padding: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2a7055;
}

.dot-one {
  background: #b54332;
}

.scene-copy {
  position: relative;
  z-index: 1;
  width: 62%;
  margin-top: 150rpx;
}

.scene-kicker {
  color: #b8d9c7;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.scene-title {
  margin-top: 8rpx;
  font-size: 54rpx;
  font-weight: 900;
}

.scene-desc {
  margin-top: 14rpx;
  color: #d7eadf;
  font-size: 24rpx;
  line-height: 1.65;
}

.scene-action {
  position: absolute;
  right: 30rpx;
  bottom: 28rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f0d36c;
  color: #183d2d;
  font-size: 23rpx;
  font-weight: 800;
}

.small-scenes {
  display: flex;
  gap: 20rpx;
}

.small-card {
  flex: 1;
  min-height: 250rpx;
  padding: 24rpx;
  background: rgba(255, 253, 247, 0.86);
  box-shadow: 0 14rpx 34rpx rgba(45, 55, 46, 0.06);
}

.playing-cards {
  display: flex;
  height: 92rpx;
}

.mini-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 86rpx;
  border: 2rpx solid #eee7d8;
  border-radius: 10rpx;
  background: #fffefa;
  box-shadow: 0 8rpx 14rpx rgba(48, 48, 38, 0.09);
  font-size: 23rpx;
  font-weight: 900;
}

.mini-card + .mini-card {
  margin-left: -10rpx;
  transform: rotate(9deg);
}

.black-card {
  color: #25322c;
}

.red-card {
  color: #b64432;
}

.gold-card {
  color: #a47a1e;
}

.small-copy {
  margin-top: 26rpx;
}

.small-title {
  color: #23352c;
  font-size: 30rpx;
  font-weight: 900;
}

.small-desc {
  margin-top: 8rpx;
  color: #7b847d;
  font-size: 21rpx;
}

.coming-pill {
  position: absolute;
  top: 20rpx;
  right: 18rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #eceee7;
  color: #7d857e;
  font-size: 18rpx;
  font-weight: 700;
}

.principles {
  margin-top: 34rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(38, 70, 54, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.7);
}

.principles-title {
  margin-bottom: 16rpx;
  color: #293a31;
  font-size: 27rpx;
  font-weight: 900;
}

.principle-row {
  display: flex;
  gap: 18rpx;
  padding: 14rpx 0;
  color: #667168;
  font-size: 23rpx;
  line-height: 1.5;
}

.principle-index {
  color: #2f755b;
  font-size: 20rpx;
  font-weight: 900;
}

.service-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 28rpx 8rpx 0;
  color: #788279;
  font-size: 20rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a4aca6;
}

.status-online .status-dot {
  background: #2d9c68;
}

.status-offline .status-dot {
  background: #c35b44;
}

.status-checking .status-dot {
  background: #d4a832;
}

.status-message {
  width: 100%;
  color: #939b95;
}
