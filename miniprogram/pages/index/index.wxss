.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx 44rpx;
  background: radial-gradient(ellipse at 90% 5%,#eaf2ff 0%,transparent 38%),#f5f7fa;
}

.home-hero {
  animation: fb-reveal .3s ease-out both;
}

.website-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  min-height: 144rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 2rpx solid #dbe5ff;
  border-radius: 28rpx;
  background: #fff;
}

.website-logo {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
}

.website-copy {
  flex: 1;
  min-width: 0;
}

.website-title, .website-address {
  display: block;
}

.website-title {
  font-size: 30rpx;
  font-weight: 800;
}

.website-address {
  margin-top: 2rpx;
  color: #7b879c;
  font-size: 24rpx;
}

.website-button {
  flex-shrink: 0;
  margin: 0;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #edf3ff;
  color: #2d5bff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.website-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 24, 34, .58);
}

.website-dialog {
  box-sizing: border-box;
  width: 590rpx;
  max-width: 100%;
  padding: 48rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  text-align: center;
}

.website-success {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #20c773;
}

.website-check {
  width: 44rpx;
  height: 24rpx;
  margin-top: -12rpx;
  border-bottom: 9rpx solid #fff;
  border-left: 9rpx solid #fff;
  transform: rotate(-45deg);
}

.website-dialog-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
}

.website-dialog-hint {
  display: block;
  margin-top: 10rpx;
  color: #7b879c;
  font-size: 26rpx;
}

.website-dialog-url {
  display: block;
  margin-top: 26rpx;
  padding: 24rpx 12rpx;
  border-radius: 18rpx;
  background: #f0f3f8;
  font-size: 28rpx;
}

.website-confirm {
  margin-top: 30rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: #2d5bff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-caption {
  display: block;
  margin-top: 5rpx;
  color: #7b879c;
  font-size: 24rpx;
  font-weight: 700;
}

.account-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 250rpx;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border-radius: 99rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45,91,255,.06);
}

.account-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #2d5bff;
  color: #fff;
  font-size: 22rpx;
}

.account-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
}

.account-arrow {
  color: #8490a4;
  font-size: 30rpx;
}

.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 250rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.headline {
  display: block;
  font-size: 53rpx;
  font-weight: 900;
  line-height: 1.43;
  letter-spacing: -2rpx;
}

.headline-accent {
  color: #2d5bff;
}

.hero-art {
  width: 280rpx;
  height: 280rpx;
  margin-right: -10rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 4rpx 18rpx;
}

.section-title {
  font-size: 35rpx;
  font-weight: 900;
}

.section-note {
  color: #7b879c;
  font-size: 22rpx;
}

.scene-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scene-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 210rpx;
  overflow: hidden;
  padding: 26rpx 30rpx;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  animation: fb-reveal .35s ease-out both;
}

.mahjong-card {
  background: #e8f7f1;
  animation-delay: .04s;
}

.poker-card {
  background: #fff0ed;
  animation-delay: .12s;
}

.general-card {
  background: #eaf2ff;
  animation-delay: .2s;
}

.general-art {
  pointer-events: none;
}

.scene-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  width: 55%;
}

.scene-title {
  display: block;
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.35;
}

.scene-desc {
  display: block;
  margin-top: 8rpx;
  color: #64738b;
  font-size: 23rpx;
}

.scene-art {
  position: absolute;
  top: 50%;
  right: 25rpx;
  width: 250rpx;
  height: 250rpx;
  transform: translateY(-50%);
}

.principles {
  margin-top: 28rpx;
  padding: 28rpx;
}

.principles-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.principle-row {
  display: flex;
  gap: 18rpx;
  padding: 13rpx 0;
  font-size: 23rpx;
}

.principle-row + .principle-row {
  border-top: 1rpx solid #edf1f8;
}

.principle-index {
  flex-shrink: 0;
  align-self: flex-start;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #edf3ff;
  color: #2d5bff;
  font-size: 21rpx;
  font-weight: 800;
}

.service-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 26rpx;
  color: #8b96a8;
  font-size: 21rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b0b9c9;
}

.status-online .status-dot {
  background: #43c893;
}

.status-offline .status-dot {
  background: #ff765e;
}

.status-checking .status-dot {
  background: #2d5bff;
}

.status-message {
  width: 100%;
  text-align: center;
}

.offline-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #fff0ed;
  color: #c95744;
  font-size: 23rpx;
}

.offline-action {
  flex-shrink: 0;
  font-weight: 800;
}

@media (max-width:350px) {
  .headline {
    font-size: 49rpx;
  }

  .hero-art {
    width: 248rpx;
    height: 248rpx;
  }

  .scene-art {
    right: 10rpx;
    width: 232rpx;
    height: 232rpx;
  }

  .scene-desc {
    font-size: 22rpx;
  }


}

.meme-entry { position:relative; display:flex; align-items:center; min-height:230rpx; box-sizing:border-box; padding:30rpx; overflow:hidden; border:2rpx solid white; border-radius:32rpx; background:#eeeaff; }
.meme-entry-art {position:absolute;right:0;top:0;width:310rpx;height:230rpx;}
.meme-caption {display:block;margin-top:20rpx;color:#8d83a8;font-size:22rpx;}
