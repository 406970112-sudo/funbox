@import "../../templates/discover-entry.wxss";

.discover-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 4%, #e8f1ff 0%, transparent 42%), var(--fb-canvas);
}

.discover-hero {
  animation: fb-reveal .28s ease-out both;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-tag {
  padding: 5rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .86);
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.discover-headline {
  display: block;
  margin-top: 16rpx;
  color: var(--fb-ink);
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
  line-height: 1.32;
}

.discover-accent {
  color: var(--fb-primary);
}

.discover-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 23rpx;
}

/* Recently Used Strip */
.recent-section {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(38, 76, 133, .04);
}

.recent-label {
  flex-shrink: 0;
  color: var(--fb-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.recent-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.recent-row {
  display: inline-flex;
  gap: 12rpx;
}

.recent-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 99rpx;
  background: #f4f7fc;
  color: var(--fb-ink-secondary);
  font-size: 23rpx;
  font-weight: 700;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.recent-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--fb-primary);
}

.recent-dot-lottery { background: #ef4b38; }
.recent-dot-holidays { background: #12916a; }
.recent-dot-memes { background: #7b61ff; }

/* Category Filter Chips */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 24rpx;
}

.category-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e7edf6;
  border-radius: 99rpx;
  background: #fff;
  color: #52617d;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 3rpx 8rpx rgba(44, 66, 105, .03);
  transition: transform .12s ease-out, background .15s ease;
}

.category-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
  color: #fff;
}

/* Tool Groups */
.tool-group {
  margin-top: 26rpx;
  animation: fb-reveal .34s ease-out .04s both;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin: 0 4rpx 16rpx;
}

.group-title {
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.group-note {
  color: var(--fb-muted);
  font-size: 22rpx;
}

.discover-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.discover-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 46rpx 0 8rpx;
  color: var(--fb-subtle);
  font-size: 22rpx;
}

.footer-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c5d4f5;
}

.motion-reduced .discover-hero,
.motion-reduced .tool-group {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .discover-hero,
  .tool-group {
    animation: none;
  }
}
