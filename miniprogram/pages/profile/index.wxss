.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 4%, #e8f1ff 0%, transparent 42%), var(--fb-canvas);
}

/* Compact Topbar */
.profile-hero {
  margin-bottom: 22rpx;
  animation: fb-reveal .28s ease-out both;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-tag {
  padding: 5rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .86);
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 700;
}

.settings-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .95);
  border-radius: 99rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(45, 91, 255, .05);
  color: var(--fb-ink-secondary);
  font-size: 23rpx;
  font-weight: 700;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.settings-pill-arrow {
  color: #8490a4;
  font-size: 28rpx;
  line-height: 1;
}

/* Base Profile Cards */
.profile-card {
  box-sizing: border-box;
  min-height: 200rpx;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.history-entry-card,
.feedback-card {
  min-height: 168rpx;
}

/* Identity & Guest Hero Card */
.identity-card,
.guest-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 28rpx;
  border: 2rpx solid #fff;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f4f8ff 58%, #eaf2ff 100%);
  box-shadow: 0 14rpx 36rpx rgba(45, 91, 255, .07);
  animation: fb-reveal .32s ease-out .03s both;
}

.avatar {
  flex-shrink: 0;
  width: 116rpx;
  height: 116rpx;
  border: 4rpx solid #fff;
  border-radius: 30rpx;
  background: #e9f0ff;
  box-shadow: 0 8rpx 20rpx rgba(45, 91, 255, .14);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #4f7bff, var(--fb-primary));
  box-shadow: inset 0 -5rpx 0 rgba(20, 58, 204, .18), 0 8rpx 20rpx rgba(45, 91, 255, .2);
  color: #fff;
  font-size: 48rpx;
  font-weight: 900;
}

.identity-copy,
.guest-copy {
  flex: 1;
  min-width: 0;
}

.identity-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.identity-name,
.identity-meta,
.identity-date,
.guest-title,
.guest-desc,
.history-entry-title,
.history-entry-desc,
.feedback-title,
.feedback-desc {
  display: block;
}

.identity-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}

.identity-badge {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 99rpx;
  background: #e3ecff;
  color: var(--fb-primary);
  font-size: 20rpx;
  font-weight: 800;
}

.identity-meta {
  margin-top: 6rpx;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.identity-date {
  margin-top: 4rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
}

.identity-edit-chip {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .92);
  color: var(--fb-primary);
  font-size: 23rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(45, 91, 255, .08);
}

.guest-identity {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 20rpx;
}

.guest-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.guest-desc {
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.guest-cta {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(45, 91, 255, .22);
}

/* Inline Error */
.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffd8d0;
  border-radius: 20rpx;
  background: var(--fb-danger-soft);
  color: var(--fb-danger);
  font-size: 23rpx;
}

.inline-retry {
  flex-shrink: 0;
  font-weight: 800;
}

/* Section Heading */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin: 30rpx 4rpx 16rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 33rpx;
  font-weight: 900;
}

.section-note {
  color: var(--fb-muted);
  font-size: 22rpx;
}

/* My Content Bento Grid */
.content-bento {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  animation: fb-reveal .36s ease-out .06s both;
}

.history-entry-card,
.meme-entry-card,
.notebook-entry-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 224rpx;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #fff;
}

.bento-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.history-entry-title {
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.history-entry-desc {
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.bento-art {
  position: absolute;
  right: 10rpx;
  bottom: 6rpx;
  width: 118rpx;
  height: 118rpx;
  pointer-events: none;
}

.bento-art-img {
  width: 110rpx;
  height: 110rpx;
  right: 14rpx;
  bottom: 10rpx;
}

.bento-note-art {
  position: relative;
  align-self: flex-end;
  width: 104rpx;
  height: 104rpx;
  margin-top: 8rpx;
  pointer-events: none;
}

/* When logged in, Notebook spans full width neatly below the 2-col pair */
.bento-wide {
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  min-height: 148rpx;
  padding: 20rpx 26rpx;
}

.bento-wide .bento-copy {
  flex: 1;
}

.bento-wide .bento-note-art {
  align-self: center;
  width: 96rpx;
  height: 96rpx;
  margin-top: 0;
  flex-shrink: 0;
}

/* Feedback Card */
.feedback-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 26rpx;
  border-radius: 30rpx;
  background: #fff;
  animation: fb-reveal .38s ease-out .1s both;
}

.feedback-copy {
  flex: 1;
  min-width: 0;
}

.feedback-title {
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.feedback-desc {
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.feedback-art {
  width: 110rpx;
  height: 110rpx;
}

/* Grouped Service & Legal List */
.service-list {
  overflow: hidden;
  margin-top: 18rpx;
  border-radius: 30rpx;
  background: #fff;
  animation: fb-reveal .4s ease-out .12s both;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 18rpx 28rpx;
  box-sizing: border-box;
  transition: background .12s ease;
}

.service-row + .service-row {
  border-top: 1rpx solid var(--fb-line);
}

.service-row-copy {
  flex: 1;
  min-width: 0;
}

.service-row-title {
  display: block;
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.service-row-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
}

.service-row-arrow {
  flex-shrink: 0;
  color: #93a0b5;
  font-size: 36rpx;
  line-height: 1;
}

/* Minimal Footer */
.profile-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 44rpx 0 8rpx;
  color: var(--fb-subtle);
  font-size: 22rpx;
}

.footer-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c5d4f5;
}

@media (max-width: 350px) {
  .profile-page { padding-left: 22rpx; padding-right: 22rpx; }
  .avatar { width: 102rpx; height: 102rpx; }
  .identity-name, .guest-title { font-size: 31rpx; }
  .bento-art, .feedback-art { width: 98rpx; height: 98rpx; }
  .bento-art-img { width: 94rpx; height: 94rpx; }
}

.profile-motion-reduced .profile-hero,
.profile-motion-reduced .identity-card,
.profile-motion-reduced .guest-card,
.profile-motion-reduced .content-bento,
.profile-motion-reduced .feedback-card,
.profile-motion-reduced .service-list {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .profile-hero,
  .identity-card,
  .guest-card,
  .content-bento,
  .feedback-card,
  .service-list {
    animation: none;
  }
}
