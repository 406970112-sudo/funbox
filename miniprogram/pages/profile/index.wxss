.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 28rpx 90rpx;
  background:
    radial-gradient(circle at 92% 5%, rgba(44, 107, 78, 0.16), transparent 32%),
    linear-gradient(180deg, #f5f1e7 0%, #f7f5ef 62%, #f0eee6 100%);
}

.hero-kicker,
.hero-title,
.hero-copy,
.identity-name,
.identity-meta,
.identity-date,
.guest-title,
.guest-desc,
.section-kicker,
.section-title,
.section-note,
.empty-title,
.empty-desc,
.record-type,
.record-name,
.result-score,
.result-amount,
.record-label,
.record-value,
.feedback-title,
.feedback-desc {
  display: block;
}

.profile-hero {
  padding: 20rpx 10rpx 34rpx;
}

.hero-kicker {
  color: #2f755b;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 18rpx;
  color: #14251d;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.22;
}

.hero-copy {
  max-width: 600rpx;
  margin-top: 14rpx;
  color: #6e786f;
  font-size: 24rpx;
  line-height: 1.65;
}

.identity-card,
.guest-card,
.records-section,
.history-entry-card,
.feedback-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  background: rgba(255, 253, 247, 0.94);
  box-shadow: 0 20rpx 48rpx rgba(40, 55, 45, 0.07);
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
}

.avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: #e5eadf;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1d5d43, #2f8a65);
  color: #fff8e5;
  font-size: 46rpx;
  font-weight: 900;
}

.identity-copy {
  min-width: 0;
  flex: 1;
}

.identity-name {
  overflow: hidden;
  color: #17251f;
  font-size: 36rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-meta {
  margin-top: 8rpx;
  color: #526158;
  font-size: 25rpx;
  font-weight: 700;
}

.identity-date {
  margin-top: 6rpx;
  color: #8a938c;
  font-size: 21rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d4a832;
}

.guest-card {
  padding: 30rpx;
  border-radius: 30rpx;
}

.guest-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 112rpx;
  border-radius: 18rpx;
  background: #1d6b4f;
  color: #fff8e5;
  font-size: 46rpx;
  font-weight: 900;
}

.guest-copy {
  margin-top: 22rpx;
}

.guest-title {
  color: #17251f;
  font-size: 32rpx;
  font-weight: 900;
}

.guest-desc {
  margin-top: 8rpx;
  color: #748078;
  font-size: 24rpx;
  line-height: 1.6;
}

.guest-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.login-button,
.register-button {
  flex: 1;
  margin: 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.login-button {
  background: #1d6b4f;
  color: #fffdf7;
}

.register-button {
  border: 1rpx solid #cfd8d0;
  background: #f3f4ee;
  color: #245d45;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff0eb;
  color: #a34531;
  font-size: 23rpx;
}

.inline-retry,
.state-action {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-weight: 800;
}

.records-section {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 30rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-kicker {
  color: #2f755b;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: 5rpx;
  color: #17251f;
  font-size: 34rpx;
  font-weight: 900;
}

.section-note {
  color: #8a938c;
  font-size: 20rpx;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 150rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f4f3ed;
  color: #778078;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  flex-direction: row;
  background: #fff0eb;
  color: #a34531;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 50%;
  background: #2f755b;
  animation: pulse 1.1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.empty-title {
  color: #405047;
  font-size: 27rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 9rpx;
  color: #8a938c;
  font-size: 22rpx;
  line-height: 1.55;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 24rpx;
  border: 1rpx solid #e2e5dc;
  border-radius: 22rpx;
  background: #fbfaf5;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-title-wrap {
  min-width: 0;
  flex: 1;
}

.record-type {
  color: #2f755b;
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.record-name {
  overflow: hidden;
  margin-top: 7rpx;
  color: #1b2a22;
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-result {
  flex-shrink: 0;
  text-align: right;
}

.result-score {
  font-size: 30rpx;
  font-weight: 900;
}

.result-amount {
  margin-top: 3rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.result-win {
  color: #1d7a51;
}

.result-loss {
  color: #b4472f;
}

.result-even {
  color: #6f7971;
}

.record-divider {
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: #e8e9e2;
}

.record-line {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 10rpx;
}

.record-label {
  flex-shrink: 0;
  width: 104rpx;
  color: #8b948d;
  font-size: 21rpx;
}

.record-value {
  min-width: 0;
  flex: 1;
  color: #526158;
  font-size: 22rpx;
  line-height: 1.5;
}

.feedback-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 26rpx;
}

.history-entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 26rpx;
}

.history-entry-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #193c2f;
  color: #fff8e5;
  font-size: 27rpx;
  font-weight: 900;
}

.history-entry-copy {
  min-width: 0;
  flex: 1;
}

.history-entry-title {
  display: block;
  color: #1b2a22;
  font-size: 28rpx;
  font-weight: 900;
}

.history-entry-desc {
  display: block;
  margin-top: 5rpx;
  color: #7d877f;
  font-size: 21rpx;
}

.history-entry-arrow {
  color: #809087;
  font-size: 48rpx;
  line-height: 1;
}

.feedback-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #e9efe4;
  color: #1d6b4f;
  font-size: 32rpx;
  font-weight: 900;
}

.feedback-copy {
  min-width: 0;
  flex: 1;
}

.feedback-title {
  color: #1b2a22;
  font-size: 28rpx;
  font-weight: 900;
}

.feedback-desc {
  margin-top: 5rpx;
  color: #7d877f;
  font-size: 21rpx;
}

.feedback-arrow {
  color: #809087;
  font-size: 48rpx;
  line-height: 1;
}
