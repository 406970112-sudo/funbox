.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 30rpx 40rpx;
  background: radial-gradient(ellipse at 90% 3%,#e9f2ff,transparent 44%),#f5f7fa;
}

.profile-hero {
  animation: fb-reveal .3s ease-out both;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 230rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1.4;
}

.hero-accent {
  color: #2d5bff;
}

.profile-art {
  width: 280rpx;
  height: 280rpx;
  margin-top: -25rpx;
}

.profile-card {
  box-sizing: border-box;
  height: 200rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
}

.avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #e9f0ff;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2d5bff;
  box-shadow: inset 0 -5rpx 0 rgba(20,58,204,.15);
  color: #fff;
  font-size: 51rpx;
  font-weight: 800;
}

.identity-copy {
  flex: 1;
  min-width: 0;
}

.identity-name,.identity-meta,.identity-date,.guest-title,.guest-desc,.history-entry-title,.history-entry-desc,.feedback-title,.feedback-desc {
  display: block;
}

.identity-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 800;
}

.identity-meta {
  margin-top: 7rpx;
  color: #66758d;
  font-size: 26rpx;
}

.identity-date {
  margin-top: 5rpx;
  color: #8490a4;
  font-size: 23rpx;
}

.loading-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2d5bff;
  animation: profile-pulse 1s ease-in-out infinite;
}

@keyframes profile-pulse {
  50% {
    opacity: .3;
  }


}

.guest-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx;
}

.guest-identity {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 18rpx;
}

.guest-copy {
  flex: 1;
  min-width: 0;
}

.guest-title {
  font-size: 30rpx;
  font-weight: 800;
}

.guest-desc {
  margin-top: 10rpx;
  color: #7b879c;
  font-size: 23rpx;
  line-height: 1.7;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff0ed;
  color: #c95744;
  font-size: 23rpx;
}

.inline-retry {
  flex-shrink: 0;
  font-weight: 800;
}

.history-entry-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 28rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: #2d5bff;
  color: #fff;
}

.history-entry-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.history-entry-title {
  font-size: 35rpx;
  font-weight: 800;
}

.history-entry-desc {
  max-width: 310rpx;
  margin-top: 8rpx;
  color: #dce7ff;
  font-size: 22rpx;
}

.history-art {
  width: 155rpx;
  height: 155rpx;
}

.history-entry-card .fb-arrow {
  color: #fff;
}

.feedback-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}

.feedback-copy {
  flex: 1;
  min-width: 0;
}

.feedback-title {
  font-size: 31rpx;
  font-weight: 800;
}

.feedback-desc {
  margin-top: 7rpx;
  color: #7b879c;
  font-size: 22rpx;
}

.feedback-art {
  width: 126rpx;
  height: 126rpx;
}

.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 25rpx;
  color: #8490a4;
  font-size: 22rpx;
}

.footer-art {
  width: 310rpx;
  height: 310rpx;
}

.profile-footer > text {
  margin-top: -10rpx;
}

@media (max-width:350px) {
  .profile-art {
    width: 250rpx;
    height: 250rpx;
  }

  .feedback-art {
    width: 100rpx;
    height: 100rpx;
  }

  .history-art {
    width: 130rpx;
    height: 130rpx;
  }


}
