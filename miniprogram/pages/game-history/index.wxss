.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 90% 5%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.hero-kicker,
.hero-title,
.hero-copy,
.empty-title,
.empty-desc,
.record-type,
.record-name,
.result-score,
.result-amount,
.record-label,
.record-value,
.page-summary {
  display: block;
}

.history-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 2rpx 28rpx;
  animation: fb-reveal 0.3s ease-out both;
}

.hero-copy-wrap {
  flex: 1;
  min-width: 0;
}

.history-art {
  width: 170rpx;
  height: 170rpx;
}

.hero-kicker {
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 12rpx;
  color: var(--fb-ink);
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hero-copy {
  margin-top: 10rpx;
  color: #66758d;
  font-size: 24rpx;
  line-height: 1.8;
}

.filter-scroll {
  width: 100%;
  margin: 4rpx 0 26rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #e8eef8;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-height: 44px;
  padding: 14rpx 8rpx;
  border-radius: 20rpx;
  color: #64738b;
  font-size: 23rpx;
  font-weight: 700;
}

.filter-active {
  background: var(--fb-primary);
  box-shadow: 0 6rpx 16rpx rgba(45, 91, 255, 0.16);
  color: var(--fb-surface);
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 280rpx;
  padding: 40rpx 30rpx;
  color: #66758d;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
  overflow-wrap: anywhere;
}

.state-action {
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: var(--fb-surface);
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: pulse 1.1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.empty-title {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.8;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  padding: 28rpx 30rpx;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-title-wrap {
  min-width: 0;
  flex: 1;
}

.record-type {
  display: inline-block;
  padding: 3rpx 14rpx;
  border-radius: 99rpx;
  background: #edf3ff;
  color: var(--fb-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.record-name {
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-result {
  max-width: 48%;
  flex-shrink: 0;
  overflow-wrap: anywhere;
  text-align: right;
}

.result-score {
  font-size: 36rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.result-amount {
  margin-top: 3rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.result-win { color: var(--fb-primary); }
.result-loss { color: #c74d38; }
.result-even { color: #66758d; }

.record-divider {
  height: 1rpx;
  margin: 24rpx 0 18rpx;
  background: var(--fb-line);
}

.record-line {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 10rpx;
}

.record-label {
  flex-shrink: 0;
  width: 104rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.record-value {
  min-width: 0;
  flex: 1;
  color: #64738b;
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.pagination {
  margin-top: 28rpx;
  padding: 26rpx 30rpx;
}

.page-summary {
  color: #66758d;
  font-size: 22rpx;
  text-align: center;
}

.page-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.page-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 48px;
  margin: 0;
  padding: 20rpx 14rpx;
  border-radius: 22rpx;
  background: #edf3ff;
  color: var(--fb-primary);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
}

.page-button-primary {
  background: var(--fb-primary);
  color: var(--fb-surface);
}

.page-button[disabled] {
  background: #eef1f7;
  color: #98a4b8;
}

@media (max-width: 350px) {
  .history-art {
    width: 140rpx;
    height: 140rpx;
  }

  .record-top {
    gap: 14rpx;
  }

  .result-score {
    font-size: 32rpx;
  }
}
