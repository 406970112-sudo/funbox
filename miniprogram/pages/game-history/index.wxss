.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 38rpx 28rpx 90rpx;
  background:
    radial-gradient(circle at 92% 4%, rgba(44, 107, 78, 0.16), transparent 32%),
    linear-gradient(180deg, #f5f1e7 0%, #f7f5ef 62%, #f0eee6 100%);
}

.hero-kicker,
.hero-title,
.hero-copy,
.empty-title,
.empty-desc,
.record-type,
.record-name,
.result-score,
.result-amount,
.record-label,
.record-value,
.page-summary {
  display: block;
}

.history-hero {
  padding: 12rpx 8rpx 24rpx;
}

.hero-kicker {
  color: #2f755b;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #14251d;
  font-size: 46rpx;
  font-weight: 900;
}

.hero-copy {
  margin-top: 10rpx;
  color: #6e786f;
  font-size: 23rpx;
  line-height: 1.6;
}

.filter-scroll {
  width: 100%;
  margin: 4rpx 0 24rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 4rpx;
}

.filter-chip {
  padding: 14rpx 25rpx;
  border: 1rpx solid #d8ded6;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.86);
  color: #667168;
  font-size: 23rpx;
  font-weight: 700;
}

.filter-active {
  border-color: #1d6b4f;
  background: #1d6b4f;
  color: #fffdf7;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 230rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  border-radius: 26rpx;
  background: rgba(255, 253, 247, 0.94);
  color: #778078;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  flex-direction: row;
  background: #fff0eb;
  color: #a34531;
}

.state-action {
  margin-left: 18rpx;
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: #2f755b;
  animation: pulse 1.1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.empty-title {
  color: #405047;
  font-size: 28rpx;
  font-weight: 900;
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #8a938c;
  font-size: 22rpx;
  line-height: 1.6;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 24rpx;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.95);
  box-shadow: 0 14rpx 34rpx rgba(40, 55, 45, 0.05);
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-title-wrap {
  min-width: 0;
  flex: 1;
}

.record-type {
  color: #2f755b;
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.record-name {
  overflow: hidden;
  margin-top: 7rpx;
  color: #1b2a22;
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-result {
  flex-shrink: 0;
  text-align: right;
}

.result-score {
  font-size: 30rpx;
  font-weight: 900;
}

.result-amount {
  margin-top: 3rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.result-win { color: #1d7a51; }
.result-loss { color: #b4472f; }
.result-even { color: #6f7971; }

.record-divider {
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: #e8e9e2;
}

.record-line {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 10rpx;
}

.record-label {
  flex-shrink: 0;
  width: 104rpx;
  color: #8b948d;
  font-size: 21rpx;
}

.record-value {
  min-width: 0;
  flex: 1;
  color: #526158;
  font-size: 22rpx;
  line-height: 1.5;
}

.pagination {
  margin-top: 26rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.94);
}

.page-summary {
  color: #667168;
  font-size: 22rpx;
  text-align: center;
}

.page-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.page-button {
  flex: 1;
  margin: 0;
  border-radius: 16rpx;
  background: #edf0e8;
  color: #526158;
  font-size: 24rpx;
  font-weight: 800;
}

.page-button-primary {
  background: #1d6b4f;
  color: #fffdf7;
}

.page-button[disabled] {
  opacity: 0.42;
}
