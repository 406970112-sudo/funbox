.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 32rpx 80rpx;
  background: radial-gradient(circle at top right, #e3ead7 0, #f4f1e8 45%, #f6f4ed 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 12rpx 8rpx 42rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 112rpx;
  border: 4rpx solid #fffdf7;
  border-radius: 18rpx;
  background: #1d6b4f;
  box-shadow: 0 14rpx 30rpx rgba(29, 107, 79, 0.2);
  color: #fff8e5;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-title,
.brand-subtitle,
.field-label,
.guest-tip {
  display: block;
}

.brand-title {
  color: #17251f;
  font-size: 42rpx;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #6d776f;
  font-size: 24rpx;
}

.auth-card {
  padding: 32rpx;
  border: 1rpx solid rgba(34, 72, 54, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 24rpx 60rpx rgba(40, 55, 45, 0.08);
}

.tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #edf0e8;
}

.tab {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  color: #6a746c;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.tab-active {
  background: #fffdf7;
  color: #1d6b4f;
  box-shadow: 0 6rpx 18rpx rgba(27, 54, 41, 0.08);
}

.field {
  margin-top: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #49564d;
  font-size: 24rpx;
  font-weight: 700;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 18rpx;
  background: #fbfaf5;
  color: #18241d;
  font-size: 28rpx;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff0eb;
  color: #b4472f;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  margin-top: 32rpx;
  border-radius: 20rpx;
  background: #1d6b4f;
  color: #fffdf7;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button[disabled] {
  background: #719384;
  color: #f8f6ef;
}

.guest-tip {
  margin-top: 24rpx;
  color: #7c857e;
  font-size: 23rpx;
  line-height: 1.65;
  text-align: center;
}
