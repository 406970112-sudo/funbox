.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 90% 5%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.auth-hero {
  padding-bottom: 28rpx;
  animation: fb-reveal .3s ease-out both;
}

.brand-caption,
.brand-subtitle,
.headline,
.field-label,
.guest-title,
.guest-tip {
  display: block;
}

.brand-caption {
  margin-top: 5rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.headline {
  font-size: 49rpx;
  font-weight: 900;
  line-height: 1.43;
  letter-spacing: -2rpx;
}

.headline-accent {
  color: var(--fb-primary);
}

.hero-art {
  width: 240rpx;
  height: 240rpx;
}

.brand-subtitle {
  color: #64738b;
  font-size: 24rpx;
  line-height: 1.7;
}

.auth-card {
  padding: 30rpx;
  animation: fb-reveal .35s ease-out both;
}

.tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 22rpx;
  background: #edf3ff;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 44px;
  border-radius: 16rpx;
  color: #64738b;
  font-size: 28rpx;
  font-weight: 800;
}

.tab-active {
  background: var(--fb-surface);
  color: var(--fb-primary);
  box-shadow: 0 6rpx 18rpx rgba(45, 91, 255, .08);
}

.field {
  margin-top: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #34425b;
  font-size: 25rpx;
  font-weight: 800;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  min-height: 44px;
  padding: 0 24rpx;
  border: 2rpx solid #e2e9f4;
  border-radius: 20rpx;
  background: #f9fbff;
  color: var(--fb-ink);
  font-size: 28rpx;
}

.field-placeholder {
  color: var(--fb-muted);
}

.password-input-wrap {
  position: relative;
}

.password-input {
  padding-right: 128rpx;
}

.password-toggle {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  min-width: 44px;
  height: 100%;
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.password-toggle-hover {
  opacity: 0.6;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff0ed;
  color: #c74d38;
  font-size: 24rpx;
  line-height: 1.7;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin: 32rpx 0 0;
  padding: 22rpx 14rpx;
  border-radius: 22rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.primary-button[disabled] {
  background: #c3d1f4;
  color: #fff;
}

.guest-note {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  border-radius: 30rpx;
  background: #e6efff;
}

.guest-copy {
  flex: 1;
  min-width: 0;
}

.guest-title {
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.guest-tip {
  margin-top: 6rpx;
  color: #64738b;
  font-size: 23rpx;
  line-height: 1.7;
}

@media (max-width: 350px) {
  .headline {
    font-size: 45rpx;
  }

  .hero-art {
    width: 220rpx;
    height: 220rpx;
  }
}
