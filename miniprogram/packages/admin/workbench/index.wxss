@import "../shared.wxss";

.workbench-hero {
  margin-bottom: 22rpx;
  padding: 28rpx 26rpx 22rpx;
  border-color: #dce7ff;
  background: linear-gradient(145deg, #ffffff 0%, #f4f8ff 54%, #e7efff 100%);
  box-shadow: 0 12rpx 32rpx rgba(45, 91, 255, .07);
}

.workbench-head-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.workbench-title {
  color: var(--fb-ink);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -0.8rpx;
}

.workbench-role {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #edf2fb;
  color: var(--fb-ink-secondary);
  font-size: 22rpx;
  font-weight: 800;
}

.workbench-role--owner {
  background: #e2ebff;
  color: var(--fb-primary);
}

.workbench-kpi-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.workbench-kpi {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .85);
  background: rgba(255, 255, 255, .82);
}

.workbench-kpi-val {
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.workbench-kpi-val--danger {
  color: var(--fb-danger);
}

.workbench-kpi-val--warn {
  color: #b86614;
}

.workbench-kpi-label {
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 600;
}

.workbench-id-bar {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(45, 91, 255, .1);
}

.workbench-id-copy {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 54rpx;
}

.workbench-id-label {
  color: var(--fb-muted);
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.workbench-id-code {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--fb-ink-secondary);
  font-size: 22rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.workbench-id-action {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e2ebff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.workbench-account {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.5;
}

.workbench-featured {
  border-color: #d2e0ff;
}

.workbench-icon {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #f5f8ff, #e5edff);
}

.workbench-icon--feedback {
  background: linear-gradient(145deg, #fff8f2, #ffecdf);
}

.workbench-icon--users {
  background: linear-gradient(145deg, #f3faf6, #e0f5e9);
}

.workbench-icon--grants {
  background: linear-gradient(145deg, #f8f4ff, #eee6ff);
}

.workbench-icon-art {
  position: absolute;
  top: 0;
  left: 0;
  width: 144rpx;
  height: 144rpx;
}

.workbench-icon--feedback .workbench-icon-art { left: -72rpx; }
.workbench-icon--users .workbench-icon-art { top: -72rpx; }
.workbench-icon--grants .workbench-icon-art { top: -72rpx; left: -72rpx; }
