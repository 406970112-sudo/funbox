<import src="../state.wxml" />
<view class="admin-page">
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <block wx:if="{{ready}}">
    <view class="fb-card workbench-hero">
      <view class="admin-split">
        <view class="workbench-head-copy">
          <text class="fb-brand">FUNBOX ADMIN</text>
          <text class="workbench-title">小程序工作台</text>
        </view>
        <text class="workbench-role {{owner ? 'workbench-role--owner' : ''}}">{{owner ? '负责人' : '运营人员'}}</text>
      </view>

      <view wx:if="{{quickStats.length}}" class="workbench-kpi-grid">
        <view
          wx:for="{{quickStats}}"
          wx:key="id"
          class="workbench-kpi"
          hover-class="fb-tap-btn"
          data-id="{{item.id}}"
          bindtap="openModule"
          role="button"
        >
          <text class="workbench-kpi-val workbench-kpi-val--{{item.accent}}">{{item.value}}</text>
          <text class="workbench-kpi-label">{{item.label}}</text>
        </view>
      </view>

      <view class="workbench-id-bar">
        <view wx:if="{{userId}}" class="workbench-id-copy" bindtap="copyMyId" hover-class="fb-tap-btn" role="button">
          <text class="workbench-id-label">我的 FunBox ID</text>
          <text class="workbench-id-code">{{userId}}</text>
          <text class="workbench-id-action">复制</text>
        </view>
        <button wx:else class="workbench-account" hover-class="fb-tap-btn" bindtap="openProfileSettings">我的 FunBox ID <text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="admin-stack">
      <view
        wx:for="{{modules}}"
        wx:key="id"
        class="fb-card admin-row {{item.id === 'features' ? 'workbench-featured' : ''}}"
        hover-class="fb-tap-row"
        data-id="{{item.id}}"
        bindtap="openModule"
        role="button"
        aria-label="{{item.title}}"
      >
        <view class="workbench-icon workbench-icon--{{item.id}}" aria-hidden="true">
          <view class="workbench-glyph workbench-glyph--{{item.id}}"></view>
        </view>
        <view class="admin-grow">
          <text class="admin-item-title">{{item.title}}</text>
          <text class="admin-meta">{{item.description}}</text>
        </view>
        <text wx:if="{{item.badge}}" class="admin-pill admin-pill--{{item.badgeTone}}">{{item.badge}}</text>
        <text class="fb-arrow" aria-hidden="true">›</text>
      </view>
    </view>
  </block>
</view>
