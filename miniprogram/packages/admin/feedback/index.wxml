<import src="../state.wxml" />
<view class="admin-page">
  <view class="admin-page-head">
    <text class="admin-heading">反馈处理</text>
    <view wx:if="{{ready}}" class="admin-count-pill">共 {{total}} 条</view>
  </view>
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <block wx:if="{{ready}}">
    <view class="admin-search-row">
      <view class="admin-search-box">
        <input class="admin-search-input" placeholder-class="admin-placeholder" placeholder="搜索反馈内容或标题" maxlength="100"
          value="{{search}}" bindinput="editSearch" bindconfirm="searchFeedback" confirm-type="search" aria-label="搜索反馈内容" />
        <view wx:if="{{search || submitted}}" class="admin-search-clear" hover-class="fb-tap-btn" bindtap="clearSearch" role="button" aria-label="清空搜索"></view>
      </view>
      <view class="admin-search-btn" hover-class="fb-tap-btn" bindtap="searchFeedback" role="button">搜索</view>
    </view>

    <scroll-view class="admin-tab-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="admin-tab-row" role="group" aria-label="反馈状态">
        <view wx:for="{{filters}}" wx:key="id" class="admin-chip {{status === item.id ? 'admin-chip--active' : ''}}"
          hover-class="fb-tap-btn" data-status="{{item.id}}" bindtap="chooseStatus" role="button" aria-pressed="{{status === item.id}}">{{item.label}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{refreshing}}" class="admin-refreshing-bar">正在刷新列表…</view>

    <view wx:if="{{!items.length}}" class="fb-card admin-state">
      <text class="admin-item-title">{{status === 'pending' && !submitted ? '太棒了，当前没有待处理反馈' : '没有匹配的反馈记录'}}</text>
      <text class="admin-muted">{{submitted ? '试试更换搜索关键词或切换到「全部」状态查看。' : '下拉页面可重新同步最新反馈。'}}</text>
    </view>
    <view wx:else class="admin-stack">
      <view wx:for="{{items}}" wx:key="id" class="fb-card feedback-card" hover-class="fb-tap-row"
        data-id="{{item.id}}" bindtap="openFeedback" role="button" aria-label="查看反馈">
        <view class="admin-grow">
          <view class="feedback-top">
            <text class="admin-item-title feedback-headline">{{item.headline}}</text>
            <view class="admin-pill admin-pill--{{item.status}}">{{item.statusLabel}}</view>
          </view>
          <text wx:if="{{item.excerpt}}" class="feedback-excerpt">{{item.excerpt}}</text>
          <view class="feedback-foot">
            <text class="admin-meta">{{item.author}}<text wx:if="{{item.timestamp}}"> · {{item.timestamp}}</text></text>
            <view wx:if="{{item.imageCount}}" class="feedback-img-tag">含 {{item.imageCount}} 图</view>
          </view>
        </view>
        <view class="admin-chevron" aria-hidden="true"></view>
      </view>
      <button wx:if="{{offset < total}}" class="admin-secondary" hover-class="fb-tap-btn" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMore">加载更多（{{items.length}} / {{total}}）</button>
      <text wx:elif="{{items.length > 5}}" class="admin-list-end">已展示全部 {{items.length}} 条反馈</text>
    </view>
  </block>
</view>
