<import src="../state.wxml" />
<view class="admin-page">
  <view class="admin-page-head">
    <text class="admin-heading">管理员授权</text>
    <view wx:if="{{ready}}" class="admin-count-pill">{{grantsTotal}} 位管理员</view>
  </view>
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <view wx:if="{{ready}}" class="admin-stack">
    <view class="fb-card admin-panel admin-stack">
      <view class="admin-split">
        <text class="admin-item-title">按 FunBox ID 授权</text>
        <view class="admin-link {{busy ? 'admin-link--disabled' : ''}}" hover-class="fb-tap-btn" bindtap="pasteUserId" role="button">粘贴 ID</view>
      </view>
      <view class="admin-search-row grant-search-row">
        <view class="admin-search-box">
          <input class="admin-search-input" placeholder="输入完整 FunBox ID" placeholder-class="admin-placeholder" value="{{userId}}"
            maxlength="100" disabled="{{busy}}" bindinput="editUserId" bindconfirm="findUser" confirm-type="search" aria-label="FunBox ID" />
          <view wx:if="{{userId}}" class="admin-search-clear" hover-class="fb-tap-btn" bindtap="clearUserId" role="button" aria-label="清空"></view>
        </view>
        <view class="admin-search-btn {{busy ? 'admin-link--disabled' : ''}}" hover-class="fb-tap-btn" bindtap="findUser" role="button">查找</view>
      </view>

      <block wx:if="{{target}}">
        <view class="grant-target-box">
          <view class="admin-split">
            <text class="admin-item-title">{{target.displayName}}</text>
            <view class="admin-pill {{target.owner ? 'admin-pill--primary' : 'admin-pill--muted'}}">{{target.owner ? '负责人' : target.accountLabel}}</view>
          </view>
          <text class="admin-code grant-target-id" user-select>{{target.id}}</text>

          <text wx:if="{{target.owner}}" class="admin-meta">负责人权限由服务器维护，无需在此修改。</text>
          <view wx:else class="perm-list">
            <view
              wx:for="{{permissions}}"
              wx:key="id"
              class="perm-row {{item.checked ? 'perm-row--active' : ''}}"
              hover-class="fb-tap-row"
              data-id="{{item.id}}"
              bindtap="togglePermission"
              role="checkbox"
              aria-checked="{{item.checked}}"
            >
              <view class="perm-check {{item.checked ? 'perm-check--on' : ''}}">
                <view wx:if="{{item.checked}}" class="admin-tick" aria-hidden="true"></view>
              </view>
              <view class="admin-grow">
                <view class="perm-title-row">
                  <text class="perm-label">{{item.label}}</text>
                  <view wx:if="{{item.lockedByDep}}" class="perm-dep-tag">联动必选</view>
                </view>
                <text class="perm-hint">{{item.hint}}</text>
              </view>
            </view>
          </view>
        </view>
        <button wx:if="{{!target.owner}}" class="admin-primary" hover-class="fb-tap-btn" disabled="{{busy || !selected.length}}" loading="{{busy}}" bindtap="saveGrant">确认保存授权</button>
      </block>
    </view>

    <view class="admin-seg" role="tablist">
      <view class="admin-seg-item {{activeTab === 'grants' ? 'admin-seg-item--active' : ''}}" hover-class="fb-tap-btn" data-tab="grants" bindtap="switchTab">已授权账号（{{grantsTotal}}）</view>
      <view class="admin-seg-item {{activeTab === 'history' ? 'admin-seg-item--active' : ''}}" hover-class="fb-tap-btn" data-tab="history" bindtap="switchTab">授权记录（{{auditTotal}}）</view>
    </view>

    <view wx:if="{{activeTab === 'grants'}}" class="fb-card admin-panel">
      <text wx:if="{{!grants.length}}" class="admin-muted">暂无运营人员授权</text>
      <view wx:for="{{grants}}" wx:key="id" class="admin-field">
        <view class="admin-split">
          <text class="admin-item-title">{{item.user.displayName}}</text>
          <view class="admin-pill {{item.owner ? 'admin-pill--primary' : 'admin-pill--svip'}}">{{item.owner ? '负责人' : '运营人员'}}</view>
        </view>
        <text class="admin-code grant-row-id" user-select>{{item.user.id}}</text>
        <text class="admin-meta">{{item.labels}}</text>
        <view wx:if="{{!item.owner}}" class="grant-actions">
          <view class="admin-link {{busy ? 'admin-link--disabled' : ''}}" hover-class="fb-tap-btn" data-id="{{item.user.id}}" bindtap="editGrant" role="button">编辑权限</view>
          <view class="admin-link admin-link--danger {{busy ? 'admin-link--disabled' : ''}}" hover-class="fb-tap-btn" data-id="{{item.user.id}}" bindtap="revokeGrant" role="button">撤销</view>
        </view>
      </view>
      <button wx:if="{{grantsOffset < grantsTotal}}" class="admin-secondary" hover-class="fb-tap-btn" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMoreGrants">加载更多（{{grants.length}} / {{grantsTotal}}）</button>
    </view>

    <view wx:else class="fb-card admin-panel">
      <text wx:if="{{!changes.length}}" class="admin-muted">暂无授权变更记录</text>
      <view wx:for="{{changes}}" wx:key="key" class="admin-field">
        <view class="admin-split">
          <view class="grant-audit-head">
            <view class="admin-pill {{item.labels ? 'admin-pill--primary' : 'admin-pill--danger'}}">{{item.labels ? '更新权限' : '撤销权限'}}</view>
            <text class="admin-item-title">{{item.targetName}}</text>
          </view>
          <text class="admin-meta">{{item.date}}</text>
        </view>
        <text wx:if="{{item.labels}}" class="admin-meta">权限：{{item.labels}}</text>
        <text class="admin-meta">操作人：{{item.operatorName}}</text>
        <text class="admin-code">账号 ID：{{item.userId}}</text>
      </view>
      <button wx:if="{{auditOffset < auditTotal}}" class="admin-secondary" hover-class="fb-tap-btn" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMoreHistory">加载更多（{{changes.length}} / {{auditTotal}}）</button>
    </view>
  </view>
</view>
