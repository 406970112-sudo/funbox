<import src="../state.wxml" />
<view class="admin-page">
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <view wx:if="{{ready}}" class="admin-stack">
    <view class="fb-card admin-panel admin-stack">
      <view class="admin-split">
        <text class="detail-hero-title">{{item.title || '用户反馈'}}</text>
        <text class="admin-pill admin-pill--{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="admin-split">
        <view class="admin-grow">
          <text class="admin-muted">{{item.user.displayName || '用户'}}</text>
          <text class="admin-meta">{{item.timestamp}}</text>
        </view>
        <button wx:if="{{showUser}}" class="admin-link" hover-class="fb-tap-btn" bindtap="openUser">查看账号 ›</button>
      </view>
      <view class="detail-body-box">
        <text class="admin-copy" selectable user-select>{{item.description}}</text>
      </view>
      <view wx:if="{{item.images.length}}" class="admin-attachments">
        <view class="attachments-head">
          <text class="admin-meta">反馈截图（{{item.images.length}} 张，点击可滑动连看）</text>
        </view>
        <view class="attachments-grid">
          <button
            wx:for="{{item.images}}"
            wx:key="id"
            class="attachment-btn"
            hover-class="fb-tap-btn"
            data-index="{{index}}"
            disabled="{{busy}}"
            bindtap="openImage"
          >查看截图 {{item.images.length > 1 ? index + 1 : ''}}</button>
        </view>
      </view>
    </view>

    <view class="fb-card admin-panel admin-stack">
      <view class="admin-split">
        <text class="admin-item-title">回复用户</text>
        <text class="reply-counter {{replyTrimLength > 0 && replyTrimLength < 10 || replyTrimLength > 1000 ? 'reply-counter--warn' : ''}}">
          {{replyTrimLength > 0 && replyTrimLength < 10 ? '还差 ' + (10 - replyTrimLength) + ' 字 · ' : ''}}{{replyLength}} / 1000
        </text>
      </view>

      <view class="admin-quick-row">
        <view
          wx:for="{{quickReplies}}"
          wx:key="label"
          class="admin-quick-chip"
          hover-class="fb-tap-btn"
          data-text="{{item.text}}"
          bindtap="useQuickReply"
          role="button"
        >{{item.label}}</view>
      </view>

      <textarea
        class="admin-textarea"
        placeholder-class="admin-placeholder"
        placeholder="填写处理结果（10～1000 字，或点击上方快捷回复）"
        value="{{reply}}"
        maxlength="-1"
        disabled="{{busy}}"
        bindinput="editReply"
        aria-label="回复用户"
      />
      <text wx:if="{{replyError}}" class="admin-inline-error">{{replyError}}</text>
      <text wx:if="{{item.replyTimestamp}}" class="admin-meta">上次回复于 {{item.replyTimestamp}}</text>

      <view class="reply-actions">
        <button wx:if="{{item.status === 'pending'}}" class="admin-secondary" hover-class="fb-tap-btn" disabled="{{busy}}" bindtap="markProcessing">先标处理中</button>
        <button class="admin-primary" hover-class="fb-tap-btn" disabled="{{busy}}" loading="{{busy}}" bindtap="submitReply">{{item.status === 'resolved' ? '更新回复' : '回复并标记已处理'}}</button>
      </view>
    </view>
  </view>
</view>
