<import src="../state.wxml" />
<view class="admin-page">
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <view wx:if="{{ready}}" class="admin-stack">
    <view class="fb-card admin-panel">
      <view class="admin-split"><text class="admin-item-title">{{feature.name}}</text><text class="admin-pill admin-pill--{{feature.tone}}">{{feature.statusLabel}}</text></view>
      <text class="admin-meta">{{feature.placementLabel}}</text>
    </view>
    <view class="fb-card admin-panel">
      <view class="admin-field admin-split">
        <view class="admin-grow"><text class="admin-item-title">展示功能入口</text><text class="admin-meta">关闭后隐藏此功能在各处的入口</text></view>
        <switch aria-label="展示功能入口" color="#2d5bff" checked="{{draft.enabled}}" disabled="{{busy}}" bindchange="changeEnabled" />
      </view>
      <view class="admin-field">
        <text class="admin-item-title">展示位置</text>
        <checkbox-group class="admin-location-options" bindchange="changePlacements">
          <label wx:for="{{placements}}" wx:key="id" class="admin-choice">
            <checkbox value="{{item.id}}" color="#2d5bff" checked="{{item.checked}}" disabled="{{busy}}" /><text>{{item.name}}</text>
          </label>
        </checkbox-group>
      </view>
      <picker class="admin-field admin-picker" mode="selector" range="{{audiences}}" range-key="label" value="{{audienceIndex}}"
        disabled="{{busy}}" bindchange="changeAudience" aria-label="开放对象">
        <view class="admin-split"><text class="admin-item-title">开放给</text><text class="admin-muted">{{audiences[audienceIndex].label}} ›</text></view>
      </picker>
      <view class="admin-field admin-split">
        <view class="admin-grow">
          <text class="admin-item-title">维护停用</text>
          <text class="admin-meta">{{feature.id === 'mahjong' || feature.id === 'poker' || feature.id === 'general' ? '暂停创建新牌局，进行中的牌局可继续' : '打开此功能时提示维护中'}}</text>
        </view>
        <switch aria-label="维护停用" color="#2d5bff" checked="{{draft.maintenance}}" disabled="{{busy}}" bindchange="changeMaintenance" />
      </view>
    </view>
    <button class="admin-primary" hover-class="fb-tap-btn" disabled="{{busy || !changed}}" loading="{{busy}}" bindtap="publish">发布设置</button>
  </view>
</view>
