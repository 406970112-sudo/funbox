<import src="../state.wxml" />
<view class="admin-page">
  <view class="admin-page-head">
    <text class="admin-heading">用户管理</text>
    <view wx:if="{{ready}}" class="admin-count-pill">共 {{total}} 人</view>
  </view>
  <template is="admin-state" data="{{loading, ready, denied, error}}" />
  <block wx:if="{{ready}}">
    <view class="admin-search-row">
      <view class="admin-search-box">
        <input class="admin-search-input" placeholder-class="admin-placeholder" placeholder="搜索昵称或完整 FunBox ID" maxlength="100"
          value="{{search}}" bindinput="editSearch" bindconfirm="searchUsers" confirm-type="search" aria-label="搜索昵称或 FunBox ID" />
        <view wx:if="{{search || submitted}}" class="admin-search-clear" hover-class="fb-tap-btn" bindtap="clearSearch" role="button" aria-label="清空搜索"></view>
      </view>
      <view class="admin-search-btn" hover-class="fb-tap-btn" bindtap="searchUsers" role="button">搜索</view>
    </view>

    <scroll-view class="admin-tab-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="admin-tab-row" role="group" aria-label="会员身份">
        <view wx:for="{{filters}}" wx:key="id" class="admin-chip {{role === item.id ? 'admin-chip--active' : ''}}"
          hover-class="fb-tap-btn" data-role="{{item.id}}" bindtap="chooseRole" role="button" aria-pressed="{{role === item.id}}">{{item.label}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{refreshing}}" class="admin-refreshing-bar">正在刷新列表…</view>

    <view wx:if="{{!items.length}}" class="fb-card admin-state">
      <text class="admin-muted">没有找到匹配的用户</text>
      <view wx:if="{{submitted || role}}" class="admin-secondary admin-state-btn" hover-class="fb-tap-btn" bindtap="clearSearch" role="button">清空搜索</view>
    </view>
    <view wx:else class="admin-stack">
      <view wx:for="{{items}}" wx:key="id" class="fb-card admin-row" hover-class="fb-tap-row" data-id="{{item.id}}" bindtap="openUser" role="button">
        <image wx:if="{{item.avatar}}" class="admin-avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load />
        <view wx:else class="admin-avatar">{{item.avatarMark}}</view>
        <view class="admin-grow">
          <text class="admin-item-title">{{item.displayName}}</text>
          <text class="admin-meta">{{item.accountLabel}}<text wx:if="{{item.maskedUsername && item.accountType !== 'wechat'}}"> · {{item.maskedUsername}}</text></text>
        </view>
        <view class="admin-pill admin-pill--{{item.roleTone}}">{{item.roleLabel}}</view>
        <view class="admin-chevron" aria-hidden="true"></view>
      </view>
      <button wx:if="{{offset < total}}" class="admin-secondary" hover-class="fb-tap-btn" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMore">加载更多（{{items.length}} / {{total}}）</button>
      <text wx:elif="{{items.length > 5}}" class="admin-list-end">已展示全部 {{items.length}} 位用户</text>
    </view>
  </block>
</view>
