@import "../shared.wxss";

.user-identity {
  padding: 0;
  min-height: 76rpx;
}

.user-id-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f5f8fd;
}

.user-id-label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--fb-subtle);
  font-size: 21rpx;
  font-weight: 700;
}

.user-grant-btn {
  min-height: 76rpx;
  font-size: 25rpx;
}

.user-role-pill {
  flex: 1;
}

.reason-counter {
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.reason-counter--warn {
  color: var(--fb-danger);
  font-weight: 700;
}

.user-reason-area {
  min-height: 136rpx;
}

.user-history-head {
  margin-bottom: 14rpx;
}

.user-history-title {
  margin-bottom: 0;
}

.user-change-reason {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: #f6f8fd;
  font-size: 24rpx;
}
