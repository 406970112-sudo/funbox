@import "../shared.wxss";

.history-page {
  min-height: 100vh;
  padding: 18rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--fb-canvas);
}

.game-scroll {
  width: 100%;
  white-space: nowrap;
}

.game-pills {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0 12rpx;
}

.game-pill {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--fb-ink-secondary);
  font-size: 25rpx;
  font-weight: 700;
  border: 1rpx solid #e4ebf6;
  flex-shrink: 0;
}

.game-pill-active {
  background: var(--fb-primary);
  color: #ffffff;
  border-color: var(--fb-primary);
  box-shadow: 0 8rpx 20rpx rgba(45, 91, 255, .24);
}

.filter-panel {
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23, 33, 57, .05);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f3f6fb;
}

.search-icon {
  color: var(--fb-subtle);
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  color: var(--fb-ink);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.search-placeholder {
  color: #96a2b6;
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #dde5f2;
  color: #5b6880;
  font-size: 26rpx;
  font-weight: 700;
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: var(--fb-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.range-scroll {
  margin-top: 16rpx;
  width: 100%;
  white-space: nowrap;
}

.range-chips {
  display: inline-flex;
  gap: 10rpx;
}

.range-chip {
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: #f3f6fb;
  color: var(--fb-muted);
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.range-chip-active {
  background: #eaf1ff;
  color: var(--fb-primary);
  font-weight: 800;
}

.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 0 4rpx;
}

.summary-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.summary-game {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.summary-count {
  color: var(--fb-subtle);
  font-size: 23rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.history-row {
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(23, 33, 57, .05);
}

.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.row-issue-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.row-issue {
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.row-date {
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.row-meta {
  color: var(--fb-muted);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.row-chevron {
  color: #a6b2c6;
  font-size: 32rpx;
  line-height: 1;
}

.row-balls {
  margin-top: 16rpx;
}

.list-footer {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.load-more-btn {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: var(--fb-primary);
  font-size: 26rpx;
  font-weight: 800;
  border: 1rpx solid #dce6f7;
}

.end-note {
  padding: 12rpx 0;
  color: var(--fb-subtle);
  font-size: 22rpx;
}

.state-mark-neutral {
  background: #eaf1ff;
  color: var(--fb-primary);
}

.skel-head {
  width: 240rpx;
  height: 30rpx;
  border-radius: 10rpx;
}

.skel-balls {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.skel-ball {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
}
