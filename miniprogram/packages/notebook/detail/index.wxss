.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 2%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.detail-context-row,
.detail-context-main,
.detail-audio-card,
.detail-actionbar,
.detail-action,
.detail-card-head {
  display: flex;
  align-items: center;
}

.detail-context-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 56rpx;
}

.detail-context-main {
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
  overflow: hidden;
}

.detail-book-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 4rpx;
}

.detail-book-name {
  max-width: 230rpx;
  overflow: hidden;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-context-separator {
  flex-shrink: 0;
  color: #b2bdcc;
  font-size: 21rpx;
}

.detail-updated {
  flex-shrink: 0;
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 600;
}

.detail-status {
  flex-shrink: 0;
  padding: 3rpx 9rpx;
  border-radius: 7rpx;
  background: #fff0ed;
  color: #c95e49;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.35;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 52rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #748398;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  box-shadow: 0 5rpx 14rpx rgba(38, 76, 133, 0.035);
}

.more-button-pressed {
  background: #eef3fa;
  transform: scale(0.97);
}

.detail-heading {
  margin-top: 10rpx;
}

.detail-title-wrap {
  position: relative;
  padding-left: 18rpx;
}

.detail-title-wrap::before {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  left: 0;
  width: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #5c82ff, var(--fb-primary) 58%, #214bdb);
  box-shadow: 0 8rpx 18rpx rgba(45, 91, 255, 0.2);
  content: "";
}

.detail-title {
  display: block;
  color: var(--fb-ink);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: -2rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-left: 18rpx;
}

.detail-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 13rpx;
  background: #fff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 1rpx rgba(222, 231, 245, 0.9), 0 5rpx 14rpx rgba(38, 76, 133, 0.025);
}

.detail-summary {
  display: block;
  margin-top: 14rpx;
  padding-left: 18rpx;
  color: #7c899c;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.detail-body-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
}

.detail-body {
  display: block;
  color: #4e5e78;
  font-size: 27rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.detail-check-card,
.detail-media-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
}

.detail-card-head {
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-card-title {
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 900;
}

.detail-card-count {
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-check-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 62rpx;
  border-bottom: 1rpx solid #eef2f8;
}

.detail-check-row:last-child {
  border-bottom: 0;
}

.detail-check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 3rpx solid #ccd7e7;
  border-radius: 10rpx;
  background: #fff;
}

.detail-check-done {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
}

.detail-check-mark {
  width: 15rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  opacity: 0;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.detail-check-done .detail-check-mark {
  opacity: 1;
}

.detail-check-text {
  color: #53627a;
  font-size: 24rpx;
}

.detail-check-text-done {
  color: #98a4b6;
  text-decoration: line-through;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-image-tile {
  height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef3fa;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #9aa7b8;
  font-size: 21rpx;
}

.detail-audio-card {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.detail-audio-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--fb-primary);
}

.detail-audio-playing {
  background: #20a97a;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.detail-audio-copy {
  flex: 1;
  min-width: 0;
}

.detail-audio-title {
  display: block;
  color: var(--fb-ink);
  font-size: 25rpx;
  font-weight: 800;
}

.detail-audio-meta {
  display: block;
  margin-top: 3rpx;
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-actionbar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 4;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 14rpx 38rpx rgba(30, 58, 113, 0.13);
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 84rpx;
  gap: 4rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 4rpx 0;
  border-radius: 19rpx;
  background: transparent;
  color: #6d7c93;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  transition: background 0.16s ease, transform 0.12s ease;
}

.detail-action-pressed {
  background: #f4f7fd;
  transform: scale(0.98);
}

.detail-action-active {
  color: #c95e49;
}

.detail-primary .detail-action-label {
  color: var(--fb-primary);
  font-weight: 800;
}

button.detail-share {
  width: auto;
  min-height: 84rpx;
  padding: 4rpx 0;
  background: transparent;
  color: #6d7c93;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.detail-action-label {
  display: block;
  max-width: 100%;
  overflow: hidden;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-tool {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 38rpx;
  overflow: visible;
  border-radius: 13rpx;
  box-shadow: inset 0 -4rpx 0 rgba(23, 33, 57, 0.045);
  transition: background 0.16s ease, box-shadow 0.16s ease;
}

.detail-tool-favorite {
  background: #fff0ed;
}

.detail-action-active .detail-tool-favorite {
  background: #ffe5df;
  box-shadow: inset 0 -4rpx 0 rgba(194, 72, 51, 0.06), 0 5rpx 12rpx rgba(255, 118, 94, 0.09);
}

.detail-action-active .detail-action-label {
  color: #c95e49;
}

.detail-tool-share {
  background: #e8f7f1;
}

.detail-tool-edit {
  background: #eaf2ff;
}

.detail-tool-image {
  display: block;
  width: 38rpx;
  height: 32rpx;
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 320rpx;
  padding: 40rpx;
  color: #66758d;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.login-card {
  min-height: 620rpx;
  margin-top: 24rpx;
  padding: 48rpx 32rpx;
}

.login-art {
  position: relative;
  width: 230rpx;
  height: 205rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.detail-encrypted-pill {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  min-height: 44rpx;
  margin-top: 14rpx;
  padding: 0 14rpx;
  border: 2rpx solid #f2d8a4;
  border-radius: 999rpx;
  background: #fffaf0;
  color: #a66b0b;
  font-size: 20rpx;
  font-weight: 800;
}

.detail-encrypted-mark {
  display: block;
  flex: 0 0 16rpx;
  width: 16rpx;
  height: 23rpx;
}

.detail-lock-card {
  position: relative;
  height: 390rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 76% 38%, rgba(255, 255, 255, 0.92) 0 16%, transparent 16.4%),
    linear-gradient(142deg, #e8f1ff 0%, #dbe9ff 53%, #cfdffd 100%);
  box-shadow: 0 16rpx 34rpx rgba(45, 91, 255, 0.065);
}

.detail-lock-card::before {
  position: absolute;
  right: -60rpx;
  bottom: -88rpx;
  width: 300rpx;
  height: 300rpx;
  border: 2rpx solid rgba(93, 126, 209, 0.15);
  border-radius: 50%;
  content: "";
}

.detail-lock-card::after {
  position: absolute;
  top: 64rpx;
  left: -54rpx;
  width: 164rpx;
  height: 164rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
  content: "";
}

.detail-lock-sheet {
  position: absolute;
  z-index: 2;
  top: 112rpx;
  right: 72rpx;
  width: 132rpx;
  height: 168rpx;
  border-radius: 16rpx 24rpx 24rpx 16rpx;
  background: linear-gradient(145deg, #ffffff, #f2f6fd 78%, #e5edf9);
  box-shadow: 16rpx 20rpx 38rpx rgba(53, 79, 139, 0.13);
}

.detail-lock-sheet-back {
  top: 92rpx;
  right: 52rpx;
  width: 144rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.66);
  transform: rotate(9deg);
}

.detail-lock-sheet-front {
  transform: rotate(-5deg);
}

.detail-lock-lines {
  position: absolute;
  top: 40rpx;
  left: 23rpx;
  width: 65rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #b9cff8;
  box-shadow: 0 24rpx 0 #d9e5fa, 0 48rpx 0 #e3ebf8;
}

.detail-lock-badge {
  position: absolute;
  z-index: 5;
  top: 212rpx;
  right: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  background: linear-gradient(145deg, #5a80ff, #2d5bff 50%, #1f46d1 100%);
  box-shadow:
    inset 5rpx 5rpx 0 rgba(255, 255, 255, 0.19),
    inset -7rpx -8rpx 0 rgba(10, 31, 132, 0.16),
    0 20rpx 36rpx rgba(45, 91, 255, 0.25);
  transform: rotate(-4deg);
}

.detail-lock-badge-image {
  display: block;
  width: 80rpx;
  height: 106rpx;
}

.detail-lock-label {
  position: absolute;
  z-index: 6;
  top: 24rpx;
  left: 24rpx;
  padding: 9rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #52637b;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.detail-lock-copy {
  display: block;
  margin-top: 28rpx;
}

.detail-lock-title {
  display: block;
  color: var(--fb-ink);
  font-size: 45rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1.3;
}

.detail-lock-desc {
  display: block;
  max-width: 570rpx;
  margin-top: 10rpx;
  color: #687890;
  font-size: 23rpx;
  line-height: 1.7;
}

.detail-unlock-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  gap: 12rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 26rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 92rpx;
  box-shadow: 0 16rpx 30rpx rgba(45, 91, 255, 0.2);
}

.detail-unlock-button-pressed {
  opacity: 0.88;
  transform: scale(0.99);
}

.detail-unlock-icon {
  display: block;
  width: 28rpx;
  height: 40rpx;
}

.detail-lock-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
  color: #8794a7;
  font-size: 20rpx;
}

.detail-lock-meta-chip {
  padding: 5rpx 12rpx;
  border-radius: 9rpx;
  background: #fff;
  color: #9a7561;
}

.unlock-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 27, 55, 0.42);
}

.unlock-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  box-shadow: 0 -20rpx 52rpx rgba(21, 40, 82, 0.16);
}

.unlock-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 99rpx;
  background: #dce3ee;
}

.unlock-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.unlock-head-copy {
  flex: 1;
  min-width: 0;
}

.unlock-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 23rpx;
  background: #fff4dc;
}

.unlock-badge-image {
  display: block;
  width: 38rpx;
  height: 52rpx;
}

.unlock-title {
  display: block;
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.unlock-caption {
  display: block;
  margin-top: 5rpx;
  color: #718097;
  font-size: 21rpx;
}

.unlock-field-label {
  display: block;
  margin: 30rpx 0 10rpx;
  color: #586980;
  font-size: 21rpx;
  font-weight: 700;
}

.unlock-input {
  width: 100%;
  height: 94rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #dfe7f4;
  border-radius: 24rpx;
  background: #fbfcff;
  color: var(--fb-ink);
  font-size: 26rpx;
  letter-spacing: 3rpx;
}

.unlock-input-error {
  border-color: #efb5aa;
  background: #fffafa;
}

.unlock-placeholder {
  color: #a1adbd;
  letter-spacing: 0;
}

.unlock-error {
  display: block;
  margin-top: 12rpx;
  color: #c9533e;
  font-size: 21rpx;
}

.unlock-primary {
  width: 100%;
  min-height: 92rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 25rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 92rpx;
}

.unlock-primary-busy {
  opacity: 0.68;
}

.unlock-forgot {
  width: 100%;
  min-height: 70rpx;
  margin: 8rpx 0 0;
  padding: 0;
  background: #f7f9fd;
  color: #7f8ca0;
  font-size: 21rpx;
  line-height: 70rpx;
  border-radius: 18rpx;
}

.unlock-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #f3f6fb;
  color: #8491a4;
  font-size: 34rpx;
  line-height: 1;
}
