.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 2%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.detail-context-row,
.detail-context-main,
.detail-audio-card,
.detail-actionbar,
.detail-action,
.detail-card-head {
  display: flex;
  align-items: center;
}

.detail-context-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 56rpx;
}

.detail-context-main {
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
  overflow: hidden;
}

.detail-book-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 4rpx;
}

.detail-book-name {
  max-width: 230rpx;
  overflow: hidden;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-context-separator {
  flex-shrink: 0;
  color: #b2bdcc;
  font-size: 21rpx;
}

.detail-updated {
  flex-shrink: 0;
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 600;
}

.detail-status {
  flex-shrink: 0;
  padding: 3rpx 9rpx;
  border-radius: 7rpx;
  background: #fff0ed;
  color: #c95e49;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.35;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 52rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #748398;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  box-shadow: 0 5rpx 14rpx rgba(38, 76, 133, 0.035);
}

.more-button-pressed {
  background: #eef3fa;
  transform: scale(0.97);
}

.detail-heading {
  margin-top: 10rpx;
}

.detail-title-wrap {
  position: relative;
  padding-left: 18rpx;
}

.detail-title-wrap::before {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  left: 0;
  width: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #5c82ff, var(--fb-primary) 58%, #214bdb);
  box-shadow: 0 8rpx 18rpx rgba(45, 91, 255, 0.2);
  content: "";
}

.detail-title {
  display: block;
  color: var(--fb-ink);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: -2rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-left: 18rpx;
}

.detail-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 13rpx;
  background: #fff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 1rpx rgba(222, 231, 245, 0.9), 0 5rpx 14rpx rgba(38, 76, 133, 0.025);
}

.detail-summary {
  display: block;
  margin-top: 14rpx;
  padding-left: 18rpx;
  color: #7c899c;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.detail-body-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
}

.detail-body {
  display: block;
  color: #4e5e78;
  font-size: 27rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.detail-check-card,
.detail-media-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
}

.detail-card-head {
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-card-title {
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 900;
}

.detail-card-count {
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-check-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 62rpx;
  border-bottom: 1rpx solid #eef2f8;
}

.detail-check-row:last-child {
  border-bottom: 0;
}

.detail-check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 3rpx solid #ccd7e7;
  border-radius: 10rpx;
  background: #fff;
}

.detail-check-done {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
}

.detail-check-mark {
  width: 15rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  opacity: 0;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.detail-check-done .detail-check-mark {
  opacity: 1;
}

.detail-check-text {
  color: #53627a;
  font-size: 24rpx;
}

.detail-check-text-done {
  color: #98a4b6;
  text-decoration: line-through;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-image-tile {
  height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef3fa;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #9aa7b8;
  font-size: 21rpx;
}

.detail-audio-card {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.detail-audio-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--fb-primary);
}

.detail-audio-playing {
  background: #20a97a;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.detail-audio-copy {
  flex: 1;
  min-width: 0;
}

.detail-audio-title {
  display: block;
  color: var(--fb-ink);
  font-size: 25rpx;
  font-weight: 800;
}

.detail-audio-meta {
  display: block;
  margin-top: 3rpx;
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-actionbar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 4;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 14rpx 38rpx rgba(30, 58, 113, 0.13);
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 84rpx;
  gap: 4rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 4rpx 0;
  border-radius: 19rpx;
  background: transparent;
  color: #6d7c93;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  transition: background 0.16s ease, transform 0.12s ease;
}

.detail-action-pressed {
  background: #f4f7fd;
  transform: scale(0.98);
}

.detail-action-active {
  color: #c95e49;
}

.detail-primary .detail-action-label {
  color: var(--fb-primary);
  font-weight: 800;
}

button.detail-share {
  width: auto;
  min-height: 84rpx;
  padding: 4rpx 0;
  background: transparent;
  color: #6d7c93;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.detail-action-label {
  display: block;
  max-width: 100%;
  overflow: hidden;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-tool {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 38rpx;
  overflow: visible;
  border-radius: 13rpx;
  box-shadow: inset 0 -4rpx 0 rgba(23, 33, 57, 0.045);
  transition: background 0.16s ease, box-shadow 0.16s ease;
}

.detail-tool-favorite {
  background: #fff0ed;
}

.detail-action-active .detail-tool-favorite {
  background: #ffe5df;
  box-shadow: inset 0 -4rpx 0 rgba(194, 72, 51, 0.06), 0 5rpx 12rpx rgba(255, 118, 94, 0.09);
}

.detail-action-active .detail-action-label {
  color: #c95e49;
}

.detail-tool-share {
  background: #e8f7f1;
}

.detail-tool-edit {
  background: #eaf2ff;
}

.detail-tool-image {
  display: block;
  width: 38rpx;
  height: 32rpx;
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 320rpx;
  padding: 40rpx;
  color: #66758d;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.login-card {
  min-height: 620rpx;
  margin-top: 24rpx;
  padding: 48rpx 32rpx;
}

.login-art {
  position: relative;
  width: 230rpx;
  height: 205rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
