.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 22rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 2%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.detail-toolbar,
.detail-meta-row,
.detail-audio-card,
.detail-actionbar,
.detail-action,
.detail-card-head {
  display: flex;
  align-items: center;
}

.detail-toolbar {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.book-pill {
  display: inline-flex;
  align-items: center;
  max-width: 280rpx;
  min-height: 48rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  overflow: hidden;
  border-radius: 15rpx;
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #748398;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.detail-cover {
  position: relative;
  height: 238rpx;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 34rpx;
  box-shadow: 0 14rpx 34rpx rgba(45, 91, 255, 0.055);
}

.cover-note {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 2;
  padding: 9rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #52637b;
  font-size: 21rpx;
  font-weight: 800;
}

.cover-art {
  position: absolute;
  right: 8rpx;
  bottom: 2rpx;
  width: 250rpx;
  height: 226rpx;
}

.detail-title {
  display: block;
  margin-top: 24rpx;
  color: var(--fb-ink);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: -2rpx;
}

.detail-meta-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.detail-meta {
  color: var(--fb-muted);
  font-size: 21rpx;
}

.detail-status {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #eaf2ff;
  color: var(--fb-primary);
  font-size: 19rpx;
  font-weight: 800;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.detail-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 13rpx;
  background: #fff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.detail-body-card {
  margin-top: 22rpx;
  padding: 28rpx 30rpx;
}

.detail-body {
  display: block;
  color: #4e5e78;
  font-size: 27rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.detail-check-card,
.detail-media-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
}

.detail-card-head {
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-card-title {
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 900;
}

.detail-card-count {
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-check-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 62rpx;
  border-bottom: 1rpx solid #eef2f8;
}

.detail-check-row:last-child {
  border-bottom: 0;
}

.detail-check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 3rpx solid #ccd7e7;
  border-radius: 10rpx;
  background: #fff;
}

.detail-check-done {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
}

.detail-check-mark {
  width: 15rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  opacity: 0;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.detail-check-done .detail-check-mark {
  opacity: 1;
}

.detail-check-text {
  color: #53627a;
  font-size: 24rpx;
}

.detail-check-text-done {
  color: #98a4b6;
  text-decoration: line-through;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-image-tile {
  height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef3fa;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #9aa7b8;
  font-size: 21rpx;
}

.detail-audio-card {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.detail-audio-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--fb-primary);
}

.detail-audio-playing {
  background: #20a97a;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.detail-audio-copy {
  flex: 1;
  min-width: 0;
}

.detail-audio-title {
  display: block;
  color: var(--fb-ink);
  font-size: 25rpx;
  font-weight: 800;
}

.detail-audio-meta {
  display: block;
  margin-top: 3rpx;
  color: var(--fb-muted);
  font-size: 20rpx;
}

.detail-actionbar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 4;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 14rpx 38rpx rgba(30, 58, 113, 0.13);
}

.detail-action {
  justify-content: center;
  flex: 1;
  min-height: 82rpx;
  gap: 7rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #697991;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.detail-action-active {
  color: #ef6d54;
}

.detail-primary {
  background: var(--fb-primary);
  color: #fff;
}

.detail-share {
  background: #f4f7fd;
}

.detail-action-icon {
  font-size: 30rpx;
}

.share-icon {
  font-size: 30rpx;
  font-weight: 900;
}

.edit-icon {
  position: relative;
  width: 27rpx;
  height: 27rpx;
}

.edit-icon::before {
  position: absolute;
  top: 4rpx;
  left: 10rpx;
  width: 7rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
  transform: rotate(42deg);
}

.edit-icon::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 5rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 320rpx;
  padding: 40rpx;
  color: #66758d;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.login-card {
  min-height: 620rpx;
  margin-top: 24rpx;
  padding: 48rpx 32rpx;
}

.login-art {
  position: relative;
  width: 230rpx;
  height: 205rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
