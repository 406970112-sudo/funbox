@import "../shared.wxss";

.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(176rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 0%, #e9f1ff 0%, transparent 44%), var(--fb-canvas);
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  font-size: 26rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.detail-context-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.detail-context-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.book-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  max-width: 340rpx;
}

.detail-book-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-status,
.detail-encrypted-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.detail-status {
  background: #fff0ed;
  color: #cf5741;
}

.detail-encrypted-pill {
  background: #eef2fa;
  color: var(--fb-muted);
}

.more-circle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 1rpx solid #e4ebf6;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(23, 33, 57, .04);
  flex-shrink: 0;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f6fb;
  flex-shrink: 0;
}

.reading-card {
  padding: 32rpx 30rpx 36rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 57, .04);
}

.detail-heading {
  padding-bottom: 4rpx;
}

.detail-title {
  display: block;
  color: var(--fb-ink);
  font-size: 42rpx;
  line-height: 1.38;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  overflow-wrap: break-word;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.detail-updated,
.detail-summary-inline {
  font-size: 22rpx;
  color: var(--fb-subtle);
  font-variant-numeric: tabular-nums;
}

.detail-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.detail-tag {
  color: var(--fb-primary);
  background: #edf2ff;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  overflow-wrap: anywhere;
}

.reading-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: var(--fb-line);
}

.detail-body {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--fb-ink);
}

.detail-check-section.with-divider {
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--fb-line);
}

.detail-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.check-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-card-title {
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 800;
}

.check-progress-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #edf2ff;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.detail-check-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 14rpx;
  margin: 0 -14rpx;
  border-radius: 18rpx;
  transition: background .12s ease;
}

.detail-check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  margin-top: 4rpx;
  border: 2rpx solid #a3b1c6;
  border-radius: 10rpx;
  box-sizing: border-box;
  background: #fff;
  transition: background .14s ease, border-color .14s ease;
}

.detail-check-box.is-done {
  background: var(--fb-primary);
  border-color: var(--fb-primary);
}

.detail-check-text {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.6;
  color: var(--fb-ink);
  overflow-wrap: break-word;
}

.text-done {
  text-decoration: line-through;
  color: var(--fb-subtle);
}

.check-tap-tip {
  display: block;
  margin-top: 12rpx;
  color: var(--fb-subtle);
  font-size: 21rpx;
}

.empty-body-hint {
  display: block;
  padding: 20rpx 0;
  color: var(--fb-subtle);
  font-size: 26rpx;
  line-height: 1.65;
}

.muted {
  color: var(--fb-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.detail-actionbar {
  position: fixed;
  z-index: 10;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 250, 0) 0%, rgba(245, 247, 250, .96) 28%, #f5f7fa 100%);
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 auto;
  min-width: 146rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dde5f4;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .96);
  color: var(--fb-ink-secondary);
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(23, 33, 57, .07);
  transition: transform .12s ease, opacity .12s ease;
}

.detail-action.action-active {
  border-color: #cbd9ff;
  background: #eef3ff;
  color: var(--fb-primary);
}

.detail-action.detail-primary {
  flex: 1;
  min-width: 0;
  border-color: transparent;
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(45, 91, 255, .26);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  width: 100%;
  border-radius: 24rpx;
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
}

.primary-button[disabled] {
  opacity: .55;
}

.state-card,
.login-card,
.locked-card {
  background: #fff;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  padding: 52rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20rpx;
  margin-top: 16rpx;
  color: var(--fb-muted);
}

.state-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 800;
}

.login-art {
  position: relative;
  width: 220rpx;
  height: 200rpx;
}

.skeleton-title,
.skeleton-line {
  align-self: stretch;
  height: 28rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #e7edf7 25%, #f3f6fb 50%, #e7edf7 75%);
  background-size: 200% 100%;
  animation: fb-shimmer 1.4s ease-in-out infinite;
}

.skeleton-title {
  width: 58%;
  height: 44rpx;
}

.skeleton-short {
  width: 76%;
}

.locked-art {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin: 20rpx auto 16rpx;
}

.locked-paper {
  position: absolute;
  left: 24rpx;
  top: 10rpx;
  width: 160rpx;
  height: 204rpx;
  background: linear-gradient(140deg, #fff, #e8effd);
  border: 2rpx solid #fff;
  border-radius: 24rpx;
  box-shadow: 10rpx 16rpx 28rpx rgba(119, 148, 206, .22);
  transform: rotate(-7deg);
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

.locked-paper view {
  height: 10rpx;
  border-radius: 8rpx;
  margin-bottom: 22rpx;
  background: #c8d7f5;
}

.locked-badge {
  position: absolute;
  right: 6rpx;
  bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 106rpx;
  height: 106rpx;
  border-radius: 28rpx;
  background: linear-gradient(140deg, #5a83ff, var(--fb-primary));
  box-shadow: 6rpx 12rpx 24rpx rgba(45, 91, 255, .28);
}

.locked-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.locked-title {
  color: var(--fb-ink);
  font-size: 38rpx;
  font-weight: 800;
}

.unlock-main {
  margin-top: 20rpx;
}

.privacy-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--fb-subtle);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(15, 27, 55, .42);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: nb-mask-in .18s ease-out;
}

.unlock-sheet,
.more-sheet {
  position: relative;
  background: #fff;
  border-radius: 38rpx 38rpx 0 0;
  padding: 18rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
  animation: nb-sheet-up .2s ease-out;
}

.grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 4rpx auto 24rpx;
  border-radius: 99rpx;
  background: #dce3ee;
}

.sheet-close {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
}

.unlock-badge {
  margin: 0 auto 20rpx;
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef3ff;
}

.sheet-title {
  display: block;
  text-align: center;
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 800;
}

.sheet-caption {
  display: block;
  text-align: center;
  font-size: 23rpx;
  color: var(--fb-muted);
  margin: 12rpx 0 24rpx;
}

.field-label {
  display: block;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 700;
  margin: 24rpx 0 10rpx;
}

.password-field {
  display: flex;
  align-items: center;
  border: 2rpx solid #dfe6f2;
  border-radius: 20rpx;
  background: #f8faff;
  padding-left: 22rpx;
  margin-bottom: 22rpx;
}

.password-field input {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  font-size: 28rpx;
}

.password-toggle {
  background: transparent;
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 20rpx 24rpx;
}

.input-error {
  border-color: #f06548;
}

.field-error {
  display: block;
  color: var(--fb-danger);
  font-size: 23rpx;
  margin: -10rpx 0 20rpx;
}

.text-button {
  color: var(--fb-primary);
  background: transparent;
  min-height: 76rpx;
  width: 100%;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.more-title {
  display: block;
  color: var(--fb-ink);
  font-size: 32rpx;
  font-weight: 800;
  margin: 6rpx 6rpx 20rpx;
}

.more-group {
  overflow: hidden;
  border: 1rpx solid #e6ecf6;
  border-radius: 24rpx;
  background: #fff;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 102rpx;
  width: 100%;
  padding: 0 24rpx;
  text-align: left;
  background: #fff;
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.menu-row + .menu-row {
  border-top: 1rpx solid var(--fb-line);
}

.menu-label {
  flex: 1;
}

.menu-status {
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.danger {
  color: var(--fb-danger);
}

.cancel-button {
  width: 100%;
  min-height: 86rpx;
  border-radius: 22rpx;
  margin-top: 20rpx;
  background: #f2f5fb;
  color: var(--fb-ink-secondary);
  font-size: 26rpx;
  font-weight: 700;
}
