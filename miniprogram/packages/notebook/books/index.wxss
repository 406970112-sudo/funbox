.books-page { min-height:100vh; box-sizing:border-box; padding:30rpx 30rpx calc(210rpx + env(safe-area-inset-bottom)); background:#f5f7fa; color:#172139; }
.books-hero { display:flex; align-items:center; justify-content:space-between; min-height:250rpx; margin-bottom:24rpx; }.hero-copy { flex:1; min-width:0; }.hero-title { display:block; font-size:48rpx; font-weight:800; line-height:1.35; }.hero-accent,.accent { color:#2d5bff; }.hero-desc { display:block; margin-top:14rpx; color:#728099; font-size:24rpx; line-height:1.6; }.hero-art { display:flex; align-items:center; justify-content:center; flex:0 0 200rpx; width:200rpx; height:240rpx; }
.mini-cover { display:flex; align-items:flex-start; justify-content:center; position:relative; flex:0 0 88rpx; width:88rpx; height:100rpx; border-radius:14rpx 20rpx 20rpx 14rpx; background:#2d5bff; box-shadow:inset -6rpx -6rpx 0 rgba(0,0,0,.08),inset 4rpx 4rpx 0 rgba(255,255,255,.25),4rpx 8rpx 12rpx rgba(45,91,255,.12); }.cover-spine { position:absolute; top:0; left:10rpx; bottom:0; width:3rpx; background:rgba(255,255,255,.4); }.cover-label { margin-top:27rpx; width:42rpx; height:9rpx; border-radius:6rpx; background:#fff; box-shadow:0 3rpx 4rpx rgba(0,0,0,.12); }.hero-cover { width:150rpx; height:175rpx; flex-basis:150rpx; transform:rotate(-12deg); border-radius:22rpx; }.hero-cover .cover-label { width:90rpx; height:14rpx; margin-top:36rpx; }.hero-cover .short { position:absolute; top:36rpx; width:78rpx; }.bookmark { position:absolute; bottom:-16rpx; left:64rpx; width:30rpx; height:42rpx; background:#ff927e; border-radius:4rpx; }
.book-total { display:block; color:#74829a; font-size:26rpx; margin:0 8rpx 22rpx; }.book-list { border-radius:30rpx; padding:0 26rpx; background:#fff; border:2rpx solid #edf0f6; }.book-row { display:flex; align-items:center; gap:28rpx; padding:28rpx 8rpx; border-bottom:2rpx solid #edf0f6; }.book-row:last-child { border-bottom:0; }.book-copy { flex:1; min-width:0; }.book-name { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:33rpx; font-weight:700; }.book-meta { display:block; margin-top:8rpx; color:#7b88a0; font-size:25rpx; }.icon-button { display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; flex-shrink:0; }.more-button { width:64rpx; height:72rpx; }
.create-footer { position:fixed; left:30rpx; right:30rpx; bottom:0; padding:24rpx 0 calc(28rpx + env(safe-area-inset-bottom)); background:#f5f7fa; }.footer-help { display:block; text-align:center; margin-top:16rpx; font-size:23rpx; color:#8794aa; }.primary,.secondary,.danger { display:flex; align-items:center; justify-content:center; gap:16rpx; box-sizing:border-box; min-height:88rpx; padding:18rpx 24rpx; margin:0; border-radius:22rpx; font-size:29rpx; font-weight:600; line-height:1.4; }.primary { background:#2d5bff; color:#fff; }.primary[disabled] { background:#b8c8ff; color:#fff; }.secondary { background:#edf1f7; color:#516078; }.danger { color:#fff; background:#ff765e; }.primary::after,.secondary::after,.danger::after { border:none; }.state-card,.login-card { display:flex; align-items:center; justify-content:center; flex-direction:column; gap:24rpx; padding:60rpx 28rpx; border-radius:28rpx; background:#fff; color:#687a94; font-size:27rpx; text-align:center; }.login-card { min-height:500rpx; }.login-title { color:#172139; font-size:34rpx; font-weight:700; }.muted { color:#8592a8; font-size:25rpx; line-height:1.7; }
.overlay,.dialog-overlay { position:fixed; inset:0; display:flex; align-items:flex-end; z-index:30; background:rgba(23,33,57,.4); }.bottom-sheet { width:100%; box-sizing:border-box; padding:22rpx 30rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; background:#fff; }.sheet-handle { width:72rpx; height:8rpx; border-radius:8rpx; background:#d6dce7; margin:0 auto 24rpx; }.sheet-heading { display:flex; align-items:center; justify-content:center; position:relative; height:60rpx; font-size:34rpx; font-weight:700; margin-bottom:28rpx; }.sheet-close { position:absolute; right:0; top:2rpx; }.preview { display:flex; align-items:center; justify-content:center; flex-direction:column; gap:20rpx; min-height:264rpx; padding:28rpx; box-sizing:border-box; border-radius:28rpx; background:#eaf0ff; font-size:28rpx; font-weight:600; }.preview-cover { width:126rpx; height:140rpx; flex:0 0 140rpx; }.preview-cover .cover-label { width:60rpx; height:12rpx; margin-top:38rpx; }.field-label { display:block; font-size:27rpx; font-weight:600; margin:28rpx 6rpx 16rpx; }.input-wrap { display:flex; align-items:center; gap:16rpx; padding:0 20rpx; border:2rpx solid #dce3ee; border-radius:18rpx; background:#f9faff; min-height:78rpx; }.name-input { flex:1; min-width:0; color:#172139; font-size:29rpx; }.input-count { color:#8490a5; font-size:23rpx; flex-shrink:0; }.color-row { display:flex; align-items:center; gap:24rpx; padding:4rpx 6rpx; }.color-dot { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:80rpx; height:80rpx; border-radius:50%; border:5rpx solid #fff; }.color-selected { box-shadow:0 0 0 3rpx #2d5bff; }.sheet-help { display:block; font-size:23rpx; color:#8a97ad; margin:24rpx 6rpx 28rpx; }.sheet-actions { display:flex; align-items:center; gap:18rpx; }.sheet-actions button { flex:1; min-width:0; }.menu-sheet { padding-top:36rpx; }.menu-title,.menu-meta { display:block; text-align:center; }.menu-title { font-size:31rpx; font-weight:700; }.menu-meta { margin-top:10rpx; color:#8490a5; font-size:25rpx; }.menu-options { padding:4rpx 24rpx; border-radius:24rpx; background:#f5f7fb; margin:30rpx 0 18rpx; }.menu-item { display:flex; align-items:center; gap:24rpx; min-height:100rpx; font-size:28rpx; border-bottom:2rpx solid #e4e9f2; }.menu-item:last-child { border:0; }.danger-text { color:#ef705a; }.unavailable { opacity:.55; }.dialog-overlay { align-items:center; justify-content:center; z-index:40; }.dialog { width:calc(100% - 80rpx); box-sizing:border-box; padding:38rpx 32rpx; background:#fff; border-radius:32rpx; }.dialog-title { display:block; text-align:center; font-size:34rpx; font-weight:700; }.dialog-desc { display:block; margin:20rpx 0 32rpx; text-align:center; color:#7d8aa1; font-size:25rpx; line-height:1.7; }.dialog .sheet-actions { margin-top:36rpx; }

.create-body { width:100%; box-sizing:border-box; margin-bottom:20rpx; }
