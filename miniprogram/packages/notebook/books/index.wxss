@import "../shared.wxss";

.books-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(200rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 0%, #e9f1ff 0%, transparent 42%), var(--fb-canvas);
  color: var(--fb-ink);
}

.books-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-title {
  display: block;
  margin-top: 6rpx;
  color: var(--fb-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.6rpx;
}

.header-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--fb-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.book-total-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.accent {
  color: var(--fb-primary);
  font-weight: 700;
}

.mini-cover {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  flex: 0 0 74rpx;
  width: 74rpx;
  height: 86rpx;
  border-radius: 12rpx 18rpx 18rpx 12rpx;
  background: var(--fb-primary);
  box-shadow: inset -5rpx -5rpx 0 rgba(0, 0, 0, .08), inset 3rpx 3rpx 0 rgba(255, 255, 255, .28), 0 6rpx 14rpx rgba(23, 33, 57, .12);
}

.cover-spine {
  position: absolute;
  top: 0;
  left: 10rpx;
  bottom: 0;
  width: 3rpx;
  background: rgba(255, 255, 255, .42);
}

.cover-label {
  margin-top: 24rpx;
  width: 36rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .94);
}

.book-list {
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid #e8eef7;
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 57, .04);
}

.book-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 22rpx;
  transition: background .12s ease;
}

.book-row + .book-row {
  border-top: 1rpx solid var(--fb-line);
}

.book-copy {
  flex: 1;
  min-width: 0;
}

.book-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--fb-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.book-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--fb-subtle);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.more-button {
  width: 60rpx;
  height: 60rpx;
  background: #f5f8fd;
}

.create-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 24rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 250, 0) 0%, rgba(245, 247, 250, .96) 30%, #f5f7fa 100%);
}

.footer-help {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--fb-subtle);
}

.primary,
.secondary,
.danger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  min-height: 86rpx;
  padding: 16rpx 24rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.primary {
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(45, 91, 255, .22);
}

.primary[disabled] {
  background: #b8c8ff;
  box-shadow: none;
  color: #fff;
}

.secondary {
  background: #eff3fa;
  color: var(--fb-ink-secondary);
}

.danger {
  color: #fff;
  background: #e55b43;
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  padding: 56rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid #e8eef7;
  background: #fff;
  color: var(--fb-muted);
  font-size: 26rpx;
  text-align: center;
}

.login-card {
  min-height: 480rpx;
}

.login-title,
.empty-title {
  color: var(--fb-ink);
  font-size: 32rpx;
  font-weight: 800;
}

.muted {
  color: var(--fb-subtle);
  font-size: 24rpx;
  line-height: 1.65;
}

.overlay,
.dialog-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  z-index: 30;
  background: rgba(15, 27, 55, .42);
  animation: nb-mask-in .18s ease-out;
}

.bottom-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #fff;
  animation: nb-sheet-up .2s ease-out;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 99rpx;
  background: #dce3ee;
  margin: 0 auto 20rpx;
}

.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 60rpx;
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.sheet-close {
  position: absolute;
  right: 0;
  top: 2rpx;
  background: #f3f6fb;
}

.create-body {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.preview {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  min-height: 230rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #eef3ff;
}

.preview-name {
  color: var(--fb-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.preview-cover {
  width: 112rpx;
  height: 126rpx;
  flex: 0 0 126rpx;
}

.preview-cover .cover-label {
  width: 54rpx;
  height: 10rpx;
  margin-top: 34rpx;
}

.field-label {
  display: block;
  color: var(--fb-ink-secondary);
  font-size: 25rpx;
  font-weight: 700;
  margin: 24rpx 4rpx 12rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dce4f1;
  border-radius: 20rpx;
  background: #f8faff;
  min-height: 82rpx;
}

.name-input {
  flex: 1;
  min-width: 0;
  color: var(--fb-ink);
  font-size: 28rpx;
}

.input-count {
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.color-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 6rpx 4rpx;
}

.color-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 5rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(23, 33, 57, .12);
}

.color-selected {
  box-shadow: 0 0 0 4rpx var(--fb-primary);
}

.sheet-help {
  display: block;
  font-size: 22rpx;
  color: var(--fb-subtle);
  margin: 20rpx 4rpx 22rpx;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sheet-actions button {
  flex: 1;
  min-width: 0;
}

.menu-title,
.menu-meta {
  display: block;
  text-align: center;
}

.menu-title {
  color: var(--fb-ink);
  font-size: 32rpx;
  font-weight: 800;
}

.menu-meta {
  margin-top: 8rpx;
  color: var(--fb-subtle);
  font-size: 23rpx;
}

.menu-options {
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid #e6ecf6;
  background: #fff;
  margin: 24rpx 0 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 98rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--fb-ink);
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--fb-line);
}

.danger-text {
  color: var(--fb-danger);
}

.unavailable {
  opacity: .5;
}

.dialog-overlay {
  align-items: center;
  justify-content: center;
  z-index: 40;
}

.dialog {
  width: calc(100% - 80rpx);
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  background: #fff;
  border-radius: 30rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 27, 55, .2);
}

.dialog-title {
  display: block;
  text-align: center;
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 800;
}

.dialog-desc {
  display: block;
  margin: 16rpx 0 26rpx;
  text-align: center;
  color: var(--fb-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.dialog .sheet-actions {
  margin-top: 28rpx;
}
