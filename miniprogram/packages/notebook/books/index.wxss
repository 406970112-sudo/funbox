.books-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 3%, #eaf2ff 0%, transparent 40%), var(--fb-canvas);
}

.books-hero,
.books-hero-copy,
.create-head,
.color-row,
.section-head,
.book-row,
.book-actions {
  display: flex;
  align-items: center;
}

.books-hero {
  justify-content: space-between;
  min-height: 240rpx;
}

.books-hero-copy {
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  min-width: 0;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: #6b7890;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  display: block;
  color: var(--fb-ink);
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.hero-accent {
  color: var(--fb-primary);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  color: #64738b;
  font-size: 23rpx;
}

.books-hero-art {
  position: relative;
  flex: 0 0 210rpx;
  width: 210rpx;
  height: 190rpx;
  margin: -8rpx -16rpx 0 0;
}

.create-card {
  margin-bottom: 28rpx;
  padding: 24rpx;
}

.create-head {
  justify-content: space-between;
}

.create-title {
  color: var(--fb-ink);
  font-size: 30rpx;
  font-weight: 900;
}

.create-note {
  color: var(--fb-muted);
  font-size: 21rpx;
}

.book-name-input {
  height: 82rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5edf8;
  border-radius: 22rpx;
  background: #f8faff;
  color: var(--fb-ink);
  font-size: 26rpx;
}

.input-placeholder {
  color: #9aa7b9;
}

.color-row {
  gap: 16rpx;
  margin-top: 18rpx;
}

.color-dot {
  width: 42rpx;
  height: 42rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx #eef2f9;
}

.color-dot-active {
  box-shadow: 0 0 0 3rpx var(--fb-primary);
}

.create-button {
  min-width: 150rpx;
  height: 68rpx;
  margin: 0 0 0 auto;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.section-head {
  justify-content: space-between;
  margin: 8rpx 4rpx 14rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.section-note {
  color: var(--fb-muted);
  font-size: 21rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.book-row {
  min-height: 136rpx;
  box-sizing: border-box;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(38, 76, 133, 0.035);
}

.book-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 82rpx;
  width: 82rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: 16rpx 20rpx 20rpx 16rpx;
  box-shadow: inset -8rpx -8rpx 0 rgba(0, 0, 0, 0.08), 5rpx 8rpx 16rpx rgba(38, 76, 133, 0.14);
}

.book-cover-spine {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 12rpx;
  background: rgba(255, 255, 255, 0.22);
}

.book-initial {
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.book-copy {
  flex: 1;
  min-width: 0;
}

.book-name {
  display: block;
  overflow: hidden;
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  display: block;
  margin-top: 6rpx;
  color: #66758d;
  font-size: 21rpx;
}

.book-actions {
  flex-shrink: 0;
  gap: 6rpx;
}

.book-action {
  padding: 12rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--fb-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.book-action.delete {
  color: #c74d38;
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 260rpx;
  padding: 36rpx;
  color: #66758d;
  font-size: 23rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.login-card {
  margin-top: 20rpx;
  min-height: 560rpx;
}

.login-art {
  position: relative;
  width: 220rpx;
  height: 190rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 33rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
