<import src="/templates/note-art.wxml" />
<view class="notebook-page">

  <view class="hero">
    <view class="hero-copy">

      <text class="hero-title">想到什么，</text>
      <text class="hero-title"><text class="hero-accent">随手记下来。</text></text>
      <text class="hero-desc">文字、清单和灵感，都收在这里。</text>
    </view>
    <view class="hero-art" aria-hidden="true"><template is="note-art" data="{{variant: 'md'}}"></template></view>
  </view>

  <block wx:if="{{isLoggedIn}}">
    <view class="home-search-row">
      <button class="search-bar" bindtap="openSearch" aria-label="搜索笔记、标签或正文">
        <nb-icon name="search" size="{{36}}" />
        <text class="search-copy">搜索笔记、标签或正文</text>
      </button>

    </view>

    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view
          wx:for="{{filters}}"
          wx:key="id"
          class="filter-chip {{activeBookId === item.id ? 'filter-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="changeFilter"
        >{{item.name}}<text class="filter-count">{{item.count}}</text></view>
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="loading-section" aria-label="正在加载笔记">
      <view class="section-head"><text class="section-title">最近笔记</text></view>
      <view class="loading-card">
        <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-row" aria-hidden="true"><view class="skeleton-icon"></view><view class="skeleton-copy"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line skeleton-meta"></view></view></view>
        <view class="loading-caption"><view class="loading-spinner" aria-hidden="true"></view><text>正在翻开笔记本…</text></view>
      </view>
    </view>

    <view wx:elif="{{error}}" class="state-card fb-card state-error" bindtap="retry">
      <text>{{error}}</text>
      <text class="state-action">重新加载</text>
    </view>

    <block wx:else>
      <view wx:if="{{pinnedNotes.length}}" class="section-block">
        <view class="section-head">
          <text class="section-title">置顶</text>
          <view class="manage-books" bindtap="manageBooks" role="button">管理笔记本</view>
        </view>
        <view
          wx:for="{{pinnedNotes}}"
          wx:key="id"
          class="pinned-card"
          data-id="{{item.id}}"
          bindtap="openNote"
          role="button"
          aria-label="打开置顶笔记 {{item.displayTitle}}"
        >
          <view class="pinned-top">
            <text class="note-book-label" style="background: {{item.bookFill}}; color: {{item.bookInk}};">{{item.bookName}}</text>
            <view class="pin-flags">
              <view class="pin-mark"><nb-icon name="pin" tone="coral" size="{{28}}" /><text>置顶</text></view>
              <view wx:if="{{item.locked}}" class="pinned-lock">
                <nb-icon name="lock" size="{{24}}" />
                <text>已加密</text>
              </view>
            </view>
          </view>
          <text class="pinned-title">{{item.displayTitle}}</text>
          <text class="pinned-excerpt">{{item.excerpt}}</text>
          <view class="pinned-foot">
            <text wx:if="{{item.featureTag}}" class="note-tag"># {{item.featureTag}}</text>
            <text class="note-time">{{item.timeLabel}}</text>
          </view>
        </view>
      </view>

      <view class="section-block recent-block">
        <view class="section-head">
          <text class="section-title">最近笔记</text>
          <view wx:if="{{pinnedNotes.length}}" class="section-sort">按更新时间<nb-icon name="chevron-down" size="{{24}}" /></view><view wx:else class="manage-books" bindtap="manageBooks" role="button">管理笔记本</view>
        </view>
        <view wx:if="{{recentNotes.length}}" class="note-list">
          <view
            wx:for="{{recentNotes}}"
            wx:key="id"
            class="note-row"
            data-id="{{item.id}}"
            bindtap="openNote"
            role="button"
            aria-label="打开笔记 {{item.displayTitle}}"
          >
            <view class="note-icon {{item.locked ? 'note-icon-locked' : ''}}" style="background: {{item.bookFill}}; color: {{item.bookInk}};">
              <nb-icon name="{{item.locked ? 'lock' : item.checklist.length ? 'checklist' : 'document'}}" tone="{{item.locked ? 'default' : 'primary'}}" size="{{42}}" />
            </view>
            <view class="note-row-copy">
              <text class="note-row-title">{{item.displayTitle}}</text>
              <text class="note-row-meta">{{item.bookName}} · {{item.timeLabel}}<text wx:if="{{item.locked}}"> · 已加密</text></text>
            </view>
            <text wx:if="{{item.locked}}" class="locked-badge">已锁定</text><nb-icon name="chevron" size="{{28}}" />
          </view>
        </view>
        <view wx:else class="empty-card fb-card">
          <view class="empty-art" aria-hidden="true"><template is="note-art" data="{{variant: 'sm'}}"></template></view>
          <text class="empty-title">{{hasNotes ? '这一本还没有最近笔记' : '还没有笔记'}}</text>
          <text class="empty-desc">从一句话开始，把想到的留在这里。</text>
          <button class="empty-button" bindtap="createNote">新建第一页</button>
        </view>
      </view>
    </block>

    <view class="encryption-management" bindtap="openSecurity" role="button" aria-label="加密管理"><nb-icon name="lock" size="{{34}}" /><text>加密管理</text></view>
    <view class="new-note-fab" bindtap="createNote" role="button" aria-label="新建笔记">
      <nb-icon name="plus" tone="white" size="{{38}}" /><text>新建笔记</text>
    </view>
  </block>

  <view wx:else class="login-card fb-card">
    <view class="login-art" aria-hidden="true"><template is="note-art" data="{{variant: 'md'}}"></template></view>
    <text class="login-title">登录后开始记录</text>
    <text class="login-desc">笔记会跟随你的账号保存，换设备也能继续写。</text>
    <button class="login-button" bindtap="openLogin">微信快捷登录</button>
  </view>

  <view wx:if="{{showSecuritySheet}}" class="security-mask" catchtouchmove="noop">
    <view class="security-sheet" catchtap="noop">
      <view class="security-grabber"></view>
      <view class="security-head">
        <view class="security-title-wrap">
          <text class="security-title">{{securityMode === 'change' ? '修改笔记密码' : securityMode === 'unlock' ? '解锁加密笔记' : '加密管理'}}</text>
          <text wx:if="{{hasSecurityPassword}}" class="security-subtitle">{{encryptedNoteCount}} 篇加密笔记</text>
          <text wx:else class="security-subtitle">尚未开启。打开任意笔记，在编辑页点击锁按钮即可。</text>
        </view>
        <view class="security-close" bindtap="closeSecuritySheet" role="button" aria-label="关闭加密笔记设置"><nb-icon name="close" size="{{32}}" /></view>
      </view>

      <block wx:if="{{securityMode === 'summary'}}">
        <block wx:if="{{hasSecurityPassword}}">
          <view class="security-status"><nb-icon name="{{securityUnlocked ? 'unlock' : 'lock'}}" tone="primary" size="{{40}}" /><text>{{securityUnlocked ? '本次已解锁' : '当前已锁定'}}</text></view>
          <button wx:if="{{!securityUnlocked}}" class="security-action security-action-primary" bindtap="beginSecurityUnlock" disabled="{{securityBusy}}">解锁加密笔记</button>
          <button wx:else class="security-action security-action-primary" bindtap="lockSecurity" disabled="{{securityBusy}}">立即上锁</button>
          <view class="security-management-list">
            <button class="security-management-row" bindtap="beginPasswordChange" disabled="{{securityBusy}}"><nb-icon name="key" size="{{40}}" /><text>修改密码</text><nb-icon name="chevron" size="{{28}}" /></button>
            <button class="security-management-row security-management-danger" bindtap="resetEncryption" disabled="{{securityBusy}}"><nb-icon name="trash" tone="coral" size="{{40}}" /><text>清空加密笔记</text><nb-icon name="chevron" size="{{28}}" /></button>
          </view>
          <text class="security-forgot-help">忘记密码无法找回已加密内容</text>
        </block>
        <view wx:else class="security-empty">
          <nb-icon name="lock" size="{{40}}" />
          <text>开启后，锁定状态不会展示真实标题、摘要和标签。</text>
        </view>
      </block>

      <block wx:elif="{{securityMode === 'unlock'}}">
        <text class="security-field-label">笔记密码</text>
        <input
          class="security-input"
          type="password"
          password
          value="{{securityPassword}}"
          maxlength="32"
          focus="{{securityMode === 'unlock'}}"
          placeholder="请输入笔记密码"
          placeholder-class="security-placeholder"
          bindinput="onSecurityPasswordInput"
          confirm-type="done"
          bindconfirm="submitSecurityUnlock"
        />
        <text wx:if="{{securityError}}" class="security-error">{{securityError}}</text>
        <button class="security-submit" bindtap="submitSecurityUnlock" disabled="{{securityBusy}}">{{securityBusy ? '正在解锁…' : '解锁'}}</button>
        <button class="security-back" bindtap="backToSecuritySummary">返回</button>
      </block>

      <block wx:else>
        <text class="security-field-label">当前密码</text>
        <input class="security-input" type="password" password value="{{securityPassword}}" maxlength="32" placeholder="输入当前笔记密码" placeholder-class="security-placeholder" bindinput="onSecurityPasswordInput" />
        <text class="security-field-label">新密码</text>
        <input class="security-input" type="password" password value="{{securityNewPassword}}" maxlength="32" placeholder="6–32 位字符" placeholder-class="security-placeholder" bindinput="onSecurityNewPasswordInput" />
        <text class="security-field-label">再次输入</text>
        <input class="security-input" type="password" password value="{{securityConfirmPassword}}" maxlength="32" placeholder="再次输入新密码" placeholder-class="security-placeholder" bindinput="onSecurityConfirmPasswordInput" />
        <text wx:if="{{securityError}}" class="security-error">{{securityError}}</text>
        <button class="security-submit" bindtap="submitPasswordChange" disabled="{{securityBusy}}">{{securityBusy ? '正在更新…' : '更新密码'}}</button>
        <button class="security-back" bindtap="backToSecuritySummary">返回</button>
      </block>
    </view>
  </view>
</view>
