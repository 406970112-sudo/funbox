@import "../shared.wxss";

.notebook-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(184rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 0%, #e9f1ff 0%, transparent 46%), var(--fb-canvas);
}

.nb-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.nb-header-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nb-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.nb-title {
  color: var(--fb-ink);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.8rpx;
}

.nb-count-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.nb-manage-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dde7f8;
  background: rgba(255, 255, 255, .94);
  color: var(--fb-primary);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(39, 70, 120, .05);
  flex-shrink: 0;
  transition: transform .12s ease, opacity .12s ease;
}

.home-search-row {
  display: flex;
  margin-bottom: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #e4ebf6;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(39, 70, 120, .04);
  text-align: left;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.search-copy {
  flex: 1;
  min-width: 0;
  color: var(--fb-subtle);
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 2rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e7edf6;
  border-radius: 999rpx;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 600;
  background: #fff;
  transition: transform .12s ease-out, background .15s ease, color .15s ease;
}

.filter-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.filter-active {
  background: var(--fb-primary);
  border-color: var(--fb-primary);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(45, 91, 255, .22);
}

.filter-count {
  font-size: 22rpx;
  opacity: .76;
  font-variant-numeric: tabular-nums;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
  margin: 0 4rpx 14rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.section-meta {
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.section-sort {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf2fb;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 700;
  transition: transform .12s ease, opacity .12s ease;
}

.pinned-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 22rpx 24rpx 22rpx 30rpx;
  border: 1rpx solid #f1e4df;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 57, .045);
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.pinned-card + .pinned-card {
  margin-top: 14rpx;
}

.pinned-accent-bar {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: linear-gradient(180deg, #ff8a70, #f06548);
}

.pinned-top,
.pinned-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.note-book-label {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.pin-flags,
.pinned-lock,
.flag-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pinned-lock {
  font-size: 21rpx;
  color: var(--fb-muted);
}

.pinned-title {
  display: block;
  margin-top: 12rpx;
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.38;
}

.pinned-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.pinned-foot {
  justify-content: flex-start;
  margin-top: 14rpx;
}

.note-tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #edf2ff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 600;
}

.check-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f5fb;
  color: var(--fb-ink-secondary);
  font-size: 21rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.note-time {
  color: var(--fb-subtle);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.recent-block {
  margin-top: 28rpx;
}

.note-list {
  overflow: hidden;
  border: 1rpx solid #e8eef7;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 57, .04);
}

.note-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  transition: background .12s ease;
}

.note-row + .note-row {
  border-top: 1rpx solid var(--fb-line);
}

.note-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
}

.note-icon-locked {
  background: #eef1f7 !important;
}

.note-row-copy {
  flex: 1;
  min-width: 0;
}

.note-row-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.note-row-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-star {
  display: flex;
  flex-shrink: 0;
}

.note-row-excerpt {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--fb-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-row-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  color: var(--fb-subtle);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
}

.meta-book {
  font-weight: 700;
  flex-shrink: 0;
}

.meta-dot {
  opacity: .55;
}

.meta-check,
.meta-tag {
  overflow: hidden;
  text-overflow: ellipsis;
}

.locked-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: var(--fb-muted);
  font-size: 21rpx;
  font-weight: 600;
}

.bottom-dock-scrim {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 8;
  height: calc(164rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 250, 0) 0%, rgba(245, 247, 250, .94) 50%, #f5f7fa 100%);
  pointer-events: none;
}

.encryption-management {
  position: fixed;
  z-index: 10;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 88rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #dde5f4;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 10rpx 24rpx rgba(23, 33, 57, .09);
  color: var(--fb-ink-secondary);
  font-size: 25rpx;
  font-weight: 700;
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.security-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--fb-primary);
}

.security-dot-open {
  background: #22a06b;
}

.new-note-fab {
  position: fixed;
  z-index: 10;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(45, 91, 255, .28);
  transition: transform .12s ease-out, opacity .12s ease-out;
}

.empty-card,
.login-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  padding: 44rpx 30rpx;
  background: #fff;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  text-align: center;
}

.empty-art,
.login-art {
  position: relative;
  width: 200rpx;
  height: 180rpx;
  margin-bottom: 12rpx;
}

.empty-title,
.login-title {
  color: var(--fb-ink);
  font-size: 31rpx;
  font-weight: 800;
}

.empty-desc,
.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.empty-button,
.login-button {
  width: 100%;
  max-width: 400rpx;
  min-height: 86rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 86rpx;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14rpx;
  min-height: 260rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  background: #fff;
  color: var(--fb-muted);
  font-size: 25rpx;
  text-align: center;
}

.state-error .state-msg {
  color: var(--fb-danger);
}

.state-action {
  color: var(--fb-primary);
  font-weight: 700;
}

.loading-card {
  padding: 10rpx 26rpx 26rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 26rpx;
  background: #fff;
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 124rpx;
  border-bottom: 1rpx solid var(--fb-line);
}

.skeleton-icon {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #e7edf7 25%, #f3f6fb 50%, #e7edf7 75%);
  background-size: 200% 100%;
  animation: fb-shimmer 1.4s ease-in-out infinite;
}

.skeleton-copy {
  flex: 1;
  min-width: 0;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e7edf7 25%, #f3f6fb 50%, #e7edf7 75%);
  background-size: 200% 100%;
  animation: fb-shimmer 1.4s ease-in-out infinite;
}

.skeleton-title {
  width: 72%;
  margin-bottom: 16rpx;
}

.skeleton-meta {
  width: 52%;
  height: 20rpx;
}

.loading-caption {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 28rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
}

.loading-spinner {
  box-sizing: border-box;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #e3eaf5;
  border-right-color: var(--fb-primary);
  border-radius: 50%;
  animation: notebook-spin .9s linear infinite;
}

@keyframes notebook-spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-icon,
  .skeleton-line,
  .security-mask,
  .security-sheet {
    animation: none;
  }
}

.security-mask {
  position: fixed;
  z-index: 30;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 27, 55, .42);
  animation: nb-mask-in .18s ease-out;
}

.security-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #fff;
  box-shadow: 0 -20rpx 52rpx rgba(21, 40, 82, .16);
  animation: nb-sheet-up .2s ease-out;
}

.security-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: #dce3ee;
}

.security-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.security-title-wrap {
  flex: 1;
  min-width: 0;
}

.security-title {
  display: block;
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
}

.security-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.security-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f3f6fb;
}

.security-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 88rpx;
  margin: 28rpx 0;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: #eef3ff;
  color: #3f588d;
  font-size: 25rpx;
  font-weight: 600;
}

.security-status-open {
  background: var(--fb-success-soft);
  color: var(--fb-success);
}

.security-action {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.security-action-primary {
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  color: #fff;
}

.security-management-list {
  overflow: hidden;
  margin-top: 26rpx;
  border: 1rpx solid #e4ebf6;
  border-radius: 24rpx;
  background: #fff;
}

.security-management-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 98rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 0;
  background: #fff;
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: left;
}

.security-management-row + .security-management-row {
  border-top: 1rpx solid var(--fb-line);
}

.security-management-row > text {
  flex: 1;
}

.security-management-danger {
  color: var(--fb-danger);
}

.security-forgot-help {
  display: block;
  margin: 28rpx 0 10rpx;
  color: var(--fb-subtle);
  font-size: 22rpx;
  text-align: center;
}

.security-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f5f8fd;
  color: var(--fb-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.security-field-label {
  display: block;
  margin: 22rpx 0 10rpx;
  color: var(--fb-ink-secondary);
  font-size: 23rpx;
  font-weight: 700;
}

.security-input {
  width: 100%;
  height: 86rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 2rpx solid #dfe7f4;
  border-radius: 20rpx;
  background: #fbfcff;
  color: var(--fb-ink);
  font-size: 26rpx;
}

.security-placeholder {
  color: #9aa6ba;
}

.security-error {
  display: block;
  margin-top: 12rpx;
  color: var(--fb-danger);
  font-size: 22rpx;
}

.security-submit {
  width: 100%;
  min-height: 86rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 86rpx;
}

.security-back {
  width: 100%;
  min-height: 76rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border-radius: 20rpx;
  background: #f3f6fb;
  color: var(--fb-muted);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 76rpx;
}
