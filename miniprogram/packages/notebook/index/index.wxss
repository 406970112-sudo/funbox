.notebook-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 30rpx calc(150rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 4%, #eaf2ff 0%, transparent 40%), var(--fb-canvas);
}

.home-topbar,
.account-pill,
.hero,
.pinned-top,
.pinned-foot,
.note-row,
.section-head,
.search-bar {
  display: flex;
  align-items: center;
}

.home-topbar {
  justify-content: space-between;
  gap: 20rpx;
}

.brand-wrap {
  display: block;
}

.brand-caption {
  display: block;
  margin-top: 4rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.account-pill {
  gap: 10rpx;
  max-width: 250rpx;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border-radius: 99rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45, 91, 255, 0.06);
}

.account-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  color: #fff;
  font-size: 21rpx;
}

.account-name {
  min-width: 0;
  overflow: hidden;
  color: var(--fb-ink);
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-arrow {
  color: #8490a4;
  font-size: 30rpx;
}

.hero {
  position: relative;
  min-height: 270rpx;
  justify-content: space-between;
  gap: 6rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: #6b7890;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  display: block;
  color: var(--fb-ink);
  font-size: 55rpx;
  font-weight: 900;
  line-height: 1.22;
  letter-spacing: -2rpx;
}

.hero-accent {
  color: var(--fb-primary);
}

.hero-desc {
  display: block;
  max-width: 340rpx;
  margin-top: 12rpx;
  color: #64738b;
  font-size: 23rpx;
  line-height: 1.7;
}

.hero-art {
  position: relative;
  flex: 0 0 242rpx;
  width: 242rpx;
  height: 232rpx;
  margin: -8rpx -16rpx 0 0;
}

.search-bar {
  width: 100%;
  height: 86rpx;
  box-sizing: border-box;
  gap: 14rpx;
  margin: 0 0 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid #fff;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(38, 76, 133, 0.04);
  line-height: 1.4;
  text-align: left;
}

.search-icon {
  position: relative;
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 25rpx;
  border: 3rpx solid #7d8ca6;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #7d8ca6;
  content: "";
  transform: rotate(45deg);
}

.search-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #7b879c;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-shortcut {
  color: #a0acbe;
  font-size: 26rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 10rpx;
  min-width: 100%;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #fff;
  border-radius: 22rpx;
  background: #fff;
  color: #64738b;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 7rpx 18rpx rgba(38, 76, 133, 0.03);
}

.filter-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(45, 91, 255, 0.17);
}

.filter-count {
  min-width: 28rpx;
  color: #9aa6b8;
  font-size: 20rpx;
  text-align: center;
}

.filter-active .filter-count {
  color: rgba(255, 255, 255, 0.72);
}

.section-block {
  margin-top: 12rpx;
}

.section-head {
  justify-content: space-between;
  margin: 18rpx 4rpx 12rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 32rpx;
  font-weight: 900;
}

.section-note {
  color: var(--fb-muted);
  font-size: 22rpx;
}

.pinned-card {
  display: block;
  box-sizing: border-box;
  padding: 26rpx 28rpx;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  background: #fff0ed;
  box-shadow: 0 12rpx 28rpx rgba(155, 86, 70, 0.045);
}

.pinned-card + .pinned-card {
  margin-top: 16rpx;
}

.pinned-top {
  justify-content: space-between;
  gap: 16rpx;
}

.note-book-label {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.pin-mark {
  color: #c95e49;
  font-size: 21rpx;
  font-weight: 800;
}

.pinned-title {
  display: block;
  margin-top: 12rpx;
  color: var(--fb-ink);
  font-size: 37rpx;
  font-weight: 900;
  line-height: 1.35;
}

.pinned-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #5f6f87;
  font-size: 24rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.pinned-foot {
  gap: 14rpx;
  margin-top: 16rpx;
}

.note-tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #fff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.note-time {
  margin-left: auto;
  color: #9a7b72;
  font-size: 21rpx;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.note-row {
  min-height: 122rpx;
  box-sizing: border-box;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(38, 76, 133, 0.035);
}

.note-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.note-row-copy {
  flex: 1;
  min-width: 0;
}

.note-row-title {
  display: block;
  overflow: hidden;
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-row-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
}

.note-row-arrow {
  flex-shrink: 0;
  color: #a5b0c2;
  font-size: 38rpx;
}

.empty-card,
.login-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  padding: 42rpx 32rpx;
  text-align: center;
}

.empty-card {
  min-height: 380rpx;
}

.empty-art,
.login-art {
  position: relative;
  width: 210rpx;
  height: 190rpx;
  margin-bottom: 12rpx;
}

.empty-title,
.login-title {
  color: var(--fb-ink);
  font-size: 33rpx;
  font-weight: 900;
}

.empty-desc,
.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.empty-button,
.login-button {
  width: 100%;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.login-card {
  margin-top: 10rpx;
  padding-top: 46rpx;
  padding-bottom: 46rpx;
}

.login-button {
  max-width: 420rpx;
}

.new-note-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  box-shadow: 0 16rpx 36rpx rgba(45, 91, 255, 0.28);
}

.fab-plus {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.fab-plus::before,
.fab-plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 4rpx;
  background: #fff;
  content: "";
  transform: translate(-50%, -50%);
}

.fab-plus::before {
  width: 38rpx;
  height: 6rpx;
}

.fab-plus::after {
  width: 6rpx;
  height: 38rpx;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 260rpx;
  margin-top: 16rpx;
  padding: 36rpx;
  color: #66758d;
  font-size: 23rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

@media (max-width: 350px) {
  .hero-art {
    flex-basis: 210rpx;
    width: 210rpx;
    margin-right: -20rpx;
  }

  .hero-title {
    font-size: 49rpx;
  }
}
