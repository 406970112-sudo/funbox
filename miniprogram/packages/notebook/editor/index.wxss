@import "../shared.wxss";

button {
  margin: 0;
  padding: 0;
  background: transparent;
  font-weight: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.editor-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  background: radial-gradient(ellipse at 92% 0%, #e9f1ff 0%, transparent 40%), var(--fb-canvas);
}

.editor-topbar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
  padding: 14rpx 28rpx 16rpx;
  min-height: 76rpx;
}

.book-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 268rpx;
  height: 60rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  transition: transform .12s ease, opacity .12s ease;
}

.book-pill text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  color: var(--fb-subtle);
  font-size: 21rpx;
  font-weight: 600;
}

.save-state text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-saved {
  color: #227d5b;
}

.save-check {
  display: flex;
  flex-shrink: 0;
}

.save-check-pulse {
  animation: notebook-save-pulse 280ms cubic-bezier(.2, .7, .25, 1);
}

.save-error {
  color: var(--fb-danger);
}

.save-saving {
  color: var(--fb-primary);
}

.done-button {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 60rpx;
  box-shadow: 0 6rpx 14rpx rgba(45, 91, 255, .2);
  transition: transform .12s ease, opacity .12s ease;
}

.editor-skeleton {
  padding: 20rpx 28rpx;
}

.editor-skeleton-card {
  padding: 32rpx 30rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  background: #fff;
}

.editor-skeleton-title,
.editor-skeleton-date,
.editor-skeleton-line {
  border-radius: 10rpx;
  background: linear-gradient(90deg, #e7edf7 25%, #f3f6fb 50%, #e7edf7 75%);
  background-size: 200% 100%;
  animation: fb-shimmer 1.4s ease-in-out infinite;
}

.editor-skeleton-title { width: 58%; height: 42rpx; }
.editor-skeleton-date { width: 32%; height: 22rpx; margin-top: 18rpx; }
.editor-skeleton-line { width: 100%; height: 26rpx; margin-top: 26rpx; }
.editor-skeleton-short { width: 76%; }
.editor-skeleton-caption { display: block; margin-top: 24rpx; color: var(--fb-muted); font-size: 23rpx; text-align: center; }

.editor-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.writing-sheet {
  margin: 0 28rpx;
  padding: 28rpx 30rpx 32rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(23, 33, 57, .04);
}

.title-input {
  width: 100%;
  min-height: 62rpx;
  color: var(--fb-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.38;
  letter-spacing: -0.6rpx;
}

.title-placeholder {
  color: #a3afc2;
}

.sheet-meta-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 0 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--fb-line);
}

.date-label,
.word-count {
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.body-input {
  width: 100%;
  min-height: 120rpx;
  color: var(--fb-ink);
  font-size: 30rpx;
  line-height: 1.8;
}

.body-placeholder {
  color: #a3afc2;
}

.check-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--fb-line);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.section-count {
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.checklist-count-motion-1 {
  animation: notebook-count-pop 240ms cubic-bezier(.2, .7, .25, 1);
}

.checklist-count-motion-2 {
  animation: notebook-count-pop-repeat 240ms cubic-bezier(.2, .7, .25, 1);
}

.check-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 70rpx;
}

.check-control {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #a3b1c6;
  border-radius: 10rpx;
  box-sizing: border-box;
  background: #fff;
}

.check-control-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
}

.check-mark {
  display: flex;
}

.check-mark-draw {
  animation: notebook-draw-check 255ms ease-out both;
}

@keyframes notebook-draw-check {
  from { clip-path: inset(0 100% 0 0); }
  to { clip-path: inset(0); }
}

@keyframes notebook-count-pop {
  0%, 100% { transform: scale(1); }
  44% { transform: scale(1.075); }
}

@keyframes notebook-count-pop-repeat {
  0%, 100% { transform: scale(1); }
  44% { transform: scale(1.075); }
}

@keyframes notebook-save-pulse {
  0%, 100% { transform: scale(1); }
  44% { transform: scale(1.15); }
}

@media (prefers-reduced-motion: reduce) {
  .editor-skeleton-title,
  .editor-skeleton-date,
  .editor-skeleton-line,
  .check-mark-draw,
  .checklist-count-motion-1,
  .checklist-count-motion-2,
  .save-check-pulse,
  .modal-mask,
  .panel,
  .book-sheet {
    animation: none;
  }
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: var(--fb-ink);
  font-size: 28rpx;
}

.check-input-done {
  color: var(--fb-subtle);
  text-decoration: line-through;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.add-link {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  margin-top: 4rpx;
  color: var(--fb-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--fb-line);
}

.modal-tag-cloud {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.editor-tag,
.add-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf2ff;
  color: var(--fb-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.tag-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 44rpx;
}

.add-tag {
  background: #f2f5fb;
  color: var(--fb-ink-secondary);
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 24rpx;
  background: #fff;
  transition: transform .12s ease, opacity .12s ease;
}

.privacy-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #f3f6fb;
  flex-shrink: 0;
}

.privacy-icon-on {
  background: #edf2ff;
}

.privacy-copy {
  flex: 1;
  min-width: 0;
}

.privacy-title {
  display: block;
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.privacy-hint {
  display: block;
  margin-top: 4rpx;
  color: var(--fb-subtle);
  font-size: 21rpx;
}

.privacy-row switch {
  transform: scale(.75);
  transform-origin: right center;
  pointer-events: none;
}

.scroll-bottom-spacer {
  height: 28rpx;
}

.format-wrap {
  flex-shrink: 0;
  padding: 10rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
}

.format-wrap.keyboard-open {
  padding: 8rpx 20rpx 10rpx;
}

.format-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #e2e9f5;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 8rpx 22rpx rgba(23, 33, 57, .07);
}

.format-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #f5f8fd;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 700;
  transition: transform .12s ease, opacity .12s ease;
}

.format-item-active {
  background: #eaf1ff;
  color: var(--fb-primary);
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 24rpx;
  margin: 28rpx;
  padding: 64rpx 30rpx;
  border: 1rpx solid #e8eef7;
  border-radius: 28rpx;
  background: #fff;
  color: var(--fb-muted);
  font-size: 26rpx;
}

.state-title {
  color: var(--fb-ink);
  font-weight: 800;
  font-size: 34rpx;
}

.state-copy {
  text-align: center;
  line-height: 1.65;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  background: rgba(15, 27, 55, .42);
  animation: nb-mask-in .18s ease-out;
}

.bottom-mask {
  align-items: flex-end;
  padding: 0;
}

.panel {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #fff;
  animation: nb-sheet-up .2s ease-out;
}

.tag-modal {
  max-height: 85vh;
  overflow-y: auto;
}

.panel-close {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  background: #f3f6fb;
}

.panel-title {
  display: block;
  padding: 4rpx 48rpx 8rpx;
  text-align: center;
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 800;
}

.panel-description {
  display: block;
  color: var(--fb-muted);
  text-align: center;
  font-size: 23rpx;
  line-height: 1.6;
}

.field-label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.modal-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dce4f1;
  border-radius: 20rpx;
  background: #f8faff;
  color: var(--fb-ink);
  font-size: 27rpx;
}

.input-error {
  border-color: #f06548;
}

.tag-input-wrap {
  position: relative;
}

.tag-input {
  padding-right: 104rpx;
}

.input-count {
  position: absolute;
  right: 20rpx;
  top: 26rpx;
  color: var(--fb-subtle);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.suggestion-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e4ebf6;
  background: #f5f8fd;
  color: var(--fb-ink-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.error-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--fb-danger);
  font-size: 23rpx;
}

.panel-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.primary-button {
  color: #fff;
  background: linear-gradient(140deg, #4b7aff, var(--fb-primary));
  box-shadow: 0 8rpx 18rpx rgba(45, 91, 255, .2);
}

.secondary-button {
  border: 1rpx solid #dce4f1;
  color: var(--fb-ink-secondary);
  background: #f6f8fc;
}

.primary-button[disabled] {
  opacity: .5;
}

.book-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  padding: 18rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #fff;
  animation: nb-sheet-up .2s ease-out;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 99rpx;
  background: #dce3ee;
}

.sheet-title {
  display: block;
  margin: 6rpx 8rpx 22rpx;
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 800;
}

.book-options {
  max-height: 48vh;
}

.book-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 102rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
}

.book-option + .book-option {
  margin-top: 8rpx;
}

.book-option-selected {
  background: #edf2ff;
}

.book-option-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.book-name {
  flex: 1;
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 700;
}

.selection-icon {
  width: 36rpx;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 24rpx;
}

.text-button {
  flex: 1;
  color: var(--fb-primary);
  font-size: 26rpx;
  font-weight: 700;
  text-align: left;
}

.password-modal {
  max-height: 100%;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.password-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 98rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  background: #edf2ff;
}

.password-warning {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fff0ed;
  color: var(--fb-danger);
  font-size: 23rpx;
  line-height: 1.6;
}

.acknowledge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 76rpx;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--fb-ink-secondary);
}

.panel-footer {
  display: block;
  margin-top: 20rpx;
  color: var(--fb-subtle);
  text-align: center;
  font-size: 22rpx;
}
