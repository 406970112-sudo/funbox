.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 22rpx 30rpx calc(190rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 2%, #eaf2ff 0%, transparent 38%), var(--fb-canvas);
}

.editor-topbar,
.book-pill,
.card-head,
.card-title,
.check-row,
.audio-card,
.tag-cloud,
.editor-tag,
.format-bar,
.format-item,
.modal-actions {
  display: flex;
  align-items: center;
}

.editor-topbar {
  gap: 16rpx;
  min-height: 72rpx;
}

.book-picker {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 62rpx;
  line-height: 0;
}

.book-pill {
  display: flex;
  align-items: center;
  max-width: 270rpx;
  height: 62rpx;
  box-sizing: border-box;
  gap: 10rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.book-pill text:first-child {
  overflow: hidden;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-pill-arrow {
  flex: 0 0 auto;
  width: 0;
  height: 0;
  border-top: 8rpx solid currentColor;
  border-right: 7rpx solid transparent;
  border-left: 7rpx solid transparent;
}

.save-state {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--fb-muted);
  font-size: 20rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-saving {
  color: var(--fb-primary);
}

.save-saved {
  color: #3b9b73;
}

.save-error {
  color: #c74d38;
}

.done-button {
  flex-shrink: 0;
  min-width: 90rpx;
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.title-card {
  position: relative;
  min-height: 218rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 28rpx 180rpx 28rpx 28rpx;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  background: #eaf2ff;
  box-shadow: 0 12rpx 28rpx rgba(45, 91, 255, 0.055);
}

.title-input {
  width: 100%;
  color: var(--fb-ink);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.title-placeholder {
  color: #8c9ab0;
  font-weight: 900;
}

.title-hint {
  display: block;
  margin-top: 18rpx;
  color: #64738b;
  font-size: 21rpx;
}

.title-art {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 166rpx;
  height: 154rpx;
}

.body-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.body-input {
  width: 100%;
  min-height: 220rpx;
  color: #4e5e78;
  font-size: 27rpx;
  line-height: 1.85;
}

.body-placeholder {
  color: #a0abbb;
}

.check-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
}

.card-head {
  justify-content: space-between;
  gap: 18rpx;
}

.card-title {
  gap: 12rpx;
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.add-link {
  min-height: 52rpx;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.list-icon {
  position: relative;
  width: 28rpx;
  height: 26rpx;
  box-sizing: border-box;
  border-top: 4rpx solid var(--fb-primary);
  border-bottom: 4rpx solid var(--fb-primary);
}

.list-icon::before {
  position: absolute;
  top: 7rpx;
  right: 0;
  left: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--fb-primary);
  content: "";
}

.check-list {
  margin-top: 12rpx;
}

.check-row {
  min-height: 70rpx;
  gap: 14rpx;
  border-bottom: 1rpx solid #eef2f8;
}

.check-row:last-child {
  border-bottom: 0;
}

.check-control {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 3rpx solid #ccd7e7;
  border-radius: 11rpx;
  background: #fff;
}

.check-control-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
}

.check-mark {
  width: 16rpx;
  height: 9rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  opacity: 0;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.check-control-active .check-mark {
  opacity: 1;
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  color: #53627a;
  font-size: 24rpx;
}

.check-input-done {
  color: #98a4b6;
  text-decoration: line-through;
}

.check-placeholder {
  color: #9aa7b8;
}

.check-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #a3adbd;
  font-size: 28rpx;
}

.empty-check {
  margin-top: 14rpx;
  padding: 22rpx;
  border: 2rpx dashed #dce5f2;
  border-radius: 18rpx;
  color: #8a97aa;
  font-size: 22rpx;
  text-align: center;
}

.media-section,
.tags-section {
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(38, 76, 133, 0.035);
}

.media-head {
  margin-bottom: 14rpx;
}

.section-label {
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 900;
}

.section-count {
  color: var(--fb-muted);
  font-size: 20rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.image-tile {
  position: relative;
  height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef3fa;
}

.note-image {
  width: 100%;
  height: 100%;
}

.image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #9aa7b8;
  font-size: 21rpx;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(23, 33, 57, 0.62);
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}

.audio-card {
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.audio-play {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  box-shadow: 0 10rpx 20rpx rgba(45, 91, 255, 0.16);
}

.audio-playing {
  background: #20a97a;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.audio-copy {
  flex: 1;
  min-width: 0;
}

.audio-title {
  display: block;
  color: var(--fb-ink);
  font-size: 25rpx;
  font-weight: 800;
}

.audio-meta {
  display: block;
  margin-top: 3rpx;
  color: var(--fb-muted);
  font-size: 20rpx;
}

.audio-delete,
.tag-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #9ba7b8;
  font-size: 26rpx;
}

.tag-cloud {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.editor-tag,
.add-tag {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  min-height: 48rpx;
  box-sizing: border-box;
  padding: 0 6rpx 0 15rpx;
  border-radius: 16rpx;
  background: #edf3ff;
  color: var(--fb-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.add-tag {
  padding: 0 16rpx;
}

.format-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 14rpx 38rpx rgba(30, 58, 113, 0.13);
}

.format-item {
  justify-content: center;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-height: 84rpx;
  border-radius: 19rpx;
  color: #6d7c93;
  font-size: 21rpx;
  font-weight: 700;
}

.format-recording {
  background: #fff0ed;
  color: #c74d38;
}

.tool-icon {
  position: relative;
  display: block;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 38rpx;
  overflow: visible;
  border-radius: 13rpx;
  box-shadow: inset 0 -4rpx 0 rgba(23, 33, 57, 0.045);
}

.tool-list {
  background: #eaf2ff;
}

.tool-list-page {
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 22rpx;
  height: 26rpx;
  box-sizing: border-box;
  border: 2rpx solid #adc5ff;
  border-radius: 5rpx;
  background: #fff;
}

.tool-list-page::before {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #7f9dff;
  box-shadow: 0 7rpx 0 #aac0f7;
  content: "";
}

.tool-list-check {
  position: absolute;
  right: 3rpx;
  bottom: 2rpx;
  width: 17rpx;
  height: 17rpx;
  box-sizing: border-box;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: var(--fb-primary);
}

.tool-list-check::before {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 7rpx;
  height: 4rpx;
  border-left: 2rpx solid #fff;
  border-bottom: 2rpx solid #fff;
  content: "";
  transform: rotate(-45deg);
}

.tool-image {
  background: #e8f7f1;
}

.tool-photo-frame {
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 30rpx;
  height: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid #7ec7a9;
  border-radius: 6rpx;
  background: #fff;
}

.tool-photo-sun {
  position: absolute;
  top: 4rpx;
  right: 5rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffc75f;
}

.tool-photo-hill {
  position: absolute;
  right: -2rpx;
  bottom: -8rpx;
  left: -2rpx;
  height: 22rpx;
  border-radius: 50% 50% 0 0;
  background: #77bfa0;
  transform: rotate(-8deg);
}

.tool-photo-hill::after {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 14rpx;
  height: 18rpx;
  border-radius: 50% 50% 0 0;
  background: #a8dfca;
  content: "";
  transform: rotate(13deg);
}

.tool-tag {
  background: #fff0ed;
}

.tool-tag-shape {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 28rpx;
  height: 23rpx;
  border-radius: 6rpx 8rpx 8rpx 6rpx;
  background: #ff8a72;
  box-shadow: inset 0 -3rpx 0 rgba(194, 72, 51, 0.16);
  transform: rotate(-10deg);
}

.tool-tag-shape::after {
  position: absolute;
  top: 7rpx;
  left: 5rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.72);
  content: "";
}

.tool-tag-hole {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 6rpx;
  height: 6rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.tool-mic {
  background: #eeeaff;
}

.tool-mic-body {
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 12rpx;
  height: 20rpx;
  border-radius: 8rpx;
  background: #6c79ff;
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.35);
  transform: translateX(-50%);
}

.tool-mic-body::before {
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 2rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.6);
  content: "";
  transform: translateX(-50%);
}

.tool-mic-stand {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 22rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 3rpx solid #7b82e8;
  border-top: 0;
  border-radius: 0 0 12rpx 12rpx;
  transform: translateX(-50%);
}

.tool-mic-stand::before {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  width: 3rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #7b82e8;
  content: "";
  transform: translateX(-50%);
}

.tool-mic-stand::after {
  position: absolute;
  bottom: -7rpx;
  left: 50%;
  width: 12rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #7b82e8;
  content: "";
  transform: translateX(-50%);
}

.format-recording .tool-mic {
  background: #ffe3dc;
}

.tool-mic-recording .tool-mic-body {
  background: #ff765e;
  animation: recording-bar 0.75s ease-in-out infinite alternate;
}

.tool-mic-recording .tool-mic-stand {
  border-color: #e26853;
}

.tool-mic-recording .tool-mic-stand::before,
.tool-mic-recording .tool-mic-stand::after {
  background: #e26853;
}

.uploading-banner {
  position: fixed;
  right: 60rpx;
  bottom: calc(142rpx + env(safe-area-inset-bottom));
  left: 60rpx;
  z-index: 4;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(23, 33, 57, 0.82);
  color: #fff;
  font-size: 21rpx;
  text-align: center;
}

.login-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 640rpx;
  margin-top: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.login-art {
  position: relative;
  width: 230rpx;
  height: 205rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 320rpx;
  padding: 40rpx;
  color: #66758d;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 24, 34, 0.56);
}

.tag-modal {
  width: 590rpx;
  max-width: 100%;
  box-sizing: border-box;
  padding: 38rpx 32rpx 30rpx;
  border-radius: 30rpx;
  background: #fff;
}

.modal-title {
  display: block;
  color: var(--fb-ink);
  font-size: 34rpx;
  font-weight: 900;
}

.modal-input {
  height: 82rpx;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dfe8f5;
  border-radius: 20rpx;
  background: #f8faff;
  color: var(--fb-ink);
  font-size: 26rpx;
}

.input-placeholder {
  color: #9aa7b9;
}

.modal-error {
  display: block;
  margin-top: 10rpx;
  color: #c74d38;
  font-size: 21rpx;
}

.modal-actions {
  gap: 14rpx;
  margin-top: 26rpx;
}

.modal-cancel,
.modal-confirm {
  flex: 1;
  min-height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 78rpx;
}

.modal-cancel {
  background: #eef2f8;
  color: #66758d;
}

.modal-confirm {
  background: var(--fb-primary);
  color: #fff;
}

@keyframes recording-bar {
  from { transform: translateX(-50%) scaleY(0.72); }
  to { transform: translateX(-50%) scaleY(1.08); }
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.editor-lock {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 62rpx;
  width: 62rpx;
  height: 62rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 2rpx solid #f2d8a4;
  border-radius: 20rpx;
  background: #fffaf0;
  line-height: 0;
}


.editor-lock-icon {
  display: block;
  width: 28rpx;
  height: 40rpx;
}

.password-modal {
  width: 620rpx;
  max-width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 32rpx;
  background: #fff;
}

.password-modal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff4dc;
}

.password-modal-icon-primary {
  background: #eaf2ff;
}

.password-modal-lock {
  display: block;
  width: 32rpx;
  height: 45rpx;
}

.password-modal-title {
  display: block;
  color: var(--fb-ink);
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.password-modal-desc {
  display: block;
  margin-top: 7rpx;
  color: #718097;
  font-size: 22rpx;
  line-height: 1.6;
}

.password-field-label {
  display: block;
  margin: 24rpx 0 10rpx;
  color: #586980;
  font-size: 21rpx;
  font-weight: 700;
}

.password-modal-input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 2rpx solid #dfe7f4;
  border-radius: 22rpx;
  background: #fbfcff;
  color: var(--fb-ink);
  font-size: 25rpx;
}

.password-warning {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #f5dfb7;
  border-radius: 18rpx;
  background: #fff9ed;
  color: #a87623;
  font-size: 20rpx;
  line-height: 1.6;
}

.password-warning-mark {
  position: relative;
  flex: 0 0 22rpx;
  width: 22rpx;
  height: 19rpx;
  margin-top: 2rpx;
  border: 3rpx solid #c18a2a;
  border-radius: 5rpx;
}

.password-warning-mark::after {
  position: absolute;
  top: 3rpx;
  left: 50%;
  color: #c18a2a;
  font-size: 17rpx;
  font-weight: 900;
  content: "!";
  transform: translateX(-50%);
}

.editor-lock-active {
  border-color: #dce7ff;
  background: #eaf2ff;
}
