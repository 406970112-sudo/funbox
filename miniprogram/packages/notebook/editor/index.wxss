page {
  background: #f5f7fb;
  color: #172139;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  font-weight: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.editor-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(145deg, #f5f7fb, #eff4fc);
}

.editor-topbar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 14rpx;
  padding: 12rpx 28rpx 18rpx;
  min-height: 70rpx;
}

.book-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 290rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #d8e3ff;
  border-radius: 17rpx;
  background: #e8efff;
  font-size: 25rpx;
}

.book-pill text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  min-width: 0;
  color: #687b9d;
  font-size: 21rpx;
}

.save-state text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-saved {
  color: #238044;
}

.save-error {
  color: #ef6049;
}

.save-saving {
  color: #2455ff;
}

.done-button {
  flex-shrink: 0;
  padding: 12rpx 4rpx 12rpx 14rpx;
  color: #2455ff;
  font-size: 27rpx;
  font-weight: 600;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.writing-sheet {
  margin: 0 26rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid #e8edf5;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 5rpx 14rpx rgba(34, 59, 106, .035);
}

.title-input {
  width: 100%;
  min-height: 64rpx;
  color: #172139;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
}

.title-placeholder {
  color: #9aa8bc;
}

.date-label {
  display: block;
  margin: 8rpx 0 18rpx;
  color: #7283a2;
  font-size: 22rpx;
}

.body-input {
  width: 100%;
  min-height: 120rpx;
  color: #202c42;
  font-size: 29rpx;
  line-height: 1.7;
}

.body-placeholder {
  color: #9ca9bc;
}

.check-section {
  margin-top: 20rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f6;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-count {
  color: #617493;
  font-size: 23rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 62rpx;
}

.check-control {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #94a4bc;
  border-radius: 7rpx;
  box-sizing: border-box;
  background: #fff;
}

.check-control-active {
  border-color: #2455ff;
  background: #2455ff;
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 27rpx;
}

.check-input-done {
  color: #7f8ba1;
  text-decoration: line-through;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.add-link {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 64rpx;
  color: #2455ff;
  font-size: 25rpx;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.editor-tag, .add-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 2rpx 15rpx;
  border-radius: 28rpx;
  background: #e7eeff;
  color: #2455ff;
  font-size: 23rpx;
}

.tag-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 44rpx;
}

.add-tag {
  background: #f0f3f9;
  color: #425674;
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 14rpx 26rpx 0;
  padding: 20rpx 26rpx;
  border: 1rpx solid #e8edf5;
  border-radius: 24rpx;
  background: #fff;
}

.privacy-copy {
  flex: 1;
}

.privacy-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}

.privacy-hint {
  display: block;
  margin-top: 4rpx;
  color: #7d8ba5;
  font-size: 21rpx;
}

.privacy-row switch {
  transform: scale(.75);
  transform-origin: right center;
  pointer-events: none;
}

.autosave-hint {
  display: block;
  margin: 18rpx 0 26rpx;
  color: #7e8ca5;
  font-size: 21rpx;
  text-align: center;
}

.format-wrap {
  flex-shrink: 0;
  padding: 0 26rpx calc(16rpx + env(safe-area-inset-bottom));
}

.format-wrap.keyboard-open {
  padding-bottom: 8rpx;
}

.format-bar {
  display: flex;
  padding: 10rpx 30rpx;
  border: 1rpx solid #e2e8f1;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(30, 52, 92, .06);
}

.format-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  flex: 1;
  min-height: 88rpx;
  font-size: 22rpx;
}

.state-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 28rpx;
  margin: 30rpx;
  padding: 70rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #657795;
  font-size: 27rpx;
}

.state-title {
  color: #172139;
  font-weight: 600;
  font-size: 34rpx;
}

.state-copy {
  text-align: center;
  line-height: 1.7;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
  background: rgba(25, 39, 63, .35);
}

.bottom-mask {
  align-items: flex-end;
  padding: 0;
}

.panel {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  border-radius: 34rpx;
  background: #fff;
}

.tag-modal {
  max-width: 650rpx;
  max-height: 100%;
  overflow-y: auto;
}

.panel-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
}

.panel-title {
  display: block;
  padding: 8rpx 42rpx 12rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

.panel-description {
  display: block;
  color: #687a99;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-label {
  display: block;
  margin: 28rpx 0 12rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.modal-input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dce3ef;
  border-radius: 20rpx;
  background: #fafbfe;
  font-size: 27rpx;
}

.input-error {
  border-color: #ff765d;
}

.tag-input-wrap {
  position: relative;
}

.tag-input {
  padding-right: 110rpx;
}

.input-count {
  position: absolute;
  right: 20rpx;
  top: 26rpx;
  color: #6a7d9b;
  font-size: 23rpx;
}

.panel-hint {
  display: block;
  margin-top: 14rpx;
  color: #7082a1;
  font-size: 23rpx;
}

.error-copy {
  display: block;
  margin-top: 16rpx;
  color: #ed624c;
  font-size: 24rpx;
}

.panel-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.primary-button, .secondary-button {
  flex: 1;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 82rpx;
  text-align: center;
}

.primary-button {
  color: #fff;
  background: linear-gradient(145deg, #3470ff, #1245ff);
  box-shadow: 0 6rpx 14rpx rgba(36, 85, 255, .13);
}

.secondary-button {
  border: 1rpx solid #dbe2ee;
  color: #526483;
  background: #fafbfe;
}

.primary-button[disabled] {
  opacity: .5;
}

.book-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  padding: 22rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
}

.sheet-handle {
  width: 82rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 8rpx;
  background: #c8d2e3;
}

.sheet-title {
  display: block;
  margin: 10rpx 12rpx 28rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.book-options {
  max-height: 50vh;
}

.book-option {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 108rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #edf0f6;
  border-radius: 20rpx;
}

.book-option-selected {
  background: #e8eeff;
}

.book-name {
  flex: 1;
  font-size: 30rpx;
}

.selection-icon {
  width: 40rpx;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 60rpx;
  margin-top: 30rpx;
}

.text-button {
  flex: 1;
  color: #2455ff;
  font-size: 27rpx;
  text-align: left;
}

.password-modal {
  max-height: 100%;
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.password-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #e8eeff;
}

.password-warning {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff0eb;
  color: #df5139;
  font-size: 24rpx;
  line-height: 1.6;
}

.acknowledge {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 80rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
}

.panel-footer {
  display: block;
  margin-top: 24rpx;
  color: #7484a0;
  text-align: center;
  font-size: 22rpx;
}
