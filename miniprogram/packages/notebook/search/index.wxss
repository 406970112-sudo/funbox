.search-page { min-height:100vh; box-sizing:border-box; padding:28rpx 30rpx calc(44rpx + env(safe-area-inset-bottom)); background:#f5f7fa; color:#172139; }
.hero-title { display:block; margin:8rpx 0 28rpx; font-size:44rpx; font-weight:800; }
.search-row,.search-field,.scope-row,.filter-row,.chip,.filter-button,.applied-chip,.section-head,.result-card,.encrypted-hint,.sheet-heading,.sheet-actions,.favorite-setting,.icon-button { display:flex; align-items:center; }
.search-row { gap:20rpx; }.search-field { flex:1; min-width:0; height:82rpx; padding:0 22rpx; gap:16rpx; background:#fff; border:2rpx solid #e7ecf5; border-radius:44rpx; box-shadow:0 4rpx 12rpx rgba(38,76,133,.04); }
.search-input { flex:1; min-width:0; font-size:28rpx; color:#172139; }.placeholder { color:#8390a8; }.cancel-link,.manage-link { color:#2d5bff; font-size:26rpx; }.icon-button { justify-content:center; flex-shrink:0; width:52rpx; height:52rpx; }.clear-button { width:36rpx; height:36rpx; background:#edf0f6; border-radius:50%; }
.scope-row,.filter-row { gap:16rpx; margin-top:24rpx; }.chip { justify-content:center; padding:0 26rpx; min-height:64rpx; box-sizing:border-box; border:2rpx solid #e7ecf5; border-radius:40rpx; background:#fff; color:#44536e; font-size:26rpx; }.scope { flex:1; padding:0; }.chip.selected { background:#2d5bff; border-color:#2d5bff; color:#fff; }.filter-button { flex:1; gap:14rpx; min-height:76rpx; }.filter-active { color:#2d5bff; }.count-badge { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; border-radius:50%; background:#2d5bff; color:#fff; font-size:22rpx; }
.applied-filters,.tag-cloud,.option-row { display:flex; flex-wrap:wrap; gap:14rpx; }.applied-filters { margin-top:22rpx; }.applied-chip { gap:10rpx; padding:10rpx 22rpx; background:#e7eeff; color:#2d5bff; border-radius:32rpx; font-size:25rpx; }
.section-head { justify-content:space-between; margin:30rpx 0 20rpx; }.section-title { display:block; font-size:31rpx; font-weight:700; }.muted { color:#8490a5; font-size:23rpx; }.book-grid { display:flex; flex-wrap:wrap; gap:16rpx; }.book-card { display:flex; flex-direction:column; justify-content:center; align-items:center; flex:0 0 calc((100% - 32rpx) / 3); min-height:196rpx; padding:20rpx 12rpx; box-sizing:border-box; border-radius:28rpx; }.book-name { display:block; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:28rpx; font-weight:700; margin-top:14rpx; }.book-count { display:block; margin-top:8rpx; font-size:23rpx; color:#70809a; }
.result-list { display:flex; flex-direction:column; gap:18rpx; }.result-card { align-items:flex-start; gap:22rpx; padding:28rpx 26rpx; border-radius:26rpx; background:#fff; border:2rpx solid #e9eef7; box-shadow:0 4rpx 14rpx rgba(38,76,133,.025); }.result-copy { flex:1; min-width:0; }.result-icon { padding-top:4rpx; flex-shrink:0; }.result-title { display:block; font-size:31rpx; line-height:1.5; font-weight:700; }.result-snippet { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:#596984; font-size:26rpx; line-height:1.7; margin-top:6rpx; }.result-meta { display:block; font-size:23rpx; color:#7c89a0; margin-top:10rpx; }.result-tag { display:inline-block; max-width:100%; box-sizing:border-box; padding:6rpx 16rpx; border-radius:14rpx; background:#edf2ff; color:#2d5bff; font-size:23rpx; margin-top:14rpx; }.recent-card { align-items:center; padding:20rpx 24rpx; }.encrypted-hint { justify-content:center; gap:10rpx; margin-top:28rpx; color:#8190aa; font-size:23rpx; }
.state-card,.empty-search,.login-card { display:flex; align-items:center; flex-direction:column; justify-content:center; gap:24rpx; text-align:center; padding:56rpx 28rpx; }.state-card { background:#fff; border-radius:26rpx; color:#7c89a0; }.empty-search { padding-top:100rpx; }.empty-art { display:flex; align-items:center; justify-content:center; position:relative; width:220rpx; height:200rpx; background:#eaf0ff; border-radius:60rpx; margin-bottom:24rpx; }.empty-glass { position:absolute; right:0; bottom:0; }.empty-title { display:block; font-size:38rpx; font-weight:800; }.empty-desc { display:block; color:#7c89a0; font-size:26rpx; line-height:1.7; }.empty-button { width:340rpx; }.login-card { min-height:600rpx; }
.primary,.secondary { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:88rpx; padding:18rpx 28rpx; margin:0; border-radius:24rpx; font-size:29rpx; line-height:1.4; font-weight:600; }.primary { background:#2d5bff; color:#fff; }.secondary { background:#f0f3f9; color:#4c5a73; }.primary::after,.secondary::after { border:none; }
.overlay { position:fixed; z-index:30; inset:0; display:flex; align-items:flex-end; background:rgba(23,33,57,.4); }.bottom-sheet { width:100%; box-sizing:border-box; border-radius:40rpx 40rpx 0 0; padding:22rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); background:#fff; }.sheet-handle { width:72rpx; height:8rpx; margin:0 auto 22rpx; background:#d8dfeb; border-radius:8rpx; }.sheet-heading { position:relative; justify-content:center; height:64rpx; font-size:34rpx; font-weight:700; margin-bottom:32rpx; }.sheet-close { position:absolute; right:0; top:6rpx; }.filter-content { height:46vh; max-height:calc(100vh - 360rpx); }.option-row { margin:22rpx 0 40rpx; }.favorite-setting { gap:18rpx; border-top:2rpx solid #edf0f5; border-bottom:2rpx solid #edf0f5; padding:28rpx 0; font-size:28rpx; }.favorite-setting text { flex:1; }.sheet-help { display:block; text-align:center; color:#8a97ad; font-size:23rpx; margin:38rpx 0; }.sheet-actions { gap:20rpx; }.sheet-actions button { flex:1; }.sheet-actions .primary { flex:1.35; }
