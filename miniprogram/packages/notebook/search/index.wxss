.search-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 30rpx calc(156rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 92% 2%, #eaf2ff 0%, transparent 40%), var(--fb-canvas);
}

.search-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
}

.search-hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: #6b7890;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  display: block;
  color: var(--fb-ink);
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.hero-accent {
  color: var(--fb-primary);
}

.search-hero-art {
  position: relative;
  flex: 0 0 210rpx;
  width: 210rpx;
  height: 188rpx;
  margin: -8rpx -18rpx 0 0;
}

.search-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 3rpx solid var(--fb-primary);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 0 0 8rpx rgba(45, 91, 255, 0.055);
}

.search-icon {
  position: relative;
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 25rpx;
  border: 3rpx solid var(--fb-primary);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--fb-primary);
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: var(--fb-ink);
  font-size: 26rpx;
  font-weight: 700;
}

.search-placeholder {
  color: #9aa6b8;
  font-weight: 500;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #e9eef7;
  color: #77869d;
  font-size: 26rpx;
  font-weight: 700;
}

.scope-row {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.scope-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 62rpx;
  border: 2rpx solid #fff;
  border-radius: 20rpx;
  background: #fff;
  color: #64738b;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 7rpx 18rpx rgba(38, 76, 133, 0.03);
}

.scope-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
  color: #fff;
}

.result-head,
.section-head,
.result-top,
.manage-link,
.favorite-row,
.favorite-toggle {
  display: flex;
  align-items: center;
}

.result-head,
.section-head {
  justify-content: space-between;
}

.favorite-row {
  justify-content: flex-start;
  margin-top: 12rpx;
}

.favorite-toggle {
  gap: 10rpx;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 0 18rpx 0 8rpx;
  border: 2rpx solid #fff;
  border-radius: 18rpx;
  background: #fff;
  color: #64738b;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 7rpx 18rpx rgba(38, 76, 133, 0.03);
  transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.12s ease;
}

.favorite-toggle-pressed {
  background: #f4f7fd;
  transform: scale(0.98);
}

.favorite-toggle-active {
  border-color: #ffb8a7;
  background: #fff0ed;
  color: #c95e49;
}

.favorite-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 36rpx;
  border-radius: 12rpx;
  background: #fff0ed;
  box-shadow: inset 0 -3rpx 0 rgba(23, 33, 57, 0.04);
  transition: background 0.16s ease, box-shadow 0.16s ease;
}

.favorite-toggle-active .favorite-icon {
  background: #ffe5df;
  box-shadow: inset 0 -3rpx 0 rgba(194, 72, 51, 0.06), 0 4rpx 10rpx rgba(255, 118, 94, 0.08);
}

.favorite-icon-image {
  display: block;
  width: 34rpx;
  height: 28rpx;
}

.result-head {
  margin: 26rpx 4rpx 14rpx;
}

.result-title,
.section-title {
  color: var(--fb-ink);
  font-size: 30rpx;
  font-weight: 900;
}

.result-meta,
.section-note {
  color: var(--fb-muted);
  font-size: 21rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.result-card {
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 2rpx solid #fff;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(38, 76, 133, 0.035);
}

.result-top {
  justify-content: space-between;
  gap: 14rpx;
}

.result-query {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #fff5d9;
  color: #765e15;
  font-size: 20rpx;
  font-weight: 700;
}

.note-time {
  margin-left: auto;
  color: var(--fb-muted);
  font-size: 20rpx;
}

.result-title-text {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-snippet {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #68778e;
  font-size: 22rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.result-book {
  display: block;
  margin-top: 10rpx;
  color: var(--fb-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.empty-search {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 330rpx;
  padding: 32rpx;
  text-align: center;
}

.empty-search-art {
  position: relative;
  width: 180rpx;
  height: 160rpx;
  margin-bottom: 8rpx;
}

.empty-search-title {
  color: var(--fb-ink);
  font-size: 29rpx;
  font-weight: 900;
}

.empty-search-desc {
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 22rpx;
}

.organize-section {
  margin-top: 30rpx;
}

.manage-link {
  justify-content: flex-end;
  min-height: 56rpx;
  color: var(--fb-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.book-card {
  position: relative;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  min-height: 170rpx;
  box-sizing: border-box;
  padding: 20rpx 18rpx 18rpx 24rpx;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(38, 76, 133, 0.035);
}

.book-card-active {
  box-shadow: 0 0 0 4rpx var(--fb-primary), 0 10rpx 24rpx rgba(45, 91, 255, 0.1);
}

.book-spine {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 10rpx;
  background: rgba(255, 255, 255, 0.5);
}

.book-name {
  color: var(--fb-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.book-count {
  color: currentColor;
  font-size: 20rpx;
  font-weight: 700;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cloud-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 2rpx solid #fff;
  border-radius: 18rpx;
  background: #fff;
  color: #65758e;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 7rpx 18rpx rgba(38, 76, 133, 0.025);
}

.cloud-tag-active {
  border-color: var(--fb-primary);
  background: var(--fb-primary);
  color: #fff;
}

.tag-count {
  color: #9aa7ba;
  font-size: 19rpx;
}

.cloud-tag-active .tag-count {
  color: rgba(255, 255, 255, 0.7);
}

.tag-empty {
  color: var(--fb-muted);
  font-size: 22rpx;
}

.new-note-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  box-shadow: 0 16rpx 36rpx rgba(45, 91, 255, 0.28);
}

.fab-plus {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.fab-plus::before,
.fab-plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 4rpx;
  background: #fff;
  content: "";
  transform: translate(-50%, -50%);
}

.fab-plus::before {
  width: 38rpx;
  height: 6rpx;
}

.fab-plus::after {
  width: 6rpx;
  height: 38rpx;
}

.state-card,
.login-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 260rpx;
  padding: 36rpx;
  color: #66758d;
  font-size: 23rpx;
  text-align: center;
}

.state-error {
  background: #fff0ed;
  color: #c74d38;
}

.state-action {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  color: var(--fb-primary);
  font-weight: 800;
}

.state-pulse {
  width: 18rpx;
  height: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: var(--fb-primary);
  animation: notebook-pulse 1.1s ease-in-out infinite;
}

.login-card {
  margin-top: 30rpx;
  min-height: 560rpx;
  padding: 46rpx 32rpx;
}

.login-art {
  position: relative;
  width: 230rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

.login-title {
  color: var(--fb-ink);
  font-size: 33rpx;
  font-weight: 900;
}

.login-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #66758d;
  font-size: 23rpx;
  line-height: 1.75;
}

.login-button {
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--fb-primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

@keyframes notebook-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
