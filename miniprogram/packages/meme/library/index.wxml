<view class="meme-page">
  <view class="sticky-head">
    <view class="mode-switch" role="tablist" aria-label="搜索模式">
      <button class="mode-button {{mode === 'library' ? 'active' : ''}}" data-mode="library" bindtap="changeMode" role="tab" aria-selected="{{mode === 'library'}}">图库</button>
      <button class="mode-button {{mode === 'online' ? 'active' : ''}}" data-mode="online" bindtap="changeMode" role="tab" aria-selected="{{mode === 'online'}}">联网搜图</button>
    </view>
    <view
      wx:if="{{mode === 'online' || !(tab === 'favorites' && favoriteMode === 'favorites' && loggedIn)}}"
      class="search-box"
    ><view class="search-icon" aria-hidden="true" /><input
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="search"
        confirm-type="search"
        placeholder="{{mode === 'online' ? '输入关键词，点击搜索' : (tab === 'categories' ? '搜索分类名称' : '搜索表情包、分类')}}"
        aria-label="搜索表情包或分类"
      /><button bindtap="search">搜索</button></view>
    <view
      wx:if="{{mode === 'library'}}"
      class="source"
      bindtap="copySource"
      role="button"
      aria-label="复制 ChineseBQB 来源网址"
      hover-class="source-pressed"
    ><text class="source-label">ChineseBQB · {{tab === 'categories' ? categoryTotal + ' 个分类' : '按已有标签与分类搜索'}}</text><view class="copy-icon" aria-hidden="true" /></view>
    <view wx:if="{{mode === 'library'}}" class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="tab {{tab === item.id ? 'selected' : ''}}"
        data-tab="{{item.id}}"
        bindtap="changeTab"
      >{{item.title}}</view>
    </view>
  </view>
  <view wx:if="{{mode === 'online'}}" class="online-panel">
    <button class="online-toggle" bindtap="toggleOnlineDetails" aria-expanded="{{onlineDetailsExpanded}}" aria-label="{{onlineDetailsExpanded ? '收起多站搜索信息' : '展开多站搜索信息'}}">
      <text class="online-toggle-title">多站搜索</text>
      <text class="online-summary">{{sourcesLoading ? '正在加载来源…' : (sourcesError ? '来源加载失败' : '已选 ' + onlineSelected.length + ' 个来源')}}</text>
      <view class="online-toggle-action"><text>{{onlineDetailsExpanded ? '收起' : '展开'}}</text><view class="chevron-icon {{onlineDetailsExpanded ? 'expanded' : ''}}" aria-hidden="true" /></view>
    </button>
    <view wx:if="{{onlineDetailsExpanded}}" class="online-details">
    <view class="online-intro">结果按来源返回，不代表热度排名</view>
    <view wx:if="{{sourcesLoading}}" class="muted">正在加载来源…</view>
    <view wx:if="{{sourcesError}}" class="sync-note">{{sourcesError}}<button class="history-button" bindtap="loadOnlineSources">重试来源</button></view>
    <view class="online-sources">
      <button wx:for="{{onlineSources}}" wx:key="id" class="source-chip {{item.selected ? 'active' : ''}}" disabled="{{!item.enabled || loading}}" data-id="{{item.id}}" bindtap="toggleOnlineSource" aria-label="{{item.title + (item.enabled ? (item.selected ? '，已选择' : '，未选择') : '，不可用')}}">{{item.title}}{{!item.enabled ? ' · 不可用' : ''}}</button>
    </view>
    <view wx:for="{{onlineSources}}" wx:key="id" wx:if="{{!item.enabled}}" class="online-source-note">{{item.title}}：{{item.reason || '暂不可用'}}</view>
    <view wx:for="{{onlineStatuses}}" wx:key="id" class="online-source-note {{item.status === 'error' ? 'source-error' : ''}}">{{item.title}} · {{item.status === 'ok' ? '已返回' : (item.status === 'empty' ? '没有结果' : (item.status === 'disabled' ? '不可用' : '搜索失败'))}}<text wx:if="{{item.message}}"> · {{item.message}}</text><text wx:if="{{item.status === 'error'}}" class="link" bindtap="retry"> 重试</text></view>
    <view wx:if="{{onlineNotice}}" class="online-source-note">{{onlineNotice}}</view>
    <view wx:if="{{onlineAttribution}}" class="online-source-note link" bindtap="copyOnlineAttribution">搜索适配 {{onlineAttribution.name}} · 复制项目来源</view>
    </view>
  </view>
  <view
    wx:if="{{mode === 'library' && searches.length && !q && tab !== 'ranking' && tab !== 'favorites'}}"
    class="search-history"
  ><text class="muted">最近搜索</text><text
      wx:for="{{searches}}"
      wx:key="*this"
      class="history-chip"
      data-q="{{item}}"
      bindtap="historySearch"
    >{{item}}</text><text
      class="link"
      bindtap="clearHistory"
    >清除</text></view>
  <block wx:if="{{mode === 'library' && tab === 'categories'}}">
    <scroll-view
      class="groups"
      scroll-x
    >
      <view
        class="group {{group === item ? 'active' : ''}}"
        wx:for="{{groups}}"
        wx:key="*this"
        data-group="{{item}}"
        bindtap="chooseGroup"
      >{{item}}</view>
    </scroll-view>
    <view class="section-heading">全部原生分类 <text class="muted">{{categoryTotal}} 个，可按名称搜索</text></view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-card"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="chooseCategory"
      >
        <image
          wx:if="{{item.coverUrl}}"
          src="{{item.coverUrl}}"
          mode="aspectFit"
          lazy-load
        /><text class="category-name">{{item.title}}</text><text class="muted">{{item.count}} 张</text><text
          wx:if="{{item.originalTitle && item.originalTitle !== item.title}}"
          class="original-title"
        >原名 {{item.originalTitle}}</text>
      </view>
    </view>
  </block>
  <block wx:else>
    <block wx:if="{{mode === 'library' && tab === 'ranking'}}">
      <view class="rank-heading">FunBox 站内热门 <text
          class="link"
          bindtap="explainRanking"
        >榜单说明 ⓘ</text></view>
      <view class="filters">
        <view
          class="chip {{period === 'day' && !date ? 'active' : ''}}"
          data-period="day"
          bindtap="changePeriod"
        >今日</view>
        <view
          class="chip {{period === 'week' ? 'active' : ''}}"
          data-period="week"
          bindtap="changePeriod"
        >本周</view>
        <view
          class="chip {{period === 'all' ? 'active' : ''}}"
          data-period="all"
          bindtap="changePeriod"
        >总榜</view><button
          class="history-button"
          bindtap="loadDates"
          loading="{{datesLoading}}"
        >历史日榜</button>
      </view>
      <view
        wx:if="{{dates.length}}"
        class="date-row"
      >
        <picker
          range="{{dates}}"
          value="{{dateIndex}}"
          bindchange="chooseDate"
        ><view class="picker-label link"><text>{{date || '选择日期'}}</text><view class="chevron-icon" aria-hidden="true" /></view></picker><text
          wx:if="{{datesCursor}}"
          class="link"
          bindtap="loadDates"
        >更多日期</text>
      </view>
      <view class="rank-notice">{{rankNotice || '根据本站有效浏览、收藏与保存生成'}}</view>
      <view class="rank-meta">{{rankingMeta}}</view>
      <view class="rank-list">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="rank-card"
          data-id="{{item.id}}"
          bindtap="openImage"
        ><text
            wx:if="{{rankMode === 'ranking' && item.rank}}"
            class="rank-number"
          >{{item.rank}}</text>
          <image
            wx:if="{{!item.unavailable && !broken[item.id]}}"
            src="{{item.thumbnailUrl}}"
            mode="aspectFit"
            lazy-load
            data-id="{{item.id}}"
            binderror="imageError"
          />
          <view
            wx:else
            class="rank-placeholder"
          >图片暂不可用</view>
          <view class="rank-copy"><text class="rank-title">{{item.title}}</text><text class="muted">{{item.animated ? '动图' : '静图'}} · {{item.categories[0].title || '表情包'}}</text><text
              wx:if="{{rankMode === 'ranking'}}"
              class="score"
            >站内热度 {{item.score}}</text><text
              wx:else
              class="curated"
            >精选推荐 · 热度积累中</text></view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view
        wx:if="{{mode === 'library' && tab === 'favorites'}}"
        class="collection-head"
      >
        <view class="filters"><text
            class="chip {{favoriteMode === 'favorites' ? 'active' : ''}}"
            data-mode="favorites"
            bindtap="changeFavoriteMode"
          >我的收藏</text><text
            class="chip {{favoriteMode === 'recent' ? 'active' : ''}}"
            data-mode="recent"
            bindtap="changeFavoriteMode"
          >最近浏览</text><text
            wx:if="{{loggedIn && pendingCount}}"
            class="chip {{favoriteMode === 'pending' ? 'active' : ''}}"
            data-mode="pending"
            bindtap="changeFavoriteMode"
          >待同步 {{pendingCount}}</text></view>
        <view class="collection-note">{{loggedIn ? (favoriteMode === 'pending' ? '待同步操作保存在本机，可重试同步' : '账号云收藏，按收藏顺序排列') : '仅保存在本机，清理微信数据后将丢失'}}<text
            wx:if="{{!loggedIn}}"
            class="link"
            bindtap="login"
          > 登录同步 ›</text></view>
        <view
          wx:if="{{syncMessage}}"
          class="sync-note"
        >{{syncMessage}}<text
            class="link"
            bindtap="syncFavorites"
          > 重试同步</text></view>
      </view>
      <view
        wx:if="{{mode === 'library' && !(tab === 'favorites' && favoriteMode === 'favorites' && loggedIn)}}"
        class="filters"
      >
        <view
          class="chip {{type === '' ? 'active' : ''}}"
          data-type=""
          bindtap="changeType"
        >全部</view>
        <view
          class="chip {{type === 'false' ? 'active' : ''}}"
          data-type="false"
          bindtap="changeType"
        >静图</view>
        <view
          class="chip {{type === 'true' ? 'active' : ''}}"
          data-type="true"
          bindtap="changeType"
        >动图</view>
        <picker
          wx:if="{{tab === 'all'}}"
          class="sort"
          range="{{sortOptions}}"
          value="{{sortIndex}}"
          bindchange="changeSort"
        ><view class="picker-label"><text>{{sortOptions[sortIndex]}}</text><view class="chevron-icon" aria-hidden="true" /></view></picker>
      </view>
      <view
        wx:if="{{mode === 'library' && category}}"
        class="category-filter"
      ><text class="category-filter-title">{{categoryTitle || category}}</text><button
          class="category-clear"
          bindtap="clearCategory"
          hover-class="category-clear-pressed"
          aria-label="清除分类筛选"
        ><text>清除</text><view class="close-icon" aria-hidden="true" /></button></view>
      <view class="result-count">{{loading ? '正在查找…' : (mode === 'online' ? (onlineSearched ? '本页 ' + items.length + ' 张图片' : '输入关键词开始联网搜索') : total + ' 张图片')}}<text wx:if="{{q && mode === 'library'}}"> · “{{q}}”</text></view>
      <view class="image-grid">
        <view
          class="image-tile"
          wx:for="{{items}}"
          wx:key="id"
        >
          <view
            class="tile-media"
            data-id="{{item.id}}"
            bindtap="openImage"
          >
            <image
              wx:if="{{!item.unavailable && !broken[item.id]}}"
              src="{{item.thumbnailUrl}}"
              mode="aspectFit"
              lazy-load
              data-id="{{item.id}}"
              binderror="imageError"
            />
            <view
              wx:else
              class="missing"
            >{{item.unavailable ? '内容已下架' : '图片暂不可用'}}<text>{{item.unavailable ? '可移除此收藏' : '点按详情可重试'}}</text></view><text
              wx:if="{{item.animated}}"
              class="gif-badge"
            >动图</text>
          </view><text class="tile-title">{{item.title}}</text><text wx:if="{{mode === 'online' && item.sourceName}}" class="tile-source">{{item.sourceName}}</text><text
            wx:if="{{mode === 'library' && (item.unavailable || broken[item.id]) && tab === 'favorites' && favoriteMode === 'favorites'}}"
            class="remove-link"
            data-id="{{item.id}}"
            bindtap="removeUnavailable"
          >移除收藏</text>
        </view>
      </view>
      <view
        wx:if="{{items.length || (mode === 'online' && onlineSearched && (page > 1 || onlineHasMore))}}"
        class="pagination"
      ><button
          bindtap="previous"
          disabled="{{page === 1 || loading}}"
        >上一页</button><text>第 {{page}} 页</text><button
          bindtap="next"
          disabled="{{(mode === 'online' ? !onlineHasMore : !nextCursor) || loading}}"
        >下一页</button></view>
      <view
        wx:if="{{items.length && (mode === 'online' ? !onlineHasMore : !nextCursor) && !loading}}"
        class="end-note"
      >已经到底了</view>
    </block>
  </block>
  <view
    wx:if="{{loading}}"
    class="loading-state"
  >
    <view class="skeleton-grid">
      <view
        wx:for="{{[1,2,3,4,5,6]}}"
        wx:key="*this"
      />
    </view><text>正在加载，请稍候…</text>
  </view>
  <view
    wx:if="{{error}}"
    class="error-state"
  ><text>{{error}}</text><button bindtap="retry">重试</button></view>
  <view
    wx:if="{{!loading && !error && (mode === 'library' && tab === 'categories' ? !categories.length : !items.length)}}"
    class="empty-state"
  ><view class="empty-icon" aria-hidden="true"><view class="search-icon" /></view><text>{{mode === 'online' ? (onlineSearched ? '本页没有图片，请查看各来源状态' : '输入关键词，选择来源后点击搜索') : (tab === 'favorites' ? '这里还没有图片' : '没有找到，换个词试试')}}</text><text wx:if="{{mode === 'library'}}" class="muted">搜索仅匹配已有名称、标签和分类</text><button
      wx:if="{{mode === 'library'}}"
      data-tab="categories"
      bindtap="changeTab"
    >浏览全部分类</button></view>
  <view
    wx:if="{{mode === 'library'}}"
    class="source-footer"
    bindtap="copySource"
  >来源 ChineseBQB · 点击复制来源网址</view>
</view>
