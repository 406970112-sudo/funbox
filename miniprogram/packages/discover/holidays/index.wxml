<view class="holiday-page {{reduceMotion ? 'motion-reduced' : ''}}">
  <!-- FunBox Editorial Hero -->
  <view class="holiday-hero">
    <view class="topbar">
      <view>
        <text class="fb-brand">FunBox</text>
        <text class="brand-caption">节假日倒计时</text>
      </view>
      <view wx:if="{{todayLabel}}" class="today-pill {{isMakeupDay ? 'today-pill-makeup' : highlight && highlight.state === 'holiday' ? 'today-pill-holiday' : ''}}">
        <view class="today-dot" aria-hidden="true"></view>
        <text>{{todayLabel}}</text>
      </view>
    </view>

    <view class="hero-editorial">
      <view class="hero-copy">
        <block wx:if="{{status === 'ready' && highlight && highlight.state === 'holiday'}}">
          <text class="headline">正在放假，</text>
          <text class="headline">好好<text class="headline-accent headline-accent-mint">放松一下。</text></text>
        </block>
        <block wx:elif="{{status === 'ready' && highlight && highlight.state === 'tomorrow'}}">
          <text class="headline">明天放假，</text>
          <text class="headline">准备<text class="headline-accent headline-accent-warm">出发吧。</text></text>
        </block>
        <block wx:elif="{{status === 'ready' && isMakeupDay}}">
          <text class="headline">今日补班，</text>
          <text class="headline">下个假期<text class="headline-accent">不远了。</text></text>
        </block>
        <block wx:else>
          <text class="headline">算好假期，</text>
          <text class="headline">每次相聚<text class="headline-accent">都从容。</text></text>
        </block>
        <view wx:if="{{weekend}}" class="weekend-chip weekend-{{weekend.tone}}">
          <view class="weekend-dot" aria-hidden="true"></view>
          <text>{{weekend.label}}</text>
        </view>
      </view>

      <!-- Handcrafted layered 3D calendar artwork matching FunBox note-art DNA -->
      <view class="cal-art cal-art-{{highlight ? highlight.state : 'upcoming'}}" aria-hidden="true">
        <view class="cal-art-back"></view>
        <view class="cal-art-front">
          <view class="cal-art-rings"><view></view><view></view></view>
          <view class="cal-art-head">{{highlight ? highlight.monthBadge : '假期'}}</view>
          <view class="cal-art-day">{{highlight ? highlight.dayBadge : '休'}}</view>
          <view class="cal-art-dots"></view>
        </view>
        <view class="cal-art-badge">{{highlight && highlight.state === 'holiday' ? '✓' : '休'}}</view>
      </view>
    </view>
  </view>

  <block wx:if="{{status === 'ready'}}">
    <view wx:if="{{isMakeupDay}}" class="makeup-today-banner" role="status">
      <view class="makeup-today-badge">班</view>
      <view class="makeup-today-copy">
        <text class="makeup-today-title">今天调休上班</text>
        <text class="makeup-today-desc">辛苦啦，再坚持一下就能迎来下一个假期</text>
      </view>
    </view>

    <!-- Spotlight Ticket Countdown Card -->
    <view wx:if="{{highlight}}" class="spotlight-card spotlight-{{highlight.state}}">
      <view class="spotlight-upper">
        <view class="spotlight-tags">
          <view class="spotlight-state-pill">
            <view class="spotlight-state-dot" aria-hidden="true"></view>
            <text>{{highlight.state === 'holiday' ? '假期进行中' : highlight.state === 'tomorrow' ? '明天放假' : highlight.state === 'near' ? '不足一周' : '下一次放假'}}</text>
          </view>
          <text class="spotlight-duration-pill">{{highlight.duration > 1 ? '连休 ' + highlight.duration + ' 天' : '放假 1 天'}}</text>
        </view>

        <view class="spotlight-main">
          <view class="spotlight-info">
            <text class="spotlight-name">{{highlight.name}}</text>
            <text class="spotlight-date">{{highlight.year}} 年 {{highlight.dateLabel}}</text>
            <text class="spotlight-weekdays">{{highlight.weekdayRange}}</text>
          </view>
          <view wx:if="{{highlight.state !== 'holiday' || highlight.duration > 1}}" class="spotlight-count">
            <text class="spotlight-count-label">{{highlight.state === 'holiday' ? '假期第' : '还有'}}</text>
            <view class="spotlight-count-figure">
              <text class="spotlight-count-number">{{highlight.state === 'holiday' ? highlight.dayNumber : highlight.daysUntil}}</text>
              <text class="spotlight-count-unit">天</text>
            </view>
          </view>
          <view wx:else class="spotlight-count">
            <text class="spotlight-count-single">今天</text>
            <text class="spotlight-count-label">放假中</text>
          </view>
        </view>

        <view wx:if="{{highlight.state === 'holiday' && highlight.duration > 1}}" class="spotlight-progress">
          <view class="spotlight-progress-head">
            <text>假期进度</text>
            <text>第 {{highlight.dayNumber}} / {{highlight.duration}} 天</text>
          </view>
          <view class="spotlight-progress-track">
            <view class="spotlight-progress-fill" style="width: {{highlight.progressPercent}}%;"></view>
          </view>
        </view>
      </view>

      <!-- Ticket tear-line divider -->
      <view class="ticket-divider" aria-hidden="true">
        <view class="ticket-notch ticket-notch-left"></view>
        <view class="ticket-dash"></view>
        <view class="ticket-notch ticket-notch-right"></view>
      </view>

      <view class="spotlight-lower">
        <scroll-view class="day-strip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="day-strip">
            <view
              wx:for="{{highlight.days}}"
              wx:key="date"
              class="day-chip day-chip-{{item.kind}} {{item.isToday ? 'day-chip-today' : ''}}"
            >
              <text class="day-chip-week">周{{item.weekday}}</text>
              <text class="day-chip-date">{{item.monthDay}}</text>
              <text class="day-chip-badge">{{item.badge}}</text>
            </view>
          </view>
        </scroll-view>

        <view class="spotlight-footer">
          <view class="spotlight-makeup-status">
            <text wx:if="{{highlight.hasMakeup}}" class="status-pill-makeup">调休 {{highlight.makeupCount}} 天</text>
            <text wx:else class="status-pill-clean">✓ 无需调休</text>
          </view>
          <view class="spotlight-actions">
            <button class="spotlight-action-btn {{copiedHighlight ? 'spotlight-action-done' : ''}}" hover-class="fb-tap-btn" bindtap="copyHighlight">{{copiedHighlight ? '✓ 已复制' : '复制安排'}}</button>
            <button class="spotlight-action-btn spotlight-action-primary" hover-class="fb-tap-btn" open-type="share">转发给好友</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{awaitingNotice}}" class="spotlight-card spotlight-awaiting">
      <view class="spotlight-upper">
        <view class="spotlight-tags">
          <view class="spotlight-state-pill">
            <view class="spotlight-state-dot" aria-hidden="true"></view>
            <text>等待新安排</text>
          </view>
        </view>
        <text class="spotlight-name awaiting-name">下一次放假安排待公布</text>
        <text class="spotlight-weekdays">国务院办公厅发布新一年度放假通知后会及时更新，你也可以切到往年查看历史记录。</text>
      </view>
    </view>

    <view wx:else class="spotlight-card spotlight-history">
      <view class="spotlight-upper">
        <view class="spotlight-tags">
          <view class="spotlight-state-pill">
            <view class="spotlight-state-dot" aria-hidden="true"></view>
            <text>历史年度回顾</text>
          </view>
        </view>
        <text class="spotlight-name awaiting-name">{{selectedYear}} 年假期已全部结束</text>
        <text class="spotlight-weekdays">全年共 {{yearStats.totalCount}} 个法定节假日，累计休假 {{yearStats.totalDays}} 天。</text>
      </view>
    </view>

    <!-- Annual Overview KPI Strip -->
    <view wx:if="{{yearStats}}" class="overview-strip fb-card">
      <view class="overview-cell">
        <text class="overview-num overview-num-primary">{{yearStats.totalDays}}</text>
        <text class="overview-label">全年休假(天)</text>
      </view>
      <view class="overview-divider" aria-hidden="true"></view>
      <view class="overview-cell">
        <text class="overview-num {{yearStats.remainingDays > 0 ? 'overview-num-mint' : ''}}">{{yearStats.remainingDays}}</text>
        <text class="overview-label">{{yearStats.remainingCount > 0 ? '今年余假(天)' : '本年已休完'}}</text>
      </view>
      <view class="overview-divider" aria-hidden="true"></view>
      <view class="overview-cell">
        <text class="overview-num {{yearStats.makeupCount > 0 ? 'overview-num-warm' : ''}}">{{yearStats.makeupCount}}</text>
        <text class="overview-label">调休补班(天)</text>
      </view>
    </view>

    <!-- Section Head & Year Switcher -->
    <view class="section-head">
      <view class="section-head-left">
        <text class="section-title">全年放假安排</text>
        <text class="section-note">{{selectedYear}} 年 · 共 {{holidays.length}} 个假期</text>
      </view>
      <view wx:if="{{years.length > 1 && years.length <= 3}}" class="year-tabs" role="tablist" aria-label="切换年份">
        <view
          wx:for="{{years}}"
          wx:key="*this"
          class="year-tab {{selectedYear === item ? 'year-tab-active' : ''}}"
          data-year="{{item}}"
          bindtap="selectYear"
          hover-class="fb-tap-btn"
          role="tab"
          aria-selected="{{selectedYear === item}}"
        >{{item}}</view>
      </view>
      <picker wx:elif="{{years.length > 3}}" range="{{yearLabels}}" value="{{yearIndex}}" bindchange="onYearChange" aria-label="查看年份">
        <view class="year-picker" hover-class="fb-tap-btn"><text>{{selectedYear}} 年</text><view class="year-picker-arrow" aria-hidden="true" /></view>
      </picker>
      <text wx:else class="year-picker">{{selectedYear}} 年</text>
    </view>

    <!-- Filter Chips -->
    <scroll-view wx:if="{{yearStats}}" class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view class="filter-chip {{activeFilter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="changeFilter" hover-class="fb-tap-btn">全部<text class="filter-count">{{yearStats.totalCount}}</text></view>
        <view wx:if="{{yearStats.remainingCount > 0 && yearStats.remainingCount < yearStats.totalCount}}" class="filter-chip {{activeFilter === 'upcoming' ? 'filter-active' : ''}}" data-filter="upcoming" bindtap="changeFilter" hover-class="fb-tap-btn">即将到来<text class="filter-count">{{yearStats.remainingCount}}</text></view>
        <view class="filter-chip {{activeFilter === 'clean' ? 'filter-active' : ''}}" data-filter="clean" bindtap="changeFilter" hover-class="fb-tap-btn">无需调休<text class="filter-count">{{yearStats.cleanCount}}</text></view>
        <view class="filter-chip {{activeFilter === 'makeup' ? 'filter-active' : ''}}" data-filter="makeup" bindtap="changeFilter" hover-class="fb-tap-btn">含调休<text class="filter-count">{{yearStats.withMakeupCount}}</text></view>
      </view>
    </scroll-view>

    <!-- Individual Expandable Holiday Cards -->
    <view wx:if="{{filteredHolidays.length}}" class="holiday-cards">
      <view
        wx:for="{{filteredHolidays}}"
        wx:key="id"
        class="holiday-card fb-card card-theme-{{item.theme}} {{item.past ? 'holiday-card-past' : ''}} {{item.current ? 'holiday-card-current' : ''}} {{item.inProgress ? 'holiday-card-live' : ''}} {{expandedId === item.id ? 'holiday-card-expanded' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleHoliday"
        hover-class="fb-tap-card"
        hover-start-time="0"
        hover-stay-time="100"
        role="button"
        aria-expanded="{{expandedId === item.id}}"
      >
        <view class="holiday-card-head">
          <view class="date-tile" aria-hidden="true">
            <text class="date-tile-month">{{item.monthBadge}}</text>
            <text class="date-tile-day">{{item.dayBadge}}</text>
          </view>

          <view class="holiday-card-copy">
            <view class="holiday-card-title-row">
              <text class="holiday-card-name">{{item.name}}</text>
              <text class="duration-pill">{{item.duration > 1 ? '连休 ' + item.duration + ' 天' : '1 天'}}</text>
              <text wx:if="{{item.inProgress}}" class="badge-live">进行中</text>
              <text wx:elif="{{item.current}}" class="badge-next">下一假期</text>
            </view>
            <text class="holiday-card-date">{{item.dateLabel}} · {{item.weekdayRange}}</text>
            <view class="holiday-card-meta">
              <text wx:if="{{item.hasMakeup}}" class="meta-makeup">调休 {{item.makeupCount}} 天</text>
              <text wx:elif="{{!item.past}}" class="meta-clean">无需调休</text>
              <text wx:else class="meta-past-note">已过假期</text>
              <text class="expand-hint">{{expandedId === item.id ? '收起日历' : '展开日历'}}</text>
            </view>
          </view>

          <view class="holiday-card-right">
            <text wx:if="{{item.past}}" class="countdown-past">已结束</text>
            <text wx:elif="{{item.inProgress}}" class="countdown-live">{{item.statusText}}</text>
            <text wx:elif="{{item.daysUntil === 1}}" class="countdown-tomorrow">明天</text>
            <view wx:else class="countdown-days">
              <text class="countdown-days-num">{{item.daysUntil}}</text>
              <text class="countdown-days-unit">天后</text>
            </view>
            <view class="chevron {{expandedId === item.id ? 'chevron-up' : ''}}" aria-hidden="true"></view>
          </view>
        </view>

        <!-- Expandable Calendar & Detail Drawer -->
        <view wx:if="{{expandedId === item.id}}" class="holiday-drawer" catchtap="noop">
          <scroll-view class="day-strip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="day-strip">
              <view
                wx:for="{{item.days}}"
                wx:for-item="day"
                wx:key="date"
                class="day-chip day-chip-{{day.kind}} {{day.isToday ? 'day-chip-today' : ''}}"
              >
                <text class="day-chip-week">周{{day.weekday}}</text>
                <text class="day-chip-date">{{day.monthDay}}</text>
                <text class="day-chip-badge">{{day.badge}}</text>
              </view>
            </view>
          </scroll-view>

          <view class="drawer-footer">
            <view class="drawer-makeup-copy">
              <text wx:if="{{item.hasMakeup}}" class="drawer-makeup-text">调休上班：{{item.makeupDetailLabel}}</text>
              <text wx:else class="drawer-clean-text">本假期无需调休补班</text>
            </view>
            <button
              class="drawer-copy-btn {{copiedHolidayId === item.id ? 'drawer-copy-done' : ''}}"
              hover-class="fb-tap-btn"
              data-id="{{item.id}}"
              catchtap="copyHolidayItem"
            >{{copiedHolidayId === item.id ? '✓ 已复制' : '复制'}}</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-filter fb-card">
      <text class="empty-filter-title">当前筛选下暂无假期</text>
      <button class="empty-filter-btn" hover-class="fb-tap-btn" bindtap="resetFilter">查看全部假期</button>
    </view>

    <!-- Official Source Card -->
    <view wx:if="{{source}}" class="source-card fb-card">
      <view class="source-card-top">
        <view class="source-badge">官方公告</view>
        <text class="source-date">{{source.publishedAt}} 发布</text>
      </view>
      <text class="source-title">{{source.title}}</text>
      <view class="source-actions">
        <text class="source-note">放假与调休日期以国务院办公厅正式通知为准</text>
        <button class="holiday-source-button {{copiedSource ? 'source-copied' : ''}}" hover-class="fb-tap-btn" bindtap="copySource">{{copiedSource ? '✓ 已复制' : '复制链接'}}</button>
      </view>
    </view>
  </block>

  <view wx:elif="{{status === 'loading'}}" class="holiday-skeleton" aria-label="正在加载假期日历">
    <view class="skeleton-hero"></view>
    <view class="skeleton-stats"></view>
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="fb-card skeleton-card">
      <view class="skeleton-tile"></view>
      <view class="skeleton-lines">
        <view class="skeleton-line skeleton-line-lg"></view>
        <view class="skeleton-line skeleton-line-sm"></view>
      </view>
    </view>
  </view>

  <view wx:else class="fb-card holiday-feedback">
    <view class="feedback-mark" aria-hidden="true">!</view>
    <text class="section-title">暂时无法加载假期日历</text>
    <text class="holiday-hint">请检查网络连接后重新获取最新放假安排。</text>
    <button class="retry-primary-button" hover-class="fb-tap-btn" bindtap="refreshCalendar">重新加载</button>
  </view>
</view>
