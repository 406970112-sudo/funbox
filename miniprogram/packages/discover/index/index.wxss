@import "../../../templates/discover-entry.wxss";

.discover-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
  background: radial-gradient(ellipse at 90% 5%, #eaf2ff, transparent 40%), var(--fb-canvas);
}

.discover-hero {
  margin-bottom: 28rpx;
  animation: fb-reveal .3s ease-out both;
}

.discover-headline {
  display: block;
  margin-top: 14rpx;
  color: var(--fb-ink);
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
  line-height: 1.35;
}

.discover-accent {
  color: var(--fb-primary);
}

.discover-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--fb-muted);
  font-size: 24rpx;
}

.discover-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.motion-reduced .discover-hero {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .discover-hero {
    animation: none;
  }
}
