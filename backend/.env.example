APP_ENV=production

SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_PUBLIC_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

STORAGE_AUDIO_DIR=voice
STORAGE_AVATAR_DIR=data/avatars
STORAGE_MAX_AVATAR_BYTES=3145728
STORAGE_FEEDBACK_DIR=data/feedback-images
STORAGE_MAX_FEEDBACK_IMAGE_BYTES=5242880
STORAGE_MAX_FEEDBACK_IMAGES=3
STORAGE_PAYMENT_QR_DIR=data/payment-qr
STORAGE_MAX_PAYMENT_QR_BYTES=2097152
STORAGE_READING_DIR=data/reading
STORAGE_MAX_READING_UPLOAD_BYTES=52428800
STORAGE_MAX_READING_EXTRACTED_BYTES=209715200

# 正式授权与网络出版合规确认前保持线上书城关闭；开发演示可切换为 true + mock。
READING_LIBRARY_ENABLED=false
READING_PROVIDER_MODE=disabled
READING_YUEWEN_BASE_URL=https://cpapi-i.yuewen.com
READING_YUEWEN_APPFLAG=
READING_YUEWEN_APPSECRET=

DATABASE_PATH=data/app.db
AUTH_JWT_SECRET=
AUTH_JWT_SECRET_FILE=data/jwt-secret
AUTH_TOKEN_TTL_MS=604800000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
MAX_REQUEST_BODY_BYTES=65536

DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_TRANSLATION_MODEL=deepseek-chat
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
TRANSLATION_MAX_TEXT_LENGTH=8000

# Hot news reuses the DeepSeek settings above for AI summaries.
NEWS_RSS_FEEDS=https://36kr.com/feed,https://www.ifanr.com/feed,https://www.solidot.org/index.rss,https://feeds.bbci.co.uk/zhongwen/simp/rss.xml
NEWS_REFRESH_INTERVAL_MS=900000
NEWS_REQUEST_TIMEOUT_MS=12000
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_ARTICLES_PER_FEED=20
NEWS_MAX_EVENTS=60
NEWS_SUMMARY_LIMIT=8

# Market radar fetches public Eastmoney board quotes through the backend only.
MARKET_RADAR_CACHE_TTL_MS=120000
MARKET_RADAR_HISTORY_BASE_URL=https://push2his.eastmoney.com
MARKET_RADAR_QUOTE_BASE_URL=https://push2delay.eastmoney.com
MARKET_RADAR_REQUEST_TIMEOUT_MS=12000

TTS_MAX_TEXT_LENGTH=5000
TTS_MAX_CONTEXT_LENGTH=1000
TTS_REQUEST_TIMEOUT_MS=120000

VOLC_APP_ID=your_app_id
VOLC_ACCESS_TOKEN=your_access_token
VOLC_RESOURCE_ID=
VOLC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream

# TinyPNG credentials are read by the backend only. Never expose this value through EXPO_PUBLIC_* variables.
TINYPNG_API_KEY=
TINYPNG_API_URL=https://api.tinify.com
TINYPNG_MAX_IMAGE_BYTES=5242880
TINYPNG_REQUEST_TIMEOUT_MS=60000
