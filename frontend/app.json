{
  "expo": {
    "name": "FunBox",
    "slug": "my-first-expo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#eef4ff",
    "icon": "./assets/images/icon.png",
    "scheme": "myfirstexpoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "用于采集直播画面与扫描牌局房间二维码",
        "NSMicrophoneUsageDescription": "用于采集直播声音"
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eef4ff",
          "dark": {
            "backgroundColor": "#0f1317"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择并上传账户头像"
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "photosPermission": "用于读取相册中的二维码图片",
          "savePhotosPermission": "用于把生成的二维码保存到相册"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
